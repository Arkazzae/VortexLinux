+/**
+ * Windows-only targets such as %LOCALAPPDATA% are redirected into the selected
+ * game's Wine/Proton profile on access, so the mod type path alone does not
+ * show where deployed files end up. Report the physical target for support logs.
+ */
+function linuxDeploymentTarget(destinationPath: string): Record<string, unknown> {
+  if (process.platform !== "linux") {
+    return {};
+  }
+  let prefix: string | null | undefined;
+  try {
+    prefix = selectedGamePrefix();
+    return { prefix, resolvedPath: resolveCaseInsensitiveSync(destinationPath) };
+  } catch (err) {
+    return { prefix, targetError: getErrorMessageOrDefault(err) };
+  }
+}
