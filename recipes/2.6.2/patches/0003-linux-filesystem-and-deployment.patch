new file mode 100644
index 000000000..5a885f327
--- /dev/null
+++ b/src/renderer/src/util/volume.test.ts
@@ -0,0 +1,51 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import {
+  assertPathWritable,
+  getDiskSpace,
+  getPathDevice,
+  getVolumePath,
+  nearestExistingPath,
+} from "./volume";
+
+describe.runIf(process.platform !== "win32")("portable volume helpers", () => {
+  let tempDir: string;
+
+  beforeEach(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-volume-"));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { force: true, recursive: true });
+  });
+
+  it("finds an existing ancestor for a path that has not been created yet", () => {
+    const missing = path.join(tempDir, "future", "mods");
+    expect(nearestExistingPath(missing)).toBe(tempDir);
+  });
+
+  it("returns a volume on the same device as the requested path", () => {
+    const volume = getVolumePath(path.join(tempDir, "future", "mods"));
+    expect(fs.statSync(volume).dev).toBe(fs.statSync(tempDir).dev);
+  });
+
+  it("reports usable disk-space values", () => {
+    const result = getDiskSpace(path.join(tempDir, "future", "mods"));
+    expect(result.total).toBeGreaterThan(0);
+    expect(result.free).toBeGreaterThan(0);
+    expect(result.freeToCaller).toBeGreaterThan(0);
+  });
+
+  it("accepts a future path when its existing parent is writable", () => {
+    const future = path.join(tempDir, "future", "mods");
+    expect(() => assertPathWritable(future)).not.toThrow();
+  });
+
+  it("gets the device from an existing ancestor", () => {
+    expect(getPathDevice(path.join(tempDir, "future", "mods"))).toBe(fs.statSync(tempDir).dev);
+  });
+});
diff --git a/src/renderer/src/util/volume.ts b/src/renderer/src/util/volume.ts
new file mode 100644
index 000000000..e38bcba47
--- /dev/null
+++ b/src/renderer/src/util/volume.ts
@@ -0,0 +1,70 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import * as winapi from "winapi-bindings";
+
+export interface IDiskSpace {
+  free: number;
+  freeToCaller: number;
+  total: number;
+}
+
+function missingPathError(input: string): NodeJS.ErrnoException {
+  return Object.assign(new Error(`No existing ancestor for ${input}`), {
+    code: "ENOENT",
+    path: input,
+  });
+}
+
+export function nearestExistingPath(input: string): string {
+  let current = path.resolve(input);
+
+  while (!fs.existsSync(current)) {
+    const parent = path.dirname(current);
+    if (parent === current) {
+      throw missingPathError(input);
+    }
+    current = parent;
+  }
+
+  return current;
+}
+
+export function assertPathWritable(input: string): void {
+  fs.accessSync(nearestExistingPath(input), fs.constants.W_OK);
+}
+
+export function getPathDevice(input: string): number {
+  return fs.statSync(nearestExistingPath(input)).dev;
+}
+
+export function getVolumePath(input: string): string {
+  if (process.platform === "win32") {
+    return winapi.GetVolumePathName(input);
+  }
+
+  const existing = nearestExistingPath(input);
+  let current = fs.statSync(existing).isDirectory() ? existing : path.dirname(existing);
+  const device = fs.statSync(current).dev;
+
+  while (true) {
+    const parent = path.dirname(current);
+    if (parent === current || fs.statSync(parent).dev !== device) {
+      return current;
+    }
+    current = parent;
+  }
+}
+
+export function getDiskSpace(input: string): IDiskSpace {
+  if (process.platform === "win32") {
+    return winapi.GetDiskFreeSpaceEx(input);
+  }
+
+  const stats = fs.statfsSync(nearestExistingPath(input));
+  return {
+    free: stats.bfree * stats.bsize,
+    freeToCaller: stats.bavail * stats.bsize,
+    total: stats.blocks * stats.bsize,
+  };
+}
