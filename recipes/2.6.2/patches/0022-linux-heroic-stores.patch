@@ -0,0 +1,107 @@
+import Bluebird from "bluebird";
+
+import type { IExtensionApi } from "../types/IExtensionContext";
+import { GameEntryNotFound, GameStoreNotFound, type IGameStore, type IGameStoreSnapshot } from "../types/IGameStore";
+import { registerCompatibilityStore, resetCompatibilityPathCache } from "./compatibilityPaths";
+import { registerGameToolRunner } from "./linux/gameTools";
+import {
+  findHeroicGame,
+  heroicLaunchCommand,
+  heroicLauncher,
+  heroicPrefix,
+  heroicRoots,
+  heroicToolCommand,
+  readHeroicGames,
+  type HeroicGame,
+  type HeroicStoreId,
+} from "./linux/heroic";
+
+export class HeroicStore implements IGameStore {
+  public readonly name: string;
+  public readonly priority: number;
+  private games: HeroicGame[] | undefined;
+  private installed = false;
+  public constructor(public readonly id: HeroicStoreId) {
+    this.name = `${{ epic: "Epic Games", gog: "GOG", amazon: "Amazon Games" }[id]} (Heroic)`;
+    this.priority = id === "gog" ? 15 : 55;
+    registerCompatibilityStore(id, (selected) => {
+      const game = findHeroicGame(selected);
+      return game ? heroicPrefix(game) : undefined;
+    });
+    registerGameToolRunner(id, heroicToolCommand);
+  }
+  public allGames(): Bluebird<HeroicGame[]> {
+    return Bluebird.try(() => {
+      if (this.games === undefined) {
+        this.games = readHeroicGames().filter((entry) => entry.gameStoreId === this.id);
+        this.installed = heroicRoots().some((root) => heroicLauncher(root.flatpak) !== undefined);
+      }
+      return this.games;
+    });
+  }
+  public snapshot(): IGameStoreSnapshot {
+    return { entries: this.games ?? [], isInstalled: this.installed };
+  }
+  public reloadGames(): Bluebird<void> {
+    this.games = undefined;
+    resetCompatibilityPathCache();
+    return this.allGames().then(() => undefined);
+  }
+  private find(predicate: (game: HeroicGame) => boolean, query: string): Bluebird<HeroicGame> {
+    return this.allGames().then((games) => {
+      const matches = games.filter(predicate);
+      if (matches.length === 0) throw new GameEntryNotFound(query, this.id);
+      if (matches.length > 1)
+        throw new Error(
+          "Several Heroic installations match this game. Select the game directory manually.",
+        );
+      return matches[0];
+    });
+  }
+  public findByAppId(id: string | string[]): Bluebird<HeroicGame> {
+    const ids = Array.isArray(id) ? id : [id];
+    return this.find((game) => ids.includes(game.appid), ids.join(", "));
+  }
+  public findByName(name: string): Bluebird<HeroicGame> {
+    return Bluebird.try(() => new RegExp(`^(?:${name})$`, "i")).then((pattern) =>
+      this.find((game) => pattern.test(game.name), name),
+    );
+  }
+  public getGameStorePath(): Bluebird<string | undefined> {
+    return Bluebird.resolve(
+      heroicRoots()
+        .map((root) => heroicLauncher(root.flatpak)?.executable)
+        .find(Boolean),
+    );
+  }
+  public isGameStoreInstalled(): Bluebird<boolean> {
+    return this.getGameStorePath().then(Boolean);
+  }
+  public isGameInstalled(name: string): Bluebird<boolean> {
+    return this.findByName(name)
+      .then(() => true)
+      .catch(GameEntryNotFound, () => false);
+  }
+  public launchGame(
+    appInfo: string | { appId: string; parameters?: string[] },
+    api?: IExtensionApi,
+  ): Bluebird<void> {
+    return this.isGameStoreInstalled()
+      .then((installed) => {
+        if (!installed) throw new GameStoreNotFound(this.name);
+        return this.findByAppId(typeof appInfo === "string" ? appInfo : appInfo.appId);
+      })
+      .then((game) => {
+        if (!api) throw new Error("Heroic launch requires the Vortex application API");
+        const command = heroicLaunchCommand(
+          game,
+          typeof appInfo === "string" ? [] : appInfo.parameters,
+        );
+        return api.runExecutable(command.executable, command.args, {
+          ...command.options,
+          cwd: game.gamePath,
+          suggestDeploy: true,
+        });
+      });
+  }
+}
