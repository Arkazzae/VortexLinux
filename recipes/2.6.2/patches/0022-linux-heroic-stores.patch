+import { execFile } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { promisify } from "node:util";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { resetCompatibilityPathCache, selectedGamePrefix } from "./compatibilityPaths";
+import { HeroicStore } from "./Heroic";
+import { resolveGameTool } from "./linux/gameTools";
+import {
+  findHeroicGame,
+  heroicLaunchCommand,
+  heroicPrefix,
+  heroicRoots,
+  readHeroicGames,
+} from "./linux/heroic";
+
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+
+describe.runIf(process.platform === "linux")("Heroic integration", () => {
+  let home: string;
+  let config: string;
+  let flatpakConfig: string;
+  let gamePath: string;
+  let prefix: string;
+  function json(file: string, data: unknown): void {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, JSON.stringify(data));
+  }
+  function program(name: string): string {
+    const binary = path.join(home, "bin", name);
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.writeFileSync(
+      binary,
+      `#!${process.execPath}\nprocess.stdout.write(JSON.stringify({args:process.argv.slice(2),prefix:process.env.WINEPREFIX}));`,
+      { mode: 0o755 },
+    );
+    return binary;
+  }
+  function epic(root = config, location = gamePath): void {
+    fs.mkdirSync(location, { recursive: true });
+    json(path.join(root, "legendaryConfig/legendary/installed.json"), {
+      Example: {
+        app_name: "Example",
+        title: "Example Game",
+        install_path: location,
+        platform: "Windows",
+      },
+    });
+  }
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-heroic-"));
+    vi.mocked(os.homedir).mockReturnValue(home);
+    vi.stubEnv("XDG_CONFIG_HOME", path.join(home, ".config"));
+    vi.stubEnv("PATH", path.join(home, "bin"));
+    vi.stubEnv("HEROIC_BINARY", "heroic");
+    [config, flatpakConfig] = heroicRoots().map((root) => root.configPath);
+    gamePath = path.join(home, "Games/Example");
+    prefix = path.join(home, "Prefixes/Example");
+    fs.mkdirSync(path.join(prefix, "drive_c"), { recursive: true });
+  });
+  afterEach(() => {
+    resetCompatibilityPathCache();
+    vi.unstubAllEnvs();
+    vi.restoreAllMocks();
+    fs.rmSync(home, { recursive: true, force: true });
+  });
+  it("discovers all three stores, uses library titles and ignores broken files", async () => {
+    epic();
+    json(path.join(config, "gog_store/installed.json"), {
+      installed: [{ appName: "123", install_path: gamePath, platform: "linux" }],
+    });
+    json(path.join(config, "store_cache/gog_library.json"), {
+      games: [{ app_name: "123", title: "Native Game" }],
+    });
+    json(path.join(flatpakConfig, "nile_config/nile/installed.json"), [
+      { id: "amazon-id", path: gamePath },
+    ]);
+    json(path.join(flatpakConfig, "nile_config/nile/library.json"), [
+      { product: { id: "amazon-id", title: "Amazon Game" } },
+    ]);
+    json(path.join(flatpakConfig, "gog_store/installed.json"), "invalid schema");
+    expect(readHeroicGames().map((game) => [game.gameStoreId, game.name, game.flatpak])).toEqual([
+      ["epic", "Example Game", false],
+      ["gog", "Native Game", false],
+      ["amazon", "Amazon Game", true],
+    ]);
+    const gog = new HeroicStore("gog");
+    expect((await gog.findByName("Native Game")).appid).toBe("123");
+    expect(heroicPrefix(await gog.findByAppId("123"))).toBeNull();
+  });
+  it("keeps snapshot reads cached until a store scan refreshes them", async () => {
+    epic();
+    const binary = program("heroic");
+    const store = new HeroicStore("epic");
+    expect(store.snapshot()).toEqual({ entries: [], isInstalled: false });
+    await store.reloadGames();
+    expect(store.snapshot().entries.map((game) => game.appid)).toEqual(["Example"]);
+    expect(store.snapshot().isInstalled).toBe(true);
+
+    fs.rmSync(path.join(config, "legendaryConfig/legendary/installed.json"));
+    fs.rmSync(binary);
+    expect(store.snapshot().entries).toHaveLength(1);
+    expect(store.snapshot().isInstalled).toBe(true);
+    await store.reloadGames();
+    expect(store.snapshot()).toEqual({ entries: [], isInstalled: false });
+  });
+  it("inherits settings, uses the selected prefix and runs the configured Wine", async () => {
+    epic();
+    const wine = program("wine-custom");
+    json(path.join(config, "config.json"), {
+      defaultSettings: { winePrefix: "/unused", wineVersion: { type: "wine", bin: wine } },
+    });
+    json(path.join(config, "GamesConfig/Example.json"), {
+      version: "v0.1",
+      Example: { winePrefix: prefix },
+    });
+    new HeroicStore("epic");
+    const selected = { path: gamePath, store: "epic" };
+    expect(selectedGamePrefix(selected)).toBe(prefix);
+    const command = await resolveGameTool(
+      "/tools/Editor.exe",
+      ['path "quoted"; literal'],
+      {},
+      selected,
+    );
+    const { stdout } = await promisify(execFile)(command.executable, command.args, {
+      env: { ...process.env, ...command.options.env },
+    });
+    expect(JSON.parse(stdout)).toEqual({
+      args: ["/tools/Editor.exe", 'path "quoted"; literal'],
+      prefix,
+    });
+  });
+  it("keeps native and Flatpak copies separate and launches the matching launcher", async () => {
+    epic();
+    const secondPath = path.join(home, "Other Game");
+    epic(flatpakConfig, secondPath);
+    program("heroic");
+    const flatpak = program("flatpak");
+    const game = findHeroicGame({ path: secondPath, store: "epic" });
+    const command = heroicLaunchCommand(game, ["100% literal", 'a "b"']);
+    expect(command.executable).toBe(flatpak);
+    expect(command.args.slice(0, 2)).toEqual(["run", "com.heroicgameslauncher.hgl"]);
+    const url = new URL(command.args[2]);
+    expect(url.searchParams.get("runner")).toBe("legendary");
+    expect(url.searchParams.getAll("arg").map(decodeURIComponent)).toEqual([
+      "100% literal",
+      'a "b"',
+    ]);
+    await expect(new HeroicStore("epic").findByAppId("Example")).rejects.toThrow(/Several Heroic/);
+  });
+  it("runs Flatpak tools inside Heroic's sandbox with its environment", async () => {
+    epic(flatpakConfig);
+    const flatpak = program("flatpak");
+    json(path.join(flatpakConfig, "GamesConfig/Example.json"), {
+      Example: {
+        winePrefix: prefix,
+        wineVersion: { type: "wine", bin: "/app/bin/wine" },
+        enviromentOptions: [{ key: "EXAMPLE", value: "a b" }],
+      },
+    });
+    new HeroicStore("epic");
+    const command = await resolveGameTool(
+      "/tools/Editor.exe",
+      ["argument"],
+      { cwd: gamePath },
+      { path: gamePath, store: "epic" },
+    );
+    expect(command.executable).toBe(flatpak);
+    expect(command.args).toEqual([
+      "run",
+      "--command=/app/bin/wine",
+      "--env=EXAMPLE=a b",
+      `--env=WINEPREFIX=${prefix}`,
+      "com.heroicgameslauncher.hgl",
+      "/tools/Editor.exe",
+      "argument",
+    ]);
+    expect(command.options.shell).toBe(false);
+  });
+  it("uses Proton prefixes and UMU without inventing another prefix", async () => {
+    epic();
+    fs.rmSync(path.join(prefix, "drive_c"), { recursive: true });
+    fs.mkdirSync(path.join(prefix, "pfx/drive_c"), { recursive: true });
+    const proton = program("proton");
+    json(path.join(config, "GamesConfig/Example.json"), {
+      Example: {
+        winePrefix: prefix,
+        wineVersion: { type: "proton", bin: proton },
+        disableUMU: true,
+      },
+    });
+    new HeroicStore("epic");
+    const selected = { path: gamePath, store: "epic" };
+    expect(selectedGamePrefix(selected)).toBe(path.join(prefix, "pfx"));
+    let command = await resolveGameTool("Editor.exe", [], {}, selected);
+    expect(command.args).toEqual(["run", "Editor.exe"]);
+    expect(command.options.env.STEAM_COMPAT_DATA_PATH).toBe(prefix);
+    const umu = program("umu-run");
+    json(path.join(config, "GamesConfig/Example.json"), {
+      Example: { winePrefix: prefix, wineVersion: { type: "proton", bin: proton } },
+    });
+    command = await resolveGameTool("Editor.exe", [], {}, selected);
+    expect(command.executable).toBe(umu);
+    expect(command.args).toEqual(["Editor.exe"]);
+    expect(command.options.env.WINEPREFIX).toBe(prefix);
+  });
+  it("refreshes moved installations and reports missing prefixes", async () => {
+    epic();
+    const store = new HeroicStore("epic");
+    expect((await store.allGames()).length).toBe(1);
+    const other = path.join(home, "Moved");
+    epic(config, other);
+    await store.reloadGames();
+    expect((await store.findByAppId("Example")).gamePath).toBe(other);
+    await expect(
+      resolveGameTool("Editor.exe", [], {}, { path: other, store: "epic" }),
+    ).rejects.toThrow(/prefix is unavailable/);
+  });
+});
