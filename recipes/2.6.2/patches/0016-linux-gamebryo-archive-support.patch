diff --git a/extensions/gamebryo-archive-support/src/linux.smoke.test.ts b/extensions/gamebryo-archive-support/src/linux.smoke.test.ts
new file mode 100644
index 0000000..dc28b78
--- /dev/null
+++ b/extensions/gamebryo-archive-support/src/linux.smoke.test.ts
@@ -0,0 +1,53 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { describe, expect, it } from "vitest";
+
+import { resolveArchiveOutputPath } from "./archivePath";
+import { loadBA2 } from "./ba2";
+import { loadBSA } from "./bsa";
+
+const TEST_DATA = path.resolve(__dirname, "..", "test-data");
+
+describe.runIf(process.platform === "linux")("Gamebryo archive support on Linux", () => {
+  it("reads a Fallout 4 BA2 archive without native addons", async () => {
+    const archive = await loadBA2(path.join(TEST_DATA, "test-gnrl.ba2"));
+
+    expect(archive.type).toBe("general");
+    expect(archive.fileList.length).toBeGreaterThan(0);
+  });
+
+  it("reads and verifies a Skyrim SE BSA archive without native addons", async () => {
+    const archive = await loadBSA(path.join(TEST_DATA, "test-v105.bsa"), true);
+
+    expect(archive.version).toBe(0x69);
+    expect(archive.fileList.length).toBeGreaterThan(0);
+  });
+
+  it("extracts Windows-style archive paths as native directories", async () => {
+    const outputPath = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-gamebryo-linux-"));
+    try {
+      const archive = await loadBSA(path.join(TEST_DATA, "test-v105.bsa"));
+      await archive.extractAll(outputPath);
+
+      const extractedPath = path.join(outputPath, "meshes", "weapons", "sword.nif");
+      expect(fs.statSync(extractedPath).isFile()).toBe(true);
+      expect(fs.readdirSync(outputPath)).not.toContain("meshes\\weapons\\sword.nif");
+    } finally {
+      fs.rmSync(outputPath, { force: true, recursive: true });
+    }
+  });
+
+  it("rejects traversal and absolute archive paths", () => {
+    expect(() => resolveArchiveOutputPath("/tmp/output", "..\\escape.txt")).toThrow(
+      "Unsafe archive path",
+    );
+    expect(() => resolveArchiveOutputPath("/tmp/output", "/absolute.txt")).toThrow(
+      "Unsafe archive path",
+    );
+    expect(() => resolveArchiveOutputPath("/tmp/output", "C:\\absolute.txt")).toThrow(
+      "Unsafe archive path",
+    );
+  });
+});
