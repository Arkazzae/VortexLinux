--- /dev/null
+++ b/src/renderer/src/extensions/hardlink_activator/index.linux.test.ts
@@ -0,0 +1,47 @@
+import * as nodeFs from "fs/promises";
+import * as os from "os";
+import * as path from "path";
+
+import { expect, it } from "vitest";
+
+import { collectHardlinkKeys, purgeMatchingHardlinks } from "./hardlinkIdentity";
+
+it("purges matching POSIX hardlinks and preserves unrelated files", async () => {
+  const tempPath = await nodeFs.mkdtemp(path.join(os.tmpdir(), "vortex-hardlink-purge-"));
+  try {
+    const stagingPath = path.join(tempPath, "staging");
+    const dataPath = path.join(tempPath, "game", "Data");
+    const sourcePath = path.join(stagingPath, "example-mod", "Example.esm");
+    const deployedPath = path.join(dataPath, "Example.esm");
+    const unrelatedPath = path.join(dataPath, "Starfield.esm");
+
+    await nodeFs.mkdir(path.dirname(sourcePath), { recursive: true });
+    await nodeFs.mkdir(dataPath, { recursive: true });
+    await nodeFs.writeFile(sourcePath, "mod");
+    await nodeFs.link(sourcePath, deployedPath);
+    await nodeFs.writeFile(unrelatedPath, "game");
+
+    const keys = await collectHardlinkKeys(stagingPath);
+    expect(keys.size).toBe(1);
+    await expect(purgeMatchingHardlinks(dataPath, keys)).resolves.toBe(1);
+
+    await expect(nodeFs.readFile(sourcePath, "utf8")).resolves.toBe("mod");
+    await expect(nodeFs.stat(deployedPath)).rejects.toMatchObject({ code: "ENOENT" });
+    await expect(nodeFs.readFile(unrelatedPath, "utf8")).resolves.toBe("game");
+  } finally {
+    await nodeFs.rm(tempPath, { recursive: true, force: true });
+  }
+});
+
+it("does not classify an ordinary single-link file as deployed", async () => {
+  const tempPath = await nodeFs.mkdtemp(path.join(os.tmpdir(), "vortex-hardlink-single-"));
+  try {
+    const stagingPath = path.join(tempPath, "staging");
+    await nodeFs.mkdir(stagingPath, { recursive: true });
+    await nodeFs.writeFile(path.join(stagingPath, "only-copy.txt"), "single");
+
+    await expect(collectHardlinkKeys(stagingPath)).resolves.toEqual(new Set());
+  } finally {
+    await nodeFs.rm(tempPath, { recursive: true, force: true });
+  }
+});
