diff --git a/src/renderer/src/util/linuxSelfTest.ts b/src/renderer/src/util/linuxSelfTest.ts
new file mode 100644
index 0000000..99fb161
--- /dev/null
+++ b/src/renderer/src/util/linuxSelfTest.ts
@@ -0,0 +1,117 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { promisify } from "node:util";
+
+import {
+  collectHardlinkKeys,
+  purgeMatchingHardlinks,
+} from "../extensions/hardlink_activator/hardlinkIdentity";
+import { resolveWindowsUserPathSync, setCompatibilityGameProvider } from "./compatibilityPaths";
+import { resolveGameTool } from "./linux/gameTools";
+import { heroicPrefix, readHeroicGames } from "./linux/heroic";
+import { resolveCaseInsensitiveSync } from "./linuxCompatibility";
+import { GetPrivateProfileString, WritePrivateProfileString } from "./linuxIni";
+
+export async function runLinuxSelfTest(): Promise<void> {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-runtime-fixtures-"));
+  const variables = ["VORTEX_LINUX_DOCUMENTS", "XDG_CONFIG_HOME", "VORTEX_USERDATA"];
+  const previous = variables.map((key) => process.env[key]);
+  const prefix = path.join(root, "prefix");
+  const documents = path.join(root, "Documents");
+  try {
+    process.env.VORTEX_LINUX_DOCUMENTS = documents;
+    process.env.XDG_CONFIG_HOME = path.join(root, "config");
+    process.env.VORTEX_USERDATA = path.join(root, "config/Vortex");
+    const ini = path.join(
+      prefix,
+      "drive_c/users/steamuser/Documents/My Games/Example/settings.ini",
+    );
+    fs.mkdirSync(path.dirname(ini), { recursive: true });
+    fs.writeFileSync(
+      ini,
+      Buffer.concat([
+        Buffer.from([0xff, 0xfe]),
+        Buffer.from("; fixture\r\n[General]\r\nEnabled=0\r\n", "utf16le"),
+      ]),
+    );
+    setCompatibilityGameProvider(() => ({ path: root, environment: { WINEPREFIX: prefix } }));
+    const windowsPath = path.join(documents, "My Games/Example/Settings.INI");
+    WritePrivateProfileString("general", "enabled", "1", windowsPath);
+    assert.deepEqual(GetPrivateProfileString("GENERAL", "ENABLED", "", windowsPath), ["1"]);
+    assert.match(fs.readFileSync(ini).subarray(2).toString("utf16le"), /^; fixture\r\n/);
+    assert.equal(resolveCaseInsensitiveSync(windowsPath), ini);
+    assert.equal(
+      resolveWindowsUserPathSync(process.env.VORTEX_USERDATA),
+      process.env.VORTEX_USERDATA,
+    );
+    setCompatibilityGameProvider(undefined);
+
+    const staging = path.join(root, "staging");
+    const data = path.join(root, "game/Data");
+    fs.mkdirSync(staging);
+    fs.mkdirSync(data, { recursive: true });
+    fs.writeFileSync(path.join(staging, "Mod.esp"), "mod");
+    fs.linkSync(path.join(staging, "Mod.esp"), path.join(data, "Mod.esp"));
+    fs.writeFileSync(path.join(data, "Base.esm"), "base");
+    assert.equal(await purgeMatchingHardlinks(data, await collectHardlinkKeys(staging)), 1);
+    assert.equal(fs.readFileSync(path.join(staging, "Mod.esp"), "utf8"), "mod");
+    assert.equal(fs.readFileSync(path.join(data, "Base.esm"), "utf8"), "base");
+    assert.equal(fs.existsSync(path.join(data, "Mod.esp")), false);
+
+    const settings = path.join(process.env.XDG_CONFIG_HOME, "heroic");
+    fs.mkdirSync(path.join(settings, "gog_store"), { recursive: true });
+    fs.writeFileSync(
+      path.join(settings, "gog_store/installed.json"),
+      JSON.stringify({
+        installed: [
+          {
+            appName: "fixture",
+            title: "Fixture",
+            install_path: path.join(root, "game"),
+            platform: "windows",
+          },
+        ],
+      }),
+    );
+    fs.writeFileSync(
+      path.join(settings, "config.json"),
+      JSON.stringify({ defaultSettings: { winePrefix: prefix, wineVersion: { type: "wine" } } }),
+    );
+    const heroic = readHeroicGames().find((game) => game.appid === "fixture");
+    assert.ok(heroic);
+    assert.equal(heroicPrefix(heroic), prefix);
+
+    const command = await resolveGameTool(
+      "/fixtures/Tool.exe",
+      ['value="quoted"', "path with spaces"],
+      { env: { WINEPREFIX: prefix } },
+    );
+    assert.equal(command.executable, "wine");
+    const output = await promisify(execFile)(
+      process.execPath,
+      [
+        "-e",
+        "process.stdout.write(JSON.stringify({args:process.argv.slice(1),prefix:process.env.WINEPREFIX}))",
+        ...command.args,
+      ],
+      { env: { ...process.env, ...command.options.env, ELECTRON_RUN_AS_NODE: "1" } },
+    );
+    assert.deepEqual(JSON.parse(output.stdout), {
+      args: ["/fixtures/Tool.exe", 'value="quoted"', "path with spaces"],
+      prefix,
+    });
+    console.log(
+      "Packaged Linux fixtures: INI, selected prefix, Heroic, tool arguments and hardlink purge passed",
+    );
+  } finally {
+    setCompatibilityGameProvider(undefined);
+    variables.forEach((key, index) => {
+      if (previous[index] === undefined) delete process.env[key];
+      else process.env[key] = previous[index];
+    });
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+}
