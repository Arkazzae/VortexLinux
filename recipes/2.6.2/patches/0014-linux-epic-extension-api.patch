@@ -4,7 +4,7 @@ import PromiseBB from "bluebird";
 import type * as winapiT from "winapi-bindings";
 
 import type { IExtensionApi, IGameStore, IGameStoreEntry } from "../types/api";
-import { GameEntryNotFound } from "../types/api";
+import { GameEntryNotFound, GameStoreNotFound } from "../types/api";
 import * as fs from "./fs";
 import lazyRequire from "./lazyRequire";
 import { log } from "./log";
@@ -227,4 +227,30 @@ class EpicGamesLauncher implements IGameStore {
 const instance: IGameStore | undefined =
   process.platform === "win32" ? new EpicGamesLauncher() : undefined;
 
+const unavailableInstance: IGameStore = {
+  id: STORE_ID,
+  name: STORE_NAME,
+  priority: STORE_PRIORITY,
+  allGames: () => PromiseBB.resolve([]),
+  findByAppId: (appId: string | string[]) =>
+    PromiseBB.reject(
+      new GameEntryNotFound(Array.isArray(appId) ? appId.join(", ") : appId, STORE_ID),
+    ),
+  findByName: (name: string) => PromiseBB.reject(new GameEntryNotFound(name, STORE_ID)),
+  getGameStorePath: () => PromiseBB.resolve(undefined),
+  launchGame: () => PromiseBB.reject(new GameStoreNotFound(STORE_NAME)),
+  isGameInstalled: () => PromiseBB.resolve(false),
+  isGameStoreInstalled: () => PromiseBB.resolve(false),
+  reloadGames: () => PromiseBB.resolve(),
+};
+
+/**
+ * Bundled game extensions predate Linux support and call the public Epic
+ * helper without checking whether it exists. Keep the real store out of
+ * discovery on non-Windows hosts, but expose a total, rejecting API so those
+ * extensions can fall back to Steam/manual discovery instead of throwing a
+ * TypeError while dereferencing `undefined`.
+ */
+export const epicGamesLauncherApi: IGameStore = instance ?? unavailableInstance;
+
 export default instance;
