diff --git a/src/renderer/src/util/EpicGamesLauncher.linux.test.ts b/src/renderer/src/util/EpicGamesLauncher.linux.test.ts
new file mode 100644
index 000000000..9b3e4e2ab
--- /dev/null
+++ b/src/renderer/src/util/EpicGamesLauncher.linux.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vitest";
+
+import { GameEntryNotFound, GameStoreNotFound } from "../types/api";
+import epicGamesLauncher, { epicGamesLauncherApi } from "./EpicGamesLauncher";
+
+describe.runIf(process.platform !== "win32")("Epic Games extension API fallback", () => {
+  it("does not register Epic as an available native game store", () => {
+    expect(epicGamesLauncher).toBeUndefined();
+  });
+
+  it("reports that Epic and its games are unavailable", async () => {
+    await expect(epicGamesLauncherApi.allGames()).resolves.toEqual([]);
+    await expect(epicGamesLauncherApi.getGameStorePath()).resolves.toBeUndefined();
+    await expect(epicGamesLauncherApi.isGameInstalled?.("Example")).resolves.toBe(false);
+    await expect(epicGamesLauncherApi.isGameStoreInstalled?.()).resolves.toBe(false);
+  });
+
+  it("rejects lookups with the normal missing-entry error", async () => {
+    await expect(epicGamesLauncherApi.findByAppId("Example")).rejects.toBeInstanceOf(
+      GameEntryNotFound,
+    );
+    await expect(epicGamesLauncherApi.findByName("Example")).rejects.toBeInstanceOf(
+      GameEntryNotFound,
+    );
+  });
+
+  it("rejects launch attempts with the normal missing-store error", async () => {
+    await expect(epicGamesLauncherApi.launchGame("Example")).rejects.toBeInstanceOf(
+      GameStoreNotFound,
+    );
+  });
+});
diff --git a/src/renderer/src/util/EpicGamesLauncher.ts b/src/renderer/src/util/EpicGamesLauncher.ts
