+import { splitBackslashNames } from "./archivePaths";
+
+function tree(root: string): string[] {
+  const result: string[] = [];
+  const walk = (directory: string) => {
+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+      const full = path.join(directory, entry.name);
+      const relative = path.relative(root, full);
+      if (entry.isDirectory()) {
+        result.push(`${relative}/`);
+        walk(full);
+      } else {
+        result.push(`${relative}=${fs.readFileSync(full, "utf8")}`);
+      }
+    }
+  };
+  walk(root);
+  return result.sort();
+}
+
+for (const patchedPath of [false, true]) {
+  const split = (root: string) =>
+    patchedPath ? withPatchedPath(() => splitBackslashNames(root)) : splitBackslashNames(root);
