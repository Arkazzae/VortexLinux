+      it("turns empty entries that end in a backslash into folders", async () => {
+        // 7-Zip extracts folder entries as empty files when the archive doesn't mark them as
+        // folders, e.g. when it says it was made on Unix.
+        fs.writeFileSync(path.join(root, "bin\\x64\\"), "");
+        fs.writeFileSync(path.join(root, "bin\\x64\\plugins\\"), "");
+        fs.writeFileSync(path.join(root, "bin\\x64\\plugins\\Mod.dll"), "dll");
+        fs.writeFileSync(path.join(root, "bin\\x64\\plugins\\Empty\\"), "");
