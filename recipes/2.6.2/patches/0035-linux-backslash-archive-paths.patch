+        fs.mkdirSync(path.join(root, "Data\\Scripts"));
+        fs.writeFileSync(path.join(root, "Data\\Scripts", "added.pex"), "added");
+        fs.writeFileSync(path.join(root, "Data\\Scripts", "Source\\added.psc"), "source");
