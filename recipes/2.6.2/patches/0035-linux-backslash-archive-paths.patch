+          "dll",
+        );
+        fs.mkdirSync(path.join(root, "normal"));
+        fs.writeFileSync(path.join(root, "normal", "readme.txt"), "readme");
+
+        await split(root);
+
+        expect(tree(root)).toEqual([
+          "normal/",
+          "normal/readme.txt=readme",
+          "red4ext/",
+          "red4ext/plugins/",
+          "red4ext/plugins/AppearanceRuntimePlugin/",
+          "red4ext/plugins/AppearanceRuntimePlugin/AppearanceRuntimePlugin.dll=dll",
+        ]);
+      });
