+++ b/src/renderer/src/test-utils/patchedPath.ts
@@ -0,0 +1,21 @@
+import { createRequire, syncBuiltinESMExports } from "node:module";
+import type * as path from "node:path";
+
+import { patchPathCompatibility } from "../util/pathCompatibility";
+
+/**
+ * Runs fn with path.join, normalize and resolve turning backslashes into slashes, the way the
+ * renderer patches them at startup (util/monkeyPatching.ts).
+ */
+export async function withPatchedPath<T>(fn: () => PromiseLike<T>): Promise<T> {
+  const hostPath: typeof path = createRequire(__filename)("node:path");
+  const { join, normalize, resolve } = hostPath;
+  patchPathCompatibility(hostPath, "linux");
+  syncBuiltinESMExports();
+  try {
+    return await fn();
+  } finally {
+    Object.assign(hostPath, { join, normalize, resolve });
+    syncBuiltinESMExports();
+  }
+}
