+import { execFile } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { promisify } from "node:util";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { resetCompatibilityPathCache } from "../compatibilityPaths";
+import { resolveGameTool } from "./gameTools";
+import {
+  findLatestProton,
+  getConfiguredProtonName,
+  getProtonInfo,
+  resolveProtonPath,
+} from "./proton";
+
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+
+function vdf(value: Record<string, any>): string {
+  return Object.entries(value)
+    .map(([key, item]) =>
+      typeof item === "object" ? `"${key}"\n{\n${vdf(item)}}\n` : `"${key}" "${item}"\n`,
+    )
+    .join("");
+}
+
+describe.runIf(process.platform === "linux")("game tool runner", () => {
+  let root: string;
+  let steam: string;
+  let library: string;
+  let gamePath: string;
+  let prefix: string;
+  function write(file: string, text: string): void {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, text);
+  }
+  function config(mapping: Record<string, { name: string }>): void {
+    write(
+      path.join(steam, "config/config.vdf"),
+      vdf({
+        InstallConfigStore: { Software: { valve: { Steam: { CompatToolMapping: mapping } } } },
+      }),
+    );
+  }
+  function proton(name: string, internal?: string): string {
+    const directory = path.join(library, "steamapps/common", name);
+    write(
+      path.join(directory, "proton"),
+      `#!${process.execPath}\nprocess.stdout.write(JSON.stringify({args:process.argv.slice(2),prefix:process.env.WINEPREFIX,app:process.env.SteamAppId,cwd:process.cwd()}));`,
+    );
+    fs.chmodSync(path.join(directory, "proton"), 0o755);
+    if (internal)
+      write(
+        path.join(directory, "compatibilitytool.vdf"),
+        vdf({ compatibilitytools: { compat_tools: { [internal]: { install_path: "." } } } }),
+      );
+    return directory;
+  }
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-tool-test-"));
+    vi.mocked(os.homedir).mockReturnValue(root);
+    vi.stubEnv("XDG_DATA_HOME", path.join(root, ".local/share"));
+    steam = path.join(root, ".local/share/Steam");
+    library = path.join(root, "Games with spaces");
+    gamePath = path.join(library, "steamapps/common/Game");
+    prefix = path.join(library, "steamapps/compatdata/42/pfx");
+    fs.mkdirSync(path.join(prefix, "drive_c"), { recursive: true });
+    fs.mkdirSync(gamePath, { recursive: true });
+    write(
+      path.join(steam, "steamapps/libraryfolders.vdf"),
+      vdf({ libraryfolders: { 1: { path: library } } }),
+    );
+    write(
+      path.join(library, "steamapps/appmanifest_42.acf"),
+      vdf({ AppState: { appid: "42", installdir: "Game" } }),
+    );
+  });
+  afterEach(() => {
+    resetCompatibilityPathCache();
+    vi.unstubAllEnvs();
+    vi.restoreAllMocks();
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+  it("uses Steam's default mapping and the tool manifest in an additional library", async () => {
+    const runner = proton("Custom directory", "selected_proton");
+    config({ 0: { name: "selected_proton" } });
+    expect(await getConfiguredProtonName(steam, "42")).toBe("selected_proton");
+    expect(await resolveProtonPath(steam, "selected_proton")).toBe(runner);
+    const args = ["path with spaces", 'value="quoted"', "literal; $(touch example)"];
+    const command = await resolveGameTool(
+      "/tools/Editor.exe",
+      args,
+      { cwd: gamePath, shell: true },
+      { path: gamePath, store: "steam" },
+    );
+    expect(command.options.shell).toBe(false);
+    const { stdout } = await promisify(execFile)(command.executable, command.args, {
+      cwd: command.options.cwd,
+      env: { ...process.env, ...command.options.env },
+    });
+    expect(JSON.parse(stdout)).toEqual({
+      args: ["run", "/tools/Editor.exe", ...args],
+      prefix,
+      app: "42",
+      cwd: gamePath,
+    });
+  });
+  it("honors a per-game selection and does not replace a missing configured runner", async () => {
+    proton("Proton 10.0");
+    config({ 0: { name: "proton_10" }, 42: { name: "missing" } });
+    expect(await getConfiguredProtonName(steam, "42")).toBe("missing");
+    expect(
+      (await getProtonInfo(steam, path.join(library, "steamapps"), "42")).protonPath,
+    ).toBeUndefined();
+    await expect(
+      resolveGameTool("Tool.exe", [], {}, { path: gamePath, store: "steam" }),
+    ).rejects.toThrow(/selected in Steam/);
+  });
+  it("falls back to Steam's default after a per-game selection is cleared", async () => {
+    config({ 0: { name: "proton_10" }, 42: { name: "" } });
+    expect(await getConfiguredProtonName(steam, "42")).toBe("proton_10");
+  });
+  it("finds compatibility tools in Steam's extra tool directories", async () => {
+    const extra = path.join(root, "extra tools");
+    const runner = path.join(extra, "GE-Proton");
+    write(path.join(runner, "proton"), "");
+    write(
+      path.join(runner, "compatibilitytool.vdf"),
+      vdf({ compatibilitytools: { compat_tools: { "GE-Proton": { install_path: "." } } } }),
+    );
+    vi.stubEnv("STEAM_EXTRA_COMPAT_TOOLS_PATHS", extra);
+    expect(await resolveProtonPath(steam, "GE-Proton")).toBe(runner);
+  });
+  it("compares Proton versions numerically and never matches 9 with 19", async () => {
+    proton("Proton 9.0");
+    const latest = proton("Proton 19.0");
+    proton("Proton 10.0");
+    expect(await resolveProtonPath(steam, "proton_9")).toBe(
+      path.join(library, "steamapps/common/Proton 9.0"),
+    );
+    expect(await findLatestProton(steam)).toBe(latest);
+  });
+  it("keeps native tools native and requires an existing explicit Wine prefix", async () => {
+    expect(
+      (await resolveGameTool("/tools/editor", [], {}, { path: gamePath, store: "steam" }))
+        .executable,
+    ).toBe("/tools/editor");
+    const command = await resolveGameTool("/tools/Editor.exe", ["argument"], {
+      env: { WINEPREFIX: prefix },
+    });
+    expect(command.executable).toBe("wine");
+    expect(command.options.env.WINEPREFIX).toBe(prefix);
+    await expect(
+      resolveGameTool("Tool.exe", [], { env: { WINEPREFIX: path.join(root, "missing") } }),
+    ).rejects.toThrow(/prefix is unavailable/);
+  });
+  it("does not launch a Steam tool in a different Wine prefix", async () => {
+    proton("Proton 10.0");
+    const other = path.join(root, "other");
+    fs.mkdirSync(path.join(other, "drive_c"), { recursive: true });
+    await expect(
+      resolveGameTool(
+        "Tool.exe",
+        [],
+        { env: { WINEPREFIX: other } },
+        { path: gamePath, store: "steam" },
+      ),
+    ).rejects.toThrow(/differs/);
+  });
+});
