+import * as fs from "node:fs";
+import Module, { createRequire } from "node:module";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import linuxWinapi from "./linuxWinapi";
+
+describe.runIf(process.platform === "linux")("Linux INI compatibility", () => {
+  let directory: string;
+  let file: string;
+
+  beforeEach(() => {
+    directory = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-ini-"));
+    file = path.join(directory, "settings.ini");
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    fs.rmSync(directory, { recursive: true, force: true });
+  });
+
+  it("reads missing files as empty and preserves comments, casing and CRLF on edits", () => {
+    expect(linuxWinapi.GetPrivateProfileSectionNames(file)).toEqual([]);
+    fs.writeFileSync(
+      file,
+      "; keep me\r\n[General]\r\nEnabled=0\r\nPath=a=b\r\n\r\n[Other]\r\nKey=value\r\n",
+    );
+    expect(linuxWinapi.GetPrivateProfileSection("GENERAL", file)).toEqual({
+      Enabled: "0",
+      Path: "a=b",
+    });
+    linuxWinapi.WritePrivateProfileString("general", "enabled", "1", file);
+    expect(fs.readFileSync(file, "utf8")).toBe(
+      "; keep me\r\n[General]\r\nEnabled=1\r\nPath=a=b\r\n\r\n[Other]\r\nKey=value\r\n",
+    );
+  });
+
+  it("adds and removes keys and sections without resurrecting duplicate keys", () => {
+    fs.writeFileSync(file, "[General]\nKey=first\nKEY=second\n; retained\n");
+    linuxWinapi.WritePrivateProfileString("general", "key", null, file);
+    expect(linuxWinapi.GetPrivateProfileSection("General", file)).toEqual({});
+    linuxWinapi.WritePrivateProfileString("Mods", "Enabled", "1", file);
+    expect(linuxWinapi.GetPrivateProfileSection("mods", file)).toEqual({ Enabled: "1" });
+    linuxWinapi.WritePrivateProfileString("Mods", null, null, file);
+    expect(linuxWinapi.GetPrivateProfileSectionNames(file)).toEqual(["General"]);
+    expect(fs.readFileSync(file, "utf8")).toContain("; retained");
+  });
+
+  it.each(["utf8", "utf16le", "latin1"] as const)(
+    "preserves %s bytes, BOM and linked files",
+    (encoding) => {
+      const bom =
+        encoding === "utf16le"
+          ? Buffer.from([0xff, 0xfe])
+          : encoding === "utf8"
+            ? Buffer.from([0xef, 0xbb, 0xbf])
+            : Buffer.alloc(0);
+      const text = "[General]\r\nName=café\r\nKey=old\r\n";
+      fs.writeFileSync(file, Buffer.concat([bom, Buffer.from(text, encoding)]));
+      const hardlink = path.join(directory, "linked.ini");
+      const symlink = path.join(directory, "alias.ini");
+      fs.linkSync(file, hardlink);
+      fs.symlinkSync(file, symlink);
+      linuxWinapi.WritePrivateProfileString("General", "Key", "$new", symlink);
+      const expected = Buffer.concat([bom, Buffer.from(text.replace("old", "$new"), encoding)]);
+      expect(fs.readFileSync(file)).toEqual(expected);
+      expect(fs.readFileSync(hardlink)).toEqual(expected);
+      expect(fs.lstatSync(symlink).isSymbolicLink()).toBe(true);
+    },
+  );
+
+  it("rejects unencodable writes without truncating the original file", () => {
+    const bytes = Buffer.from("[General]\nName=café\n", "latin1");
+    fs.writeFileSync(file, bytes);
+    expect(() => linuxWinapi.WritePrivateProfileString("General", "Name", "żółw", file)).toThrow(
+      /encoding/,
+    );
+    expect(fs.readFileSync(file)).toEqual(bytes);
+    expect(() => linuxWinapi.GetPrivateProfileSectionNames(directory)).toThrow();
+  });
+
+  it("round-trips changes through the installed vortex-parse-ini package", async () => {
+    const loader = Module as typeof Module & { _load: (...args: unknown[]) => unknown };
+    const original = loader._load;
+    vi.spyOn(loader, "_load").mockImplementation(function (request, ...args) {
+      return request === "winapi-bindings" ? linuxWinapi : original.call(this, request, ...args);
+    });
+    const require = createRequire(__filename);
+    const { default: IniParser, WinapiFormat } = require("vortex-parse-ini");
+    const parser = new IniParser(new WinapiFormat());
+    fs.writeFileSync(file, "[modExample]\nEnabled=0\nPriority=5\n");
+    const ini = await parser.read(file);
+    ini.data.modExample.Enabled = "1";
+    ini.data.modExample.Priority = "2";
+    await parser.write(file, ini);
+    expect((await parser.read(file)).data.modExample).toEqual({ Enabled: "1", Priority: "2" });
+  });
+});
diff --git a/src/renderer/src/util/linuxIni.ts b/src/renderer/src/util/linuxIni.ts
new file mode 100644
index 0000000..a64516e
--- /dev/null
+++ b/src/renderer/src/util/linuxIni.ts
@@ -0,0 +1,138 @@
+import * as fs from "node:fs";
+
+import { resolveCaseInsensitiveSync } from "./linuxCompatibility";
+
+interface IniDocument {
+  filePath: string;
+  text: string;
+  encoding: BufferEncoding;
+  bom: Buffer;
+}
+
+function readDocument(input: string): IniDocument {
+  const filePath = resolveCaseInsensitiveSync(input);
+  let bytes: Buffer;
+  try {
+    bytes = fs.readFileSync(filePath);
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code !== "ENOENT") throw err;
+    bytes = Buffer.alloc(0);
+  }
+  const utf16 = bytes[0] === 0xff && bytes[1] === 0xfe;
+  const utf8Bom = bytes[0] === 0xef && bytes[1] === 0xbb && bytes[2] === 0xbf;
+  const bom = bytes.subarray(0, utf16 ? 2 : utf8Bom ? 3 : 0);
+  const body = bytes.subarray(bom.length);
+  const encoding = utf16
+    ? "utf16le"
+    : Buffer.from(body.toString("utf8")).equals(body)
+      ? "utf8"
+      : "latin1";
+  return { filePath, text: body.toString(encoding), encoding, bom };
+}
+
+function sectionName(line: string): string | undefined {
+  return /^\s*\[([^\]]+)\]\s*$/.exec(line)?.[1].trim();
+}
+
+function entry(line: string): { key: string; value: string } | undefined {
+  const match = /^\s*([^;#=\s][^=]*?)\s*=\s*(.*?)\s*$/.exec(line);
+  return match === null ? undefined : { key: match[1], value: match[2] };
+}
+
+function sectionBounds(lines: string[], section: string): [number, number] | undefined {
+  const start = lines.findIndex(
+    (line) => sectionName(line)?.toLowerCase() === section.toLowerCase(),
+  );
+  if (start === -1) return undefined;
+  let end = start + 1;
+  while (end < lines.length && sectionName(lines[end]) === undefined) end += 1;
+  return [start, end];
+}
+
+export function GetPrivateProfileSectionNames(filePath: string): string[] {
+  const names = new Map<string, string>();
+  for (const line of readDocument(filePath).text.split(/\r\n|\n|\r/)) {
+    const name = sectionName(line);
+    if (name !== undefined && !names.has(name.toLowerCase())) names.set(name.toLowerCase(), name);
+  }
+  return [...names.values()];
+}
+
+export function GetPrivateProfileSection(
+  section: string,
+  filePath: string,
+): Record<string, string> {
+  const lines = readDocument(filePath).text.split(/\r\n|\n|\r/);
+  const bounds = sectionBounds(lines, section);
+  const result: Record<string, string> = Object.create(null);
+  const keys = new Set<string>();
+  if (bounds === undefined) return result;
+  for (const line of lines.slice(bounds[0] + 1, bounds[1])) {
+    const item = entry(line);
+    if (item !== undefined && !keys.has(item.key.toLowerCase())) {
+      result[item.key] = item.value;
+      keys.add(item.key.toLowerCase());
+    }
+  }
+  return result;
+}
+
+export function GetPrivateProfileString(
+  section: string,
+  key: string,
+  fallback: string,
+  filePath: string,
+): string[] {
+  const values = GetPrivateProfileSection(section, filePath);
+  const actual = Object.keys(values).find((name) => name.toLowerCase() === key.toLowerCase());
+  const value = actual === undefined ? fallback : values[actual];
+  return [value.replace(/^(["'])(.*)\1$/, "$2")];
+}
+
+export function WritePrivateProfileString(
+  section: string,
+  key: string | null,
+  value: string | null | undefined,
+  input: string,
+): void {
+  if (
+    /[\r\n\0\[\]]/.test(section) ||
+    (key !== null && /[\r\n\0=]/.test(key)) ||
+    /[\r\n\0]/.test(value ?? "")
+  ) {
+    throw new Error("INI names and values must fit on one line");
+  }
+  const document = readDocument(input);
+  const eol = /\r\n|\n|\r/.exec(document.text)?.[0] ?? "\r\n";
+  const lines = document.text === "" ? [] : document.text.split(/\r\n|\n|\r/);
+  const bounds = sectionBounds(lines, section);
+  const deleting = value === null || value === undefined || key === null;
+  if (bounds === undefined) {
+    if (deleting) return;
+    if (lines.length > 0 && lines.at(-1) !== "") lines.push("");
+    lines.push(`[${section}]`, `${key}=${value}`, "");
+  } else if (key === null) {
+    lines.splice(bounds[0], bounds[1] - bounds[0]);
+  } else {
+    const matches: number[] = [];
+    for (let i = bounds[0] + 1; i < bounds[1]; i += 1) {
+      if (entry(lines[i])?.key.toLowerCase() === key.toLowerCase()) matches.push(i);
+    }
+    if (matches.length > 0) {
+      for (const index of matches.slice().reverse()) {
+        if (deleting || index !== matches[0]) lines.splice(index, 1);
+        else lines[index] = lines[index].replace(/=.*/, () => `=${value}`);
+      }
+    } else if (!deleting) {
+      let insert = bounds[1];
+      while (insert > bounds[0] + 1 && lines[insert - 1] === "") insert -= 1;
+      lines.splice(insert, 0, `${key}=${value}`);
+    } else return;
+  }
+  const text = lines.join(eol);
+  const body = Buffer.from(text, document.encoding);
+  if (body.toString(document.encoding) !== text)
+    throw new Error("INI value cannot be represented in the file's encoding");
+  // Keep symlinks and hardlinks intact when updating a deployed configuration.
+  fs.writeFileSync(document.filePath, Buffer.concat([document.bom, body]));
+}
