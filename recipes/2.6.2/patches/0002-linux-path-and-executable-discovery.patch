diff --git a/src/renderer/src/util/compatibilityPaths.test.ts b/src/renderer/src/util/compatibilityPaths.test.ts
new file mode 100644
index 0000000..697494d
--- /dev/null
+++ b/src/renderer/src/util/compatibilityPaths.test.ts
@@ -0,0 +1,91 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { resetCompatibilityPathCache, resolveWindowsUserPathSync } from "./compatibilityPaths";
+
+describe.runIf(process.platform === "linux")("compatibility profile paths", () => {
+  let tempDir: string;
+  let oldDocuments: string | undefined;
+  let oldPrefixes: string | undefined;
+
+  beforeEach(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-prefixes-"));
+    oldDocuments = process.env.VORTEX_LINUX_DOCUMENTS;
+    oldPrefixes = process.env.VORTEX_COMPAT_PREFIXES;
+    process.env.VORTEX_LINUX_DOCUMENTS = path.join(tempDir, "Documents");
+    process.env.VORTEX_COMPAT_PREFIXES = path.join(tempDir, "prefix");
+    resetCompatibilityPathCache();
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { force: true, recursive: true });
+    restoreEnvironment("VORTEX_LINUX_DOCUMENTS", oldDocuments);
+    restoreEnvironment("VORTEX_COMPAT_PREFIXES", oldPrefixes);
+    resetCompatibilityPathCache();
+  });
+
+  it("maps a Windows Documents path into an arbitrary compatibility prefix", () => {
+    const actualDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "Documents",
+      "My Games",
+      "Example",
+    );
+    fs.mkdirSync(actualDirectory, { recursive: true });
+    fs.writeFileSync(path.join(actualDirectory, "Settings.ini"), "");
+
+    const requested = path.join(
+      process.env.VORTEX_LINUX_DOCUMENTS,
+      "my games",
+      "example",
+      "settings.ini",
+    );
+    expect(resolveWindowsUserPathSync(requested)).toBe(path.join(actualDirectory, "Settings.ini"));
+  });
+
+  it("maps a not-yet-created file when its destination directory exists", () => {
+    const actualDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "Documents",
+      "My Games",
+      "Example",
+    );
+    fs.mkdirSync(actualDirectory, { recursive: true });
+
+    const requested = path.join(
+      process.env.VORTEX_LINUX_DOCUMENTS,
+      "My Games",
+      "Example",
+      "NewSettings.ini",
+    );
+    expect(resolveWindowsUserPathSync(requested)).toBe(
+      path.join(actualDirectory, "NewSettings.ini"),
+    );
+  });
+
+  it("leaves unrelated and unmatched paths unchanged", () => {
+    const unrelated = path.join(tempDir, "Downloads", "archive.zip");
+    const unmatched = path.join(process.env.VORTEX_LINUX_DOCUMENTS, "Unknown", "file.ini");
+    expect(resolveWindowsUserPathSync(unrelated)).toBe(unrelated);
+    expect(resolveWindowsUserPathSync(unmatched)).toBe(unmatched);
+  });
+});
+
+function restoreEnvironment(key: string, value: string | undefined) {
+  if (value === undefined) {
+    delete process.env[key];
+  } else {
+    process.env[key] = value;
+  }
+}
diff --git a/src/renderer/src/util/compatibilityPaths.ts b/src/renderer/src/util/compatibilityPaths.ts
new file mode 100644
index 0000000..ec0c952
--- /dev/null
+++ b/src/renderer/src/util/compatibilityPaths.ts
@@ -0,0 +1,184 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+interface ICandidate {
+  existingParts: number;
+  mtime: number;
+  path: string;
+}
+
+let cachedPrefixKey: string | undefined;
+let cachedPrefixes: string[] = [];
+
+function expandHome(input: string): string {
+  return input.replace(/^\$HOME(?=\/|$)/, os.homedir());
+}
+
+function xdgDocumentsPath(): string {
+  if (process.env.VORTEX_LINUX_DOCUMENTS !== undefined) {
+    return process.env.VORTEX_LINUX_DOCUMENTS;
+  }
+
+  try {
+    const config = fs.readFileSync(path.join(os.homedir(), ".config", "user-dirs.dirs"), "utf8");
+    const match = config.match(/^XDG_DOCUMENTS_DIR=(?:"([^"]*)"|'([^']*)'|([^\n]*))$/m);
+    const value = match?.[1] ?? match?.[2] ?? match?.[3];
+    if (value !== undefined && value.length > 0) {
+      return path.normalize(expandHome(value));
+    }
+  } catch {
+    // Fall back to the freedesktop default below.
+  }
+
+  return path.join(os.homedir(), "Documents");
+}
+
+function steamLibraries(): string[] {
+  const steamRoots = [
+    path.join(os.homedir(), ".local", "share", "Steam"),
+    path.join(os.homedir(), ".steam", "steam"),
+  ];
+  const libraries = new Set(steamRoots.filter(fs.existsSync));
+
+  for (const steamRoot of steamRoots) {
+    const manifests = [
+      path.join(steamRoot, "steamapps", "libraryfolders.vdf"),
+      path.join(steamRoot, "config", "libraryfolders.vdf"),
+    ];
+    for (const manifest of manifests) {
+      try {
+        const contents = fs.readFileSync(manifest, "utf8");
+        for (const match of contents.matchAll(/"path"\s+"([^"]+)"/g)) {
+          libraries.add(match[1].replaceAll("\\\\", "\\"));
+        }
+      } catch {
+        // A missing Steam installation or manifest is expected.
+      }
+    }
+  }
+
+  return [...libraries];
+}
+
+function findSteamPrefixes(): string[] {
+  return steamLibraries().flatMap((library) => {
+    const compatData = path.join(library, "steamapps", "compatdata");
+    try {
+      return fs
+        .readdirSync(compatData, { withFileTypes: true })
+        .filter((entry) => entry.isDirectory())
+        .map((entry) => path.join(compatData, entry.name, "pfx"))
+        .filter(fs.existsSync);
+    } catch {
+      return [];
+    }
+  });
+}
+
+function compatibilityPrefixes(): string[] {
+  const configured = process.env.VORTEX_COMPAT_PREFIXES ?? "";
+  const cacheKey = `${os.homedir()}\0${configured}`;
+  if (cacheKey === cachedPrefixKey) {
+    return cachedPrefixes;
+  }
+
+  const explicit = configured
+    .split(path.delimiter)
+    .filter(Boolean)
+    .map((entry) => path.resolve(expandHome(entry)));
+  cachedPrefixes = [...new Set([...explicit, ...findSteamPrefixes()])];
+  cachedPrefixKey = cacheKey;
+  return cachedPrefixes;
+}
+
+function windowsDocumentsRoots(): string[] {
+  return compatibilityPrefixes().flatMap((prefix) => {
+    const users = path.join(prefix, "drive_c", "users");
+    try {
+      return fs
+        .readdirSync(users, { withFileTypes: true })
+        .filter((entry) => entry.isDirectory())
+        .map((entry) => path.join(users, entry.name, "Documents"))
+        .filter(fs.existsSync);
+    } catch {
+      return [];
+    }
+  });
+}
+
+function resolveCandidate(root: string, relative: string): ICandidate | undefined {
+  const parts = relative.split(path.sep).filter(Boolean);
+  let current = root;
+  let existingParts = 0;
+
+  try {
+    for (const [index, part] of parts.entries()) {
+      const exact = path.join(current, part);
+      if (fs.existsSync(exact)) {
+        current = exact;
+        existingParts += 1;
+        continue;
+      }
+
+      const match = fs
+        .readdirSync(current)
+        .find((entry) => entry.toLowerCase() === part.toLowerCase());
+      if (match === undefined) {
+        current = path.join(current, ...parts.slice(index));
+        break;
+      }
+      current = path.join(current, match);
+      existingParts += 1;
+    }
+
+    const minimumExistingParts = parts[0]?.toLowerCase() === "my games" ? 2 : 1;
+    if (existingParts < minimumExistingParts) {
+      return undefined;
+    }
+    return {
+      existingParts,
+      mtime: fs.statSync(nearestExisting(current)).mtimeMs,
+      path: current,
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+function nearestExisting(input: string): string {
+  let current = input;
+  while (!fs.existsSync(current) && path.dirname(current) !== current) {
+    current = path.dirname(current);
+  }
+  return current;
+}
+
+export function resolveWindowsUserPathSync(input: string): string {
+  if (process.platform !== "linux" || !path.isAbsolute(input)) {
+    return input;
+  }
+
+  const documents = xdgDocumentsPath();
+  const relative = path.relative(documents, input);
+  if (relative.startsWith("..") || path.isAbsolute(relative) || relative.length === 0) {
+    return input;
+  }
+
+  const candidates = windowsDocumentsRoots()
+    .map((root) => resolveCandidate(root, relative))
+    .filter((candidate): candidate is ICandidate => candidate !== undefined)
+    .sort(
+      (lhs, rhs) =>
+        Number(fs.existsSync(rhs.path)) - Number(fs.existsSync(lhs.path)) ||
+        rhs.existingParts - lhs.existingParts ||
+        rhs.mtime - lhs.mtime,
+    );
+
+  return candidates[0]?.path ?? input;
+}
+
+export function resetCompatibilityPathCache() {
+  cachedPrefixKey = undefined;
+  cachedPrefixes = [];
+}
