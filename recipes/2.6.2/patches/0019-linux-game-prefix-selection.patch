+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  resetCompatibilityPathCache,
+  resolveWindowsUserPathSync,
+  setCompatibilityGameProvider,
+} from "./compatibilityPaths";
+import { findSteamInstallation, steamLibraries, steamRoots } from "./linux/steamLibraries";
+import { resolveCaseInsensitiveSync } from "./linuxCompatibility";
+
+vi.mock("node:os", async (original) => ({
+  ...(await original<typeof os>()),
+  homedir: vi.fn(),
+}));
+
+describe.runIf(process.platform === "linux")("selected compatibility prefix", () => {
+  let home: string;
+  let documents: string;
+  const relative = "My Games/Example/settings.ini";
+  function fixture(prefix: string): string {
+    const file = path.join(prefix, "drive_c/users/steamuser/Documents", relative);
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, "[General]\n");
+    return file;
+  }
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-selected-prefix-"));
+    documents = path.join(home, "Documents");
+    vi.mocked(os.homedir).mockReturnValue(home);
+    vi.stubEnv("XDG_DATA_HOME", path.join(home, ".local/share"));
+    vi.stubEnv("VORTEX_LINUX_DOCUMENTS", documents);
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", "");
+    setCompatibilityGameProvider(undefined);
+  });
+  afterEach(() => {
+    setCompatibilityGameProvider(undefined);
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+    fs.rmSync(home, { force: true, recursive: true });
+  });
+
+  it.each(["data/Steam", ".local/share/Steam"])("finds Steam Flatpak at %s", (suffix) => {
+    const root = path.join(home, ".var/app/com.valvesoftware.Steam", suffix);
+    const expected = fixture(path.join(root, "steamapps/compatdata/123/pfx"));
+    expect(steamRoots()).toContain(root);
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(expected);
+  });
+
+  it("refuses ambiguous prefixes regardless of timestamps", () => {
+    const a = path.join(home, "a"),
+      b = path.join(home, "b");
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", `${a}:${b}`);
+    const fa = fixture(a),
+      fb = fixture(b);
+    fs.utimesSync(fa, 1000, 1000);
+    fs.utimesSync(fb, 2000, 2000);
+    expect(() => resolveWindowsUserPathSync(path.join(documents, relative))).toThrow(/Several/);
+    fs.mkdirSync(path.dirname(path.join(documents, relative)), { recursive: true });
+    fs.writeFileSync(path.join(documents, relative), "stale host copy");
+    setCompatibilityGameProvider(() => ({ environment: { WINEPREFIX: a } }));
+    expect(resolveCaseInsensitiveSync(path.join(documents, relative))).toBe(fa);
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(fa);
+    setCompatibilityGameProvider(() => ({ environment: { WINEPREFIX: b } }));
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(fb);
+  });
+
+  it("uses the selected Steam installation on another library and accepts library symlinks", () => {
+    const root = path.join(home, ".local/share/Steam");
+    const library = path.join(home, "external disk");
+    fs.mkdirSync(path.join(root, "steamapps"), { recursive: true });
+    fs.writeFileSync(
+      path.join(root, "steamapps/libraryfolders.vdf"),
+      `"libraryfolders"\n{\n"0"\n{\n"path" "${library}"\n}\n}`,
+    );
+    const gamePath = path.join(library, "steamapps/common/Example");
+    fs.mkdirSync(gamePath, { recursive: true });
+    fs.writeFileSync(
+      path.join(library, "steamapps/appmanifest_123.acf"),
+      '"AppState"\n{\n"appid" "123"\n"installdir" "Example"\n}',
+    );
+    const prefix = path.join(library, "steamapps/compatdata/123/pfx");
+    const expected = fixture(prefix);
+    fixture(path.join(root, "steamapps/compatdata/999/pfx"));
+    const alias = path.join(home, "game-link");
+    fs.symlinkSync(gamePath, alias);
+    expect(steamLibraries()).toContain(library);
+    expect(findSteamInstallation(alias)?.prefix).toBe(prefix);
+    setCompatibilityGameProvider(() => ({
+      path: alias,
+      store: "steam",
+      executable: "Example.exe",
+    }));
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(expected);
+  });
+
+  it("does not fall back to another installation when the selected prefix is missing", () => {
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", path.join(home, "backup"));
+    fixture(path.join(home, "backup"));
+    setCompatibilityGameProvider(() => ({
+      environment: { WINEPREFIX: path.join(home, "missing") },
+    }));
+    expect(() => resolveWindowsUserPathSync(path.join(documents, relative))).toThrow(/unavailable/);
+    expect(resolveWindowsUserPathSync(path.join(home, "Downloads/mod.zip"))).toBe(
+      path.join(home, "Downloads/mod.zip"),
+    );
+    const expected = fixture(path.join(home, "missing"));
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(expected);
+  });
+
+  it("keeps native game paths and Vortex state outside Proton", () => {
+    const gamePath = path.join(home, "native");
+    fs.mkdirSync(gamePath);
+    fs.writeFileSync(path.join(gamePath, "Game"), Buffer.from([0x7f, 0x45, 0x4c, 0x46]));
+    fixture(path.join(home, "backup"));
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", path.join(home, "backup"));
+    setCompatibilityGameProvider(() => ({ path: gamePath, executable: "Game", store: "steam" }));
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(
+      path.join(documents, relative),
+    );
+    vi.stubEnv("VORTEX_LINUX_APPDATA", path.join(home, ".config"));
+    const state = path.join(home, ".config/Vortex/state.v2");
+    expect(resolveWindowsUserPathSync(state)).toBe(state);
+  });
+
+  it("deduplicates aliases of the same prefix", () => {
+    const prefix = path.join(home, "prefix");
+    const expected = fixture(prefix);
+    fs.symlinkSync(prefix, path.join(home, "alias"));
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", `${prefix}:${home}/alias`);
+    resetCompatibilityPathCache();
+    expect(resolveWindowsUserPathSync(path.join(documents, relative))).toBe(expected);
+  });
+});
