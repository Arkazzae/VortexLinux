new file mode 100644
index 0000000..05dc6cf
--- /dev/null
+++ b/src/renderer/src/extensions/updater/linuxRelease.ts
@@ -0,0 +1,222 @@
+import { log } from "../../logging";
+import type { IExtensionApi, IExtensionContext } from "../../types/IExtensionContext";
+
+export const LINUX_RELEASES_URL = "https://github.com/Arkazzae/vortex-linux/releases";
+const RELEASE_API = "https://api.github.com/repos/Arkazzae/vortex-linux/releases/latest";
+const UPDATE_NOTIFICATION = "vortex-linux-update-available";
+const CHECK_NOTIFICATION = "vortex-linux-update-check";
+const CHECK_INTERVAL = 4 * 60 * 60 * 1000;
+
+interface IPackageVersion {
+  upstream: number[];
+  revision: number;
+}
+
+interface ILinuxRelease {
+  version: string;
+  url: string;
+}
+
+function parseVersion(value: string): IPackageVersion | undefined {
+  const match = /^v?(\d+(?:\.\d+){1,3})-([1-9]\d*)$/.exec(value);
+  if (match === null) {
+    return undefined;
+  }
+  const upstream = match[1].split(".").map(Number);
+  const revision = Number(match[2]);
+  return [...upstream, revision].every(Number.isSafeInteger) ? { upstream, revision } : undefined;
+}
+
+export function isNewerLinuxVersion(candidate: string, installed: string): boolean {
+  const next = parseVersion(candidate);
+  const current = parseVersion(installed);
+  if (next === undefined || current === undefined) {
+    return false;
+  }
+  for (let index = 0; index < Math.max(next.upstream.length, current.upstream.length); index++) {
+    const difference = (next.upstream[index] ?? 0) - (current.upstream[index] ?? 0);
+    if (difference !== 0) {
+      return difference > 0;
+    }
+  }
+  return next.revision > current.revision;
+}
+
+export async function fetchLinuxRelease(): Promise<ILinuxRelease | undefined> {
+  const response = await fetch(RELEASE_API, {
+    headers: { Accept: "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28" },
+    credentials: "omit",
+    signal: AbortSignal.timeout(15000),
+  });
+  if (response.status === 404) {
+    return undefined; // No published stable release yet.
+  }
+  if (!response.ok) {
+    throw new Error(`GitHub release check failed (${response.status})`);
+  }
+  const release: unknown = await response.json();
+  if (release === null || typeof release !== "object") {
+    throw new Error("Invalid GitHub release response");
+  }
+  const data = release as Record<string, unknown>;
+  if (
+    typeof data.tag_name !== "string" ||
+    typeof data.draft !== "boolean" ||
+    typeof data.prerelease !== "boolean" ||
+    !Array.isArray(data.assets)
+  ) {
+    throw new Error("Invalid GitHub release response");
+  }
+  if (data.draft || data.prerelease || parseVersion(data.tag_name) === undefined) {
+    return undefined;
+  }
+  const hasLinuxPackage = data.assets.some((asset: unknown) => {
+    if (asset === null || typeof asset !== "object" || !("name" in asset)) {
+      return false;
+    }
+    return (
+      typeof asset.name === "string" &&
+      /^(?:Vortex-.+-x86_64\.AppImage|vortex-linux-.+-x86_64\.pkg\.tar\.zst)$/.test(asset.name)
+    );
+  });
+  if (!hasLinuxPackage) {
+    return undefined;
+  }
+  return {
+    version: data.tag_name.replace(/^v/, ""),
+    // Construct the destination ourselves; never open a URL supplied by the response.
+    url: `${LINUX_RELEASES_URL}/tag/${encodeURIComponent(data.tag_name)}`,
+  };
+}
+
+export function createLinuxReleaseChecker(api: IExtensionApi, installed: string) {
+  let checking = false;
+  let manualRequested = false;
+  let lastCheck = -Infinity;
+  let announcedVersion: string | undefined;
+  const enabled = () => api.getState().settings.update.channel !== "none";
+  const showChecking = () =>
+    api.sendNotification({
+      id: CHECK_NOTIFICATION,
+      type: "activity",
+      message: "Checking for updates...",
+    });
+
+  return async (manual = false): Promise<void> => {
+    if (checking) {
+      if (manual) {
+        manualRequested = true;
+        showChecking();
+      }
+      return;
+    }
+    if (!manual && !enabled()) {
+      return;
+    }
+    // Includes manual presses and channel changes, so they cannot flood GitHub.
+    if (Date.now() - lastCheck < 60000) {
+      if (manual) {
+        api.sendNotification({
+          id: CHECK_NOTIFICATION,
+          type: "info",
+          displayMS: 5000,
+          message: "Please wait a minute before checking for updates again.",
+        });
+      }
+      return;
+    }
+    checking = true;
+    manualRequested = manual;
+    lastCheck = Date.now();
+    if (manual) {
+      showChecking();
+    }
+    try {
+      const release = await fetchLinuxRelease();
+      // A user may turn notifications off while the request is in flight.
+      if (!manualRequested && !enabled()) {
+        return;
+      }
+      if (manualRequested) {
+        api.dismissNotification(CHECK_NOTIFICATION);
+      }
+      if (release !== undefined && isNewerLinuxVersion(release.version, installed)) {
+        if (manualRequested || announcedVersion !== release.version) {
+          announcedVersion = release.version;
+          api.sendNotification({
+            id: UPDATE_NOTIFICATION,
+            type: "info",
+            message: "Vortex for Linux {{version}} is available",
+            replace: { version: release.version },
+            actions: [
+              {
+                title: "View release",
+                action: () => {
+                  window.api.shell.openUrl(release.url);
+                },
+              },
+            ],
+          });
+        }
+      } else {
+        announcedVersion = undefined;
+        api.dismissNotification(UPDATE_NOTIFICATION);
+        if (manualRequested) {
+          api.sendNotification({
+            id: CHECK_NOTIFICATION,
+            type: "success",
+            displayMS: 5000,
+            message: "No newer Vortex for Linux release is available.",
+          });
+        }
+      }
+    } catch (error) {
+      log("warn", "Linux release check failed", { error });
+      if (manualRequested) {
+        api.sendNotification({
+          id: CHECK_NOTIFICATION,
+          type: "warning",
+          message: "Could not check for updates. Please try again later or visit GitHub Releases.",
+          actions: [
+            {
+              title: "View releases",
+              action: () => {
+                window.api.shell.openUrl(LINUX_RELEASES_URL);
+              },
+            },
+          ],
+        });
+      }
+    } finally {
+      checking = false;
+    }
+  };
+}
+
+export function initLinuxReleaseNotifications(context: IExtensionContext, installed: string): void {
+  const check = createLinuxReleaseChecker(context.api, installed);
+  context.api.events.on("check-linux-updates", () => {
+    void check(true);
+  });
+  context.api.onStateChange(["settings", "update", "channel"], (_old, channel) => {
+    if (channel === "none") {
+      context.api.dismissNotification(UPDATE_NOTIFICATION);
+    } else {
+      void check();
+    }
+  });
+  const initial = setTimeout(() => {
+    void check();
+  }, 5000);
+  const periodic = setInterval(() => {
+    void check();
+  }, CHECK_INTERVAL);
+  window.addEventListener(
+    "beforeunload",
+    () => {
+      clearTimeout(initial);
+      clearInterval(periodic);
+    },
+    { once: true },
+  );
+}
