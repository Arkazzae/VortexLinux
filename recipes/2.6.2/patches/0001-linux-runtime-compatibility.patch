@@ -0,0 +1,130 @@
+import type { SpawnOptions } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import {
+  filterSuccessfulWineStderr,
+  mapWineArgument,
+  prepareWindowsProcess,
+  prepareWindowsShellCommand,
+  resolveCaseInsensitiveSync,
+  toWinePath,
+} from "./linuxCompatibility";
+
+describe.runIf(process.platform === "linux")("linuxCompatibility", () => {
+  let tempDir: string;
+  let previousRuntimeRoot: string | undefined;
+  let previousWinePrefix: string | undefined;
+
+  beforeEach(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-linux-compat-"));
+    previousRuntimeRoot = process.env.VORTEX_DOTNET_WIN_ROOT;
+    previousWinePrefix = process.env.VORTEX_WINEPREFIX;
+    process.env.VORTEX_WINEPREFIX = path.join(tempDir, "prefix");
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { force: true, recursive: true });
+    if (previousRuntimeRoot === undefined) {
+      delete process.env.VORTEX_DOTNET_WIN_ROOT;
+    } else {
+      process.env.VORTEX_DOTNET_WIN_ROOT = previousRuntimeRoot;
+    }
+    if (previousWinePrefix === undefined) {
+      delete process.env.VORTEX_WINEPREFIX;
+    } else {
+      process.env.VORTEX_WINEPREFIX = previousWinePrefix;
+    }
+  });
+
+  it("resolves Windows-authored path casing without changing missing paths", () => {
+    const actual = path.join(tempDir, "Tools", "Helper.exe");
+    fs.mkdirSync(path.dirname(actual));
+    fs.writeFileSync(actual, "");
+
+    expect(resolveCaseInsensitiveSync(path.join(tempDir, "tools", "helper.exe"))).toBe(actual);
+    expect(resolveCaseInsensitiveSync(path.join(tempDir, "tools", "missing.exe"))).toBe(
+      path.join(tempDir, "tools", "missing.exe"),
+    );
+  });
+
+  it("maps local absolute arguments into Wine's Z drive", () => {
+    const localPath = path.join(tempDir, "Data", "input.pak");
+    fs.mkdirSync(path.dirname(localPath));
+    fs.writeFileSync(localPath, "");
+
+    expect(mapWineArgument(localPath)).toBe(toWinePath(localPath));
+    expect(mapWineArgument("--silent")).toBe("--silent");
+    expect(mapWineArgument("/silent")).toBe("/silent");
+  });
+
+  it("runs a managed Windows helper through the packaged runtime", () => {
+    const runtimeRoot = path.join(tempDir, "runtime");
+    const dotnet = path.join(runtimeRoot, "dotnet.exe");
+    const helper = path.join(tempDir, "Helper.exe");
+    const helperDll = path.join(tempDir, "Helper.dll");
+    const input = path.join(tempDir, "Data", "input.bin");
+    fs.mkdirSync(runtimeRoot);
+    fs.mkdirSync(path.dirname(input));
+    for (const file of [
+      dotnet,
+      helper,
+      helperDll,
+      `${path.join(tempDir, "Helper")}.runtimeconfig.json`,
+      input,
+    ]) {
+      fs.writeFileSync(file, "");
+    }
+    process.env.VORTEX_DOTNET_WIN_ROOT = runtimeRoot;
+
+    const options: SpawnOptions = { env: {} };
+    const result = prepareWindowsProcess(helper, ["--source", input], options);
+    expect(result.command).toBe("wine");
+    expect(result.args).toEqual([dotnet, toWinePath(helperDll), "--source", toWinePath(input)]);
+    expect(result.options.env?.WINEPREFIX).toBe(path.join(tempDir, "prefix"));
+    expect(result.options.env?.PATH).toBe(process.env.PATH);
+    expect(result.translated).toBe(true);
+  });
+
+  it("rewrites a shell invocation without knowing the helper or game", () => {
+    const helper = path.join(tempDir, "Generic Tool.exe");
+    const input = path.join(tempDir, "Data", "input.bin");
+    fs.mkdirSync(path.dirname(input));
+    fs.writeFileSync(helper, "");
+    fs.writeFileSync(input, "");
+
+    const result = prepareWindowsShellCommand(`"${helper}" --source "${input}"`);
+    expect(result.command).toContain("'wine'");
+    expect(result.command).toContain(`'${helper}'`);
+    expect(result.command).toContain(toWinePath(input));
+    expect(result.translated).toBe(true);
+  });
+
+  it("maps unquoted local paths in shell invocations", () => {
+    const helper = path.join(tempDir, "Helper.exe");
+    const input = path.join(tempDir, "Data", "input.bin");
+    fs.mkdirSync(path.dirname(input));
+    fs.writeFileSync(helper, "");
+    fs.writeFileSync(input, "");
+
+    const result = prepareWindowsShellCommand(`${helper} --source ${input}`);
+    expect(result.command).toContain(shellFragment(toWinePath(input)));
+    expect(result.translated).toBe(true);
+  });
+
+  it("removes known graphics diagnostics only from successful Wine output", () => {
+    const stderr = [
+      "libEGL warning: failed to create dri2 screen",
+      "pci id for fd 20: 10de:0000, driver (null)",
+      "real helper warning",
+    ].join("\n");
+    expect(filterSuccessfulWineStderr(stderr)).toBe("real helper warning");
+  });
+});
+
+function shellFragment(input: string): string {
+  return `'${input}'`;
+}
diff --git a/src/renderer/src/util/linuxCompatibility.ts b/src/renderer/src/util/linuxCompatibility.ts
new file mode 100644
index 000000000..b52bb76ff
--- /dev/null
+++ b/src/renderer/src/util/linuxCompatibility.ts
@@ -0,0 +1,251 @@
+import type { ExecOptions, SpawnOptions } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { resolveWindowsUserPathSync } from "./compatibilityPaths";
+
+export interface IPreparedProcess<TOptions extends ExecOptions | SpawnOptions> {
+  args: string[];
+  command: string;
+  options: TOptions;
+  translated: boolean;
+}
+
+export interface IPreparedShellCommand {
+  command: string;
+  options: ExecOptions;
+  translated: boolean;
+}
+
+const WINE_NOISE = [
+  /^libEGL warning:/,
+  /^MESA-LOADER:/,
+  /^pci id for fd /,
+  /^ATTENTION: default value of option /,
+];
+
+function isMissingPathError(err: unknown): boolean {
+  return (err as NodeJS.ErrnoException | undefined)?.code === "ENOENT";
+}
+
+function stripMatchingQuotes(input: string): { quote: string; value: string } {
+  const first = input[0];
+  const last = input[input.length - 1];
+  if ((first === '"' || first === "'") && first === last) {
+    return { quote: first, value: input.slice(1, -1) };
+  }
+  return { quote: "", value: input };
+}
+
+function shellQuote(input: string): string {
+  return `'${input.replaceAll("'", `'"'"'`)}'`;
+}
+
+function linuxRuntimeRoot(): string {
+  return process.env.VORTEX_DOTNET_WIN_ROOT ?? "/opt/Vortex/dotnet-win-x64";
+}
+
+function linuxWinePrefix(): string {
+  return (
+    process.env.VORTEX_WINEPREFIX ??
+    path.join(
+      process.env.XDG_DATA_HOME ?? path.join(os.homedir(), ".local", "share"),
+      "vortex-linux",
+      "wineprefix",
+    )
+  );
+}
+
+function wineExecutable(): string {
+  return process.env.VORTEX_WINE ?? "wine";
+}
+
+function wineEnvironment(input: NodeJS.ProcessEnv | undefined): NodeJS.ProcessEnv {
+  return {
+    ...process.env,
+    ...input,
+    WINEDEBUG: input?.WINEDEBUG ?? "-all",
+    WINEPREFIX: input?.WINEPREFIX ?? linuxWinePrefix(),
+  };
+}
+
+export function resolveCaseInsensitiveSync(input: string): string {
+  if (process.platform !== "linux" || !path.isAbsolute(input) || fs.existsSync(input)) {
+    return input;
+  }
+
+  const normalized = path.normalize(input);
+  const root = path.parse(normalized).root;
+  const parts = path.relative(root, normalized).split(path.sep).filter(Boolean);
+  let current = root;
+
+  try {
+    for (const part of parts) {
+      const exact = path.join(current, part);
+      if (fs.existsSync(exact)) {
+        current = exact;
+        continue;
+      }
+
+      const match = fs
+        .readdirSync(current)
+        .find((entry) => entry.toLowerCase() === part.toLowerCase());
+      if (match === undefined) {
+        return resolveWindowsUserPathSync(input);
+      }
+      current = path.join(current, match);
+    }
+    return current;
+  } catch {
+    return resolveWindowsUserPathSync(input);
+  }
+}
+
+export function toWinePath(input: string): string {
+  const resolved = resolveCaseInsensitiveSync(path.resolve(input));
+  return `Z:${resolved.replaceAll(path.sep, "\\")}`;
+}
+
+export function mapWineArgument(input: string): string {
+  const { quote, value } = stripMatchingQuotes(input);
+  if (!path.isAbsolute(value) || !value.slice(1).includes(path.sep)) {
+    return input;
+  }
+
+  const resolved = resolveCaseInsensitiveSync(value);
+  const parent = path.dirname(resolved);
+  if (!fs.existsSync(resolved) && !fs.existsSync(parent)) {
+    return input;
+  }
+
+  const mapped = toWinePath(resolved);
+  return quote ? `${quote}${mapped}${quote}` : mapped;
+}
+
+function managedEntryPoint(executable: string): string | undefined {
+  const stem = executable.slice(0, -path.extname(executable).length);
+  const dll = resolveCaseInsensitiveSync(`${stem}.dll`);
+  const runtimeConfig = resolveCaseInsensitiveSync(`${stem}.runtimeconfig.json`);
+  return fs.existsSync(dll) && fs.existsSync(runtimeConfig) ? dll : undefined;
+}
+
+export function prepareWindowsProcess<TOptions extends ExecOptions | SpawnOptions>(
+  command: string,
+  args: readonly string[] = [],
+  options: TOptions,
+): IPreparedProcess<TOptions> {
+  const resolvedCommand = resolveCaseInsensitiveSync(command);
+  if (process.platform !== "linux" || path.extname(resolvedCommand).toLowerCase() !== ".exe") {
+    return { args: [...args], command, options, translated: false };
+  }
+
+  const mappedArgs = args.map(mapWineArgument);
+  const managed = managedEntryPoint(resolvedCommand);
+  const dotnet = path.join(linuxRuntimeRoot(), "dotnet.exe");
+  const translatedArgs =
+    managed !== undefined && fs.existsSync(dotnet)
+      ? [dotnet, toWinePath(managed), ...mappedArgs]
+      : [resolvedCommand, ...mappedArgs];
+
+  return {
+    args: translatedArgs,
+    command: wineExecutable(),
+    options: {
+      ...options,
+      env: wineEnvironment(options.env),
+      shell: false,
+    },
+    translated: true,
+  };
+}
+
+function mapQuotedShellPaths(input: string): string {
+  return input
+    .replace(/"(\/[^"\n]+)"/g, (_match, value: string) => `"${mapWineArgument(value)}"`)
+    .replace(/'(\/[^'\n]+)'/g, (_match, value: string) => shellQuote(mapWineArgument(value)))
+    .replace(/(^|\s)(\/[^\s"'|;&<>]+)/g, (_match, prefix: string, value: string) => {
+      return `${prefix}${shellQuote(mapWineArgument(value))}`;
+    });
+}
+
+export function prepareWindowsShellCommand(
+  command: string,
+  options: ExecOptions = {},
+): IPreparedShellCommand {
+  if (process.platform !== "linux") {
+    return { command, options, translated: false };
+  }
+
+  const match = command.match(
+    /^\s*(?:"([^"]+\.exe)"|'([^']+\.exe)'|([^\s"']+\.exe))(?=\s|$)([\s\S]*)$/i,
+  );
+  if (match === null) {
+    return { command, options, translated: false };
+  }
+
+  const executable = resolveCaseInsensitiveSync(match[1] ?? match[2] ?? match[3]);
+  const managed = managedEntryPoint(executable);
+  const dotnet = path.join(linuxRuntimeRoot(), "dotnet.exe");
+  const runner = [shellQuote(wineExecutable())];
+  if (managed !== undefined && fs.existsSync(dotnet)) {
+    runner.push(shellQuote(dotnet), shellQuote(toWinePath(managed)));
+  } else {
+    runner.push(shellQuote(executable));
+  }
+
+  return {
+    command: `${runner.join(" ")}${mapQuotedShellPaths(match[4])}`,
+    options: {
+      ...options,
+      env: wineEnvironment(options.env),
+    },
+    translated: true,
+  };
+}
+
+export function filterSuccessfulWineStderr(stderr: string | Buffer): string | Buffer {
+  if (typeof stderr !== "string") {
+    return stderr;
+  }
+  return stderr
+    .split(/\r?\n/)
+    .filter((line) => line.trim().length > 0 && !WINE_NOISE.some((pattern) => pattern.test(line)))
+    .join("\n");
+}
+
+export async function withCaseInsensitiveFallback<T>(
+  input: string,
+  operation: (resolved: string) => Promise<T>,
+): Promise<T> {
+  try {
+    return await operation(input);
+  } catch (err) {
+    if (!isMissingPathError(err)) {
+      throw err;
+    }
+    const resolved = resolveCaseInsensitiveSync(input);
+    if (resolved === input) {
+      throw err;
+    }
+    return operation(resolved);
+  }
+}
+
+export function withCaseInsensitiveFallbackSync<T>(
+  input: string,
+  operation: (resolved: string) => T,
+): T {
+  try {
+    return operation(input);
+  } catch (err) {
+    if (!isMissingPathError(err)) {
+      throw err;
+    }
+    const resolved = resolveCaseInsensitiveSync(input);
+    if (resolved === input) {
+      throw err;
+    }
+    return operation(resolved);
+  }
+}
diff --git a/src/renderer/src/util/linuxWinapi.test.ts b/src/renderer/src/util/linuxWinapi.test.ts
