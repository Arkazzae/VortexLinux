+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => ({
+  readVersionInfo: vi.fn(),
+}));
+
+vi.mock("./peVersion", () => ({
+  readVersionInfo: mocks.readVersionInfo,
+}));
+
+import {
+  getFileVersion,
+  getFileVersionLocalized,
+  getProductVersion,
+  getProductVersionLocalized,
+} from "./index";
+
+describe("portable executable version API", () => {
+  beforeEach(() => {
+    mocks.readVersionInfo.mockReset();
+  });
+
+  it("reads PE metadata on the host platform", () => {
+    mocks.readVersionInfo.mockReturnValue({
+      fileVersion: [1, 2, 3, 4],
+      fileVersionString: "1.2.3-preview",
+      productVersion: [5, 6, 7, 8],
+      productVersionString: "5.6.7-preview",
+    });
+
+    expect(getFileVersion("/games/Generic.exe")).toBe("1.2.3.4");
+    expect(getProductVersion("/games/Generic.exe")).toBe("5.6.7.8");
+    expect(getFileVersionLocalized("/games/Generic.exe")).toBe("1.2.3-preview");
+    expect(getProductVersionLocalized("/games/Generic.exe")).toBe("5.6.7-preview");
+    expect(mocks.readVersionInfo).toHaveBeenCalledTimes(4);
+  });
+
+  it("keeps the public empty-string fallback for unreadable files", () => {
+    mocks.readVersionInfo.mockReturnValue(undefined);
+
+    expect(getFileVersion("/games/Missing.exe")).toBe("");
+    expect(getProductVersion("/games/Missing.exe")).toBe("");
+    expect(getFileVersionLocalized("/games/Missing.exe")).toBe("");
+    expect(getProductVersionLocalized("/games/Missing.exe")).toBe("");
+  });
+});
