+import { promisify } from "node:util";
+
+import { resolveExtensionUserPathSync } from "./compatibilityPaths";
+
+// Extensions often use Node's fs directly, including successful mkdir/stat calls
+// on stale Linux directories. Resolve their game-specific Windows paths before
+// the operation, rather than waiting for an ENOENT fallback.
+const singlePathMethods = new Set([
+  "access",
+  "appendFile",
+  "chmod",
+  "chown",
+  "exists",
+  "lchmod",
+  "lchown",
+  "lstat",
+  "lutimes",
+  "mkdir",
+  "mkdtemp",
+  "open",
+  "opendir",
+  "readFile",
+  "readdir",
+  "readlink",
+  "realpath",
+  "rm",
+  "rmdir",
+  "stat",
+  "statfs",
+  "truncate",
+  "unlink",
+  "utimes",
+  "writeFile",
+]);
+const twoPathMethods = new Set(["copyFile", "cp", "link", "rename", "symlink"]);
+const moduleCache = new WeakMap<object, Map<boolean, object>>();
+type MethodKind = "sync" | "callback" | "promise";
+type FsMethod = (...args: unknown[]) => unknown;
+
+function wrapMethod(
+  method: FsMethod,
+  receiver: object,
+  pathArguments: number[],
+  kind: MethodKind,
+  exists: boolean,
+): typeof method {
+  const helpers = new Map<PropertyKey, typeof method>();
+  // A separate callable avoids violating Proxy invariants for Node's read-only
+  // promisify.custom property, while leaving the original function untouched.
+  const invoke = (...args: unknown[]) => Reflect.apply(method, receiver, args);
+  return new Proxy(invoke, {
+    apply(target, _this, args: unknown[]) {
+      let mapped: unknown[];
+      try {
+        mapped = [...args];
+        for (const index of pathArguments) {
+          // Node also accepts file descriptors, Buffers, and URLs. Preserve
+          // those values and let Node validate their original overloads.
+          if (typeof mapped[index] === "string") {
+            mapped[index] = resolveExtensionUserPathSync(mapped[index]);
+          }
+        }
+      } catch (error) {
+        if (kind === "promise") return exists ? Promise.resolve(false) : Promise.reject(error);
+        if (kind === "callback") {
+          const callback = args[args.length - 1];
+          if (typeof callback === "function") {
+            queueMicrotask(() => callback(exists ? false : error));
+            return;
+          }
+        }
+        if (exists) return false;
+        throw error;
+      }
+      return Reflect.apply(target, receiver, mapped);
+    },
+    get(_target, key) {
+      const value: unknown = Reflect.get(method, key);
+      // Keep realpath.native and promisify(fs.exists) on the same adapter.
+      if ((key === "native" || key === promisify.custom) && typeof value === "function") {
+        if (!helpers.has(key)) {
+          helpers.set(
+            key,
+            wrapMethod(
+              value as FsMethod,
+              receiver,
+              pathArguments,
+              key === promisify.custom ? "promise" : kind,
+              exists,
+            ),
+          );
+        }
+        return helpers.get(key);
+      }
+      return value;
+    },
+  });
+}
+
+/** A private fs view for extension modules; never modifies Node's shared fs. */
+export function wrapExtensionFs<T extends object>(target: T, moduleId: string): T {
+  if (
+    process.platform !== "linux" ||
+    !["fs", "node:fs", "fs/promises", "node:fs/promises"].includes(moduleId)
+  ) {
+    return target;
+  }
+  const promises = moduleId.endsWith("/promises");
+  let cached = moduleCache.get(target);
+  if (cached?.has(promises)) return cached.get(promises) as T;
+  cached ??= new Map();
+  const methods = new Map<PropertyKey, unknown>();
+  const proxy = new Proxy(target, {
+    get(fs, key, receiver) {
+      const value: unknown = Reflect.get(fs, key, receiver);
+      if (!promises && key === "promises" && typeof value === "object" && value !== null) {
+        return wrapExtensionFs(value, "fs/promises");
+      }
+      if (typeof key !== "string" || typeof value !== "function") return value;
+      const name = key.replace(/Sync$/, "");
+      if (!singlePathMethods.has(name) && !twoPathMethods.has(name)) return value;
+      if (!methods.has(key)) {
+        const kind = promises ? "promise" : key.endsWith("Sync") ? "sync" : "callback";
+        methods.set(
+          key,
+          wrapMethod(
+            value as FsMethod,
+            fs,
+            twoPathMethods.has(name) ? [0, 1] : [0],
+            kind,
+            name === "exists",
+          ),
+        );
+      }
+      return methods.get(key);
+    },
+  });
+  cached.set(promises, proxy);
+  moduleCache.set(target, cached);
+  return proxy;
+}
