+  const oldEnvironment = new Map<string, string | undefined>();
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-extension-fs-"));
+    local = path.join(root, "host", "Local");
+    profile = path.join(root, "prefix", "drive_c", "users", "steamuser");
+    fs.mkdirSync(profile, { recursive: true });
+    setEnvironment("VORTEX_LINUX_LOCAL_APPDATA", local);
+    setEnvironment("VORTEX_LINUX_LOCAL_LOW", path.join(root, "host", "LocalLow"));
+    setEnvironment("VORTEX_LINUX_APPDATA", path.join(root, "host", ".config"));
+    setEnvironment("VORTEX_LINUX_DOCUMENTS", path.join(root, "host", "Documents"));
+    setEnvironment("VORTEX_LINUX_SAVED_GAMES", path.join(root, "host", "Saved Games"));
+    setEnvironment("VORTEX_USERDATA", path.join(root, "host", ".config", "Vortex"));
+    game = {
+      path: path.join(root, "game"),
+      environment: { WINEPREFIX: path.join(root, "prefix") },
+    };
+    setCompatibilityGameProvider(() => game);
+  });
+
+  afterEach(() => {
+    setCompatibilityGameProvider(undefined);
+    fs.rmSync(root, { recursive: true, force: true });
+    for (const [key, value] of oldEnvironment) {
+      if (value === undefined) delete process.env[key];
+      else process.env[key] = value;
+    }
+    oldEnvironment.clear();
+  });
+
+  it.each([false, true])("checks the prefix filesystem with a stale host root: %s", (stale) => {
+    if (stale) {
+      fs.mkdirSync(local, { recursive: true });
+      fs.writeFileSync(path.join(local, "host.ini"), "keep");
+    }
+    const extensionFs = wrapExtensionFs(fs, "fs");
+    // This is the exact-root mkdir/stat sequence used by extension partition checks.
+    extensionFs.mkdirSync(local, { recursive: true });
+    const actualRoot = path.join(profile, "AppData", "Local");
+    const actualStat = fs.statSync(actualRoot);
+    expect(extensionFs.statSync(local).ino).toBe(actualStat.ino);
+    expect(extensionFs.statSync(local).dev).toBe(actualStat.dev);
+    const config = path.join(local, "Example", "Saved", "Config");
+    extensionFs.mkdirSync(config, { recursive: true });
+    extensionFs.writeFileSync(path.join(config, "Engine.ini"), "prefix");
+    expect(
+      fs.readFileSync(path.join(actualRoot, "Example", "Saved", "Config", "Engine.ini"), "utf8"),
+    ).toBe("prefix");
+    expect(fs.existsSync(path.join(local, "Example"))).toBe(false);
+    if (stale) expect(fs.readFileSync(path.join(local, "host.ini"), "utf8")).toBe("keep");
+    else expect(fs.existsSync(local)).toBe(false);
+  });
+
+  it("maps callback mkdir, read/write, stat, and exists including promisified exists", async () => {
+    const extensionFs = wrapExtensionFs(fs, "node:fs");
+    await promisify(extensionFs.mkdir)(local, { recursive: true });
+    const file = path.join(local, "Engine.ini");
+    await promisify(extensionFs.writeFile)(file, "callback");
+    expect((await promisify(extensionFs.stat)(file)).size).toBe(8);
+    expect(await promisify(extensionFs.readFile)(file, "utf8")).toBe("callback");
+    expect(await new Promise((resolve) => extensionFs.exists(file, resolve))).toBe(true);
+    expect(await promisify(extensionFs.exists)(file)).toBe(true);
+    expect(fs.readFileSync(path.join(profile, "AppData", "Local", "Engine.ini"), "utf8")).toBe(
