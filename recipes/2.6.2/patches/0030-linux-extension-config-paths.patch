+++ b/src/renderer/src/util/extensionRequire.test.ts
@@ -0,0 +1,59 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const modules = vi.hoisted(() => ({ load: vi.fn(), paths: [] as { path: string }[] }));
+vi.mock("../api", () => ({}));
+vi.mock("../controls/ReactSelectWrap", () => ({}));
+vi.mock("../ExtensionManager", () => ({ default: { getExtensionPaths: () => modules.paths } }));
+vi.mock("../extensions/extension_manager/queries", () => ({ findInstalled: vi.fn() }));
+vi.mock("./deprecatedApiUsage", () => ({ deprecatedApiGet: vi.fn() }));
+vi.mock("./webpack-hacks", () => ({ webpackRequireHack: modules.load }));
+
+import { setCompatibilityGameProvider } from "./compatibilityPaths";
+import { extensionRequire } from "./extensionRequire";
+
+describe.runIf(process.platform === "linux")("extension-only filesystem require", () => {
+  afterEach(() => {
+    setCompatibilityGameProvider(undefined);
+    modules.load.mockReset();
+    modules.paths = [];
+    vi.unstubAllEnvs();
+  });
+
+  it("maps an extension's fs while application callers keep Node's shared module", async () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-extension-require-"));
+    try {
+      const local = path.join(root, "host", "Local");
+      const prefix = path.join(root, "prefix");
+      const actual = path.join(prefix, "drive_c", "users", "steamuser", "AppData", "Local");
+      fs.mkdirSync(path.dirname(actual), { recursive: true });
+      vi.stubEnv("VORTEX_LINUX_LOCAL_APPDATA", local);
+      setCompatibilityGameProvider(() => ({
+        path: path.join(root, "game"),
+        environment: { WINEPREFIX: prefix },
+      }));
+      modules.paths = [{ path: path.join(root, "extensions") + path.sep }];
+      modules.load.mockImplementation((id: string) =>
+        id.endsWith("/promises") ? fs.promises : fs,
+      );
+      const originalRequire = vi.fn(() => fs);
+      const load = extensionRequire(originalRequire, () => []);
+      const appModule = { filename: path.join(root, "application", "main.js") };
+      const extModule = { filename: path.join(root, "extensions", "game-example", "index.js") };
+      expect(load.call(appModule, "fs")).toBe(fs);
+      const extensionFs: typeof fs = load.call(extModule, "fs");
+      extensionFs.mkdirSync(local, { recursive: true });
+      expect(extensionFs.statSync(local).ino).toBe(fs.statSync(actual).ino);
+      const extensionPromises: typeof fs.promises = load.call(extModule, "node:fs/promises");
+      await extensionPromises.writeFile(path.join(local, "Engine.ini"), "extension");
+      expect(fs.readFileSync(path.join(actual, "Engine.ini"), "utf8")).toBe("extension");
+      expect(fs.existsSync(local)).toBe(false);
+      expect(originalRequire).toHaveBeenCalledTimes(1);
+    } finally {
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
