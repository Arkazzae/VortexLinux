@@ -0,0 +1,19 @@
+import type { IRegisteredExtension } from "../../types/extensions";
+
+function matches(extension: IRegisteredExtension, id: string): boolean {
+  return extension.name === id || extension.info?.id === id || extension.info?.name === id;
+}
+
+export function isActionableDependencyFailure(
+  platform: NodeJS.Platform,
+  extensions: IRegisteredExtension[],
+  dependentId: string,
+  dependencyId: string,
+): boolean {
+  if (platform === "win32" || extensions.some((extension) => matches(extension, dependencyId))) {
+    return true;
+  }
+
+  const dependent = extensions.find((extension) => matches(extension, dependentId));
+  return dependent?.info?.bundled !== true;
+}
