@@ -0,0 +1,30 @@
+import { createInstance } from "i18next";
+import { describe, expect, it } from "vitest";
+
+import { renderLoadFailure } from "./renderLoadFailure";
+
+describe("extension load failure messages", () => {
+  it("names the missing Gamebryo dependency without an unexpanded placeholder", async () => {
+    const i18n = createInstance();
+    await i18n.init({ lng: "en", resources: {} });
+
+    const message = renderLoadFailure(i18n.t, {
+      id: "dependency",
+      args: { dependencyId: "gamebryo-plugin-management" },
+    });
+
+    expect(message).toBe("Depends on 'gamebryo-plugin-management'");
+  });
+
+  it("includes both the dependency name and required version", async () => {
+    const i18n = createInstance();
+    await i18n.init({ lng: "en", resources: {} });
+
+    const message = renderLoadFailure(i18n.t, {
+      id: "dependency",
+      args: { dependencyId: "gamebryo-plugin-management", version: "^0.5.3" },
+    });
+
+    expect(message).toBe("Depends on 'gamebryo-plugin-management' version '^0.5.3'");
+  });
+});
diff --git a/src/renderer/src/extensions/extension_manager/renderLoadFailure.ts b/src/renderer/src/extensions/extension_manager/renderLoadFailure.ts
new file mode 100644
index 000000000..4c72386ca
--- /dev/null
+++ b/src/renderer/src/extensions/extension_manager/renderLoadFailure.ts
@@ -0,0 +1,28 @@
+import type { TFunction } from "i18next";
+
+import type { IExtensionLoadFailure } from "../../types/IState";
+
+export function renderLoadFailure(t: TFunction, fail: IExtensionLoadFailure) {
+  if (fail.id === "unsupported-version") {
+    return t("Not compatible with this version of Vortex");
+  }
+
+  if (fail.id === "unsupported-api") {
+    return t("Unsupported API");
+  }
+
+  if (fail.id === "exception") {
+    return t("Failed to load: {{message}}", { replace: fail.args });
+  }
+
+  if (fail.id === "dependency") {
+    if (fail.args.version) {
+      return t("Depends on '{{dependencyId}}' version '{{version}}'", { replace: fail.args });
+    }
+
+    return t("Depends on '{{dependencyId}}'", { replace: fail.args });
+  }
+
+  const id = fail.id satisfies never;
+  return t("Unknown error '{{id}}'", { replace: { id } });
+}
