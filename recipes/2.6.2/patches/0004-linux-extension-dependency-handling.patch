@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+
+import type { IRegisteredExtension } from "../../types/extensions";
+import { isActionableDependencyFailure } from "./dependencyNotifications";
+
+function extension(name: string, bundled: boolean): IRegisteredExtension {
+  return {
+    dynamic: true,
+    info: {
+      author: "Test",
+      bundled,
+      description: "Test extension",
+      id: name,
+      name,
+      version: "1.0.0",
+    },
+    initFunc: undefined,
+    name,
+    namespace: name,
+    path: `/extensions/${name}`,
+  };
+}
+
+describe("dependency notifications", () => {
+  it("does not offer to install a dependency omitted from a platform build", () => {
+    const extensions = [extension("bundled-consumer", true)];
+    expect(
+      isActionableDependencyFailure("linux", extensions, "bundled-consumer", "omitted-provider"),
+    ).toBe(false);
+  });
+
+  it("keeps missing third-party dependencies actionable", () => {
+    const extensions = [extension("community-consumer", false)];
+    expect(
+      isActionableDependencyFailure("linux", extensions, "community-consumer", "missing-provider"),
+    ).toBe(true);
+  });
+
+  it("keeps version mismatches and Windows dependencies actionable", () => {
+    const extensions = [extension("bundled-consumer", true), extension("provider", true)];
+    expect(isActionableDependencyFailure("linux", extensions, "bundled-consumer", "provider")).toBe(
+      true,
+    );
+    expect(
+      isActionableDependencyFailure("win32", extensions, "bundled-consumer", "missing-provider"),
+    ).toBe(true);
+  });
+});
