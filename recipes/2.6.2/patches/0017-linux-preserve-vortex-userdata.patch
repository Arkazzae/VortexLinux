+/**
+ * Electron stores Vortex itself under {appData}/Vortex. That directory must
+ * stay on the Linux filesystem; leftover Wine copies of %APPDATA%\\Vortex
+ * in Steam prefixes are not a substitute for staging, downloads, or state.
+ */
+function vortexUserDataPath(): string {
+  return process.env.VORTEX_USERDATA ?? path.join(linuxAppDataPath(), "Vortex");
+}
+
+function isPathInside(root: string, candidate: string): boolean {
+  const relative = path.relative(path.resolve(root), path.resolve(candidate));
+  return (
+    relative === "" ||
+    (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
+  );
+}
