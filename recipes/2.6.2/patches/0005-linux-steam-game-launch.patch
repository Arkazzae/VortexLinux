diff --git a/src/renderer/src/util/StarterInfo.linux.test.ts b/src/renderer/src/util/StarterInfo.linux.test.ts
new file mode 100644
index 000000000..706978228
--- /dev/null
+++ b/src/renderer/src/util/StarterInfo.linux.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+
+import { findSteamEntryForStarter, type IStarterInfo } from "./StarterInfo";
+import type { ISteamEntry } from "./Steam";
+
+const starfield: ISteamEntry = {
+  appid: "1716740",
+  gamePath: "/games/SteamLibrary/steamapps/common/Starfield",
+  gameStoreId: "steam",
+  name: "Starfield",
+};
+
+function starter(overrides: Partial<IStarterInfo> = {}): IStarterInfo {
+  return {
+    commandLine: [],
+    detach: true,
+    environment: {},
+    exclusive: true,
+    exePath: `${starfield.gamePath}/Starfield.exe`,
+    extensionPath: "",
+    gameId: "starfield",
+    iconOutPath: "",
+    id: "starfield",
+    isGame: true,
+    logoName: "",
+    name: "Starfield",
+    shell: false,
+    store: "steam",
+    workingDirectory: starfield.gamePath,
+    ...overrides,
+  };
+}
+
+describe("Linux Steam launch routing", () => {
+  it("matches a Steam entry by the executable location", () => {
+    expect(findSteamEntryForStarter(starter(), [starfield], "linux")?.appid).toBe("1716740");
+  });
+
+  it("matches paths without depending on their letter case", () => {
+    expect(
+      findSteamEntryForStarter(
+        starter({ exePath: `${starfield.gamePath.toUpperCase()}/STARFIELD.EXE` }),
+        [starfield],
+        "linux",
+      )?.appid,
+    ).toBe("1716740");
+  });
+
+  it("does not confuse games whose directory names share a prefix", () => {
+    expect(
+      findSteamEntryForStarter(
+        starter({
+          exePath: "/games/SteamLibrary/steamapps/common/StarfieldTools/tool.exe",
+          workingDirectory: "/games/SteamLibrary/steamapps/common/StarfieldTools",
+        }),
+        [starfield],
+        "linux",
+      ),
+    ).toBeUndefined();
+  });
+
+  it("does not reroute non-Steam or Windows launches", () => {
+    expect(
+      findSteamEntryForStarter(starter({ store: "gog" }), [starfield], "linux"),
+    ).toBeUndefined();
+    expect(findSteamEntryForStarter(starter(), [starfield], "win32")).toBeUndefined();
+  });
+});
