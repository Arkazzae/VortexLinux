+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { test } = require('node:test');
+const zlib = require('node:zlib');
+const ts = require('typescript');
+
+// Execute the actual backported source with the repository's pinned compiler.
+require.extensions['.ts'] = (module, filename) => {
+  const result = ts.transpileModule(fs.readFileSync(filename, 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 },
+    fileName: filename,
+  });
+  module._compile(result.outputText, filename);
+};
+
+const { ESPFile } = require('../src/esp/ESPFile.ts');
+const { BSAWriter, loadBSA } = require('../../gamebryo-bsa-support/src/bsa.ts');
+const { loadBA2 } = require('../../gamebryo-ba2-support/src/ba2.ts');
+const { resolveArchiveOutputPath } = require('../../gamebryo-ba2-support/src/archivePath.ts');
+const { parseSaveGame } = require('../../gamebryo-savegame-management/src/savegame/GamebryoSaveGame.ts');
+
+const u16 = (value) => { const b = Buffer.alloc(2); b.writeUInt16LE(value); return b; };
+const u32 = (value) => { const b = Buffer.alloc(4); b.writeUInt32LE(value); return b; };
+const u64 = (value) => { const b = Buffer.alloc(8); b.writeBigUInt64LE(BigInt(value)); return b; };
+const string = (value) => Buffer.concat([u16(Buffer.byteLength(value)), Buffer.from(value)]);
+
+function temporary(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'vortex-legacy-gamebryo-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  return root;
+}
+
+function plugin(flags = 1, oblivion = false) {
+  const record = (type, data) => Buffer.concat([Buffer.from(type), u16(data.length), data]);
+  const hedr = Buffer.alloc(12);
+  hedr.writeFloatLE(1.7);
+  hedr.writeUInt32LE(3, 4);
+  const body = Buffer.concat([
+    record('HEDR', hedr),
+    record('MAST', Buffer.from('Fallout4.esm\0')),
+    record('CNAM', Buffer.from('Legacy test\0')),
+    record('SNAM', Buffer.from('Linux plugin fixture\0')),
+  ]);
+  const header = Buffer.alloc(oblivion ? 20 : 24);
+  header.write('TES4');
+  header.writeUInt32LE(body.length, 4);
+  header.writeUInt32LE(flags, 8);
+  if (!oblivion) header.writeUInt16LE(44, 20);
+  return Buffer.concat([header, body]);
+}
+
+test('legacy synchronous ESP metadata and light-flag writes preserve other flags', (t) => {
+  const root = temporary(t);
+  const file = path.join(root, 'Legacy.esp');
+  fs.writeFileSync(file, plugin());
+  const esp = new ESPFile(file, 'fallout4');
+  assert.equal(esp.isMaster, true);
+  assert.equal(esp.isLight, false);
+  assert.equal(esp.isDummy, false);
+  assert.equal(esp.author, 'Legacy test');
+  assert.equal(esp.description, 'Linux plugin fixture');
+  assert.deepEqual(esp.masterList, ['Fallout4.esm']);
+  assert.equal(esp.setLightFlag(true), undefined);
+  assert.equal(new ESPFile(file, 'fallout4').isLight, true);
+  assert.equal(fs.readFileSync(file).readUInt32LE(8), 0x201);
+  esp.setLightFlag(false);
+  assert.equal(fs.readFileSync(file).readUInt32LE(8), 1);
+  fs.writeFileSync(file, plugin(1, true));
+  assert.equal(new ESPFile(file, 'oblivion').revision, 0x52444548);
+  fs.writeFileSync(file, plugin().subarray(0, 30));
+  assert.throws(() => new ESPFile(file, 'fallout4'), /incomplete/);
+});
+
+test('BSA creation and extraction work with Linux paths for versions 103, 104 and 105', async (t) => {
+  const root = temporary(t);
+  const source = path.join(root, 'source.txt');
+  fs.writeFileSync(source, 'legacy archive content');
+  for (const version of [103, 104, 105]) {
+    const file = path.join(root, `test-${version}.bsa`);
+    const writer = new BSAWriter(file, version);
+    writer.addFile('Meshes\\Weapons\\Sword.nif', source);
+    await writer.write();
+    const archive = await loadBSA(file, true);
+    assert.equal(archive.version, version);
+    const output = path.join(root, `extracted-${version}`);
+    await archive.extractAll(output);
+    assert.equal(fs.readFileSync(path.join(output, 'Meshes', 'Weapons', 'Sword.nif'), 'utf8'),
+      'legacy archive content');
+  }
+});
+
+test('Fallout 4 BA2 extraction inflates data and creates native directories', async (t) => {
+  const root = temporary(t);
+  const name = 'Scripts\\Legacy.pex';
+  const contents = Buffer.from('collection archive payload '.repeat(10));
+  const compressed = zlib.deflateSync(contents);
+  const header = Buffer.alloc(24);
+  header.write('BTDX');
+  header.writeUInt32LE(1, 4);
+  header.write('GNRL', 8);
+  header.writeUInt32LE(1, 12);
+  header.writeBigUInt64LE(BigInt(60 + compressed.length), 16);
+  const entry = Buffer.alloc(36);
+  entry.write('pex', 4);
+  entry.writeBigUInt64LE(60n, 16);
+  entry.writeUInt32LE(compressed.length, 24);
+  entry.writeUInt32LE(contents.length, 28);
+  const file = path.join(root, 'test.ba2');
+  fs.writeFileSync(file, Buffer.concat([header, entry, compressed, string(name)]));
+  const archive = await loadBA2(file);
+  assert.deepEqual(archive.fileList, [name]);
+  await archive.extractAll(path.join(root, 'output'));
+  assert.deepEqual(fs.readFileSync(path.join(root, 'output', 'Scripts', 'Legacy.pex')), contents);
+  for (const name of ['..\\escape', '/absolute', 'C:\\absolute', 'folder\\..\\escape']) {
+    assert.throws(() => resolveArchiveOutputPath(root, name), /Unsafe archive path/);
+  }
+});
+
+test('Fallout 4 saves retain metadata, regular/light plugins and RGBA screenshots', (t) => {
+  const root = temporary(t);
+  const file = path.join(root, 'Legacy.fos');
+  const timestamp = 1700000000n;
+  const buffer = Buffer.concat([
+    Buffer.from('FO4_SAVEGAME'), u32(0), u32(15), u32(42), string('Nora'),
+    u32(23), string('Sanctuary'), string('12.34.56'), string('HumanRace'),
+    u16(1), u32(0), u32(0), u64((timestamp + 11644473600n) * 10000000n),
+    u32(1), u32(1), Buffer.from([30, 40, 50, 255]),
+    Buffer.from([0x44]), string('1.10.163.0'), u32(0),
+    Buffer.from([1]), string('Fallout4.esm'), u16(1), string('Legacy.esl'),
+  ]);
+  fs.writeFileSync(file, buffer);
+  const metadata = parseSaveGame(file, true);
+  assert.equal(metadata.characterName, 'Nora');
+  assert.equal(metadata.saveNumber, 42);
+  assert.equal(metadata.creationTime, Number(timestamp));
+  const full = parseSaveGame(file, false);
+  assert.deepEqual(full.plugins, ['Fallout4.esm', 'Legacy.esl']);
+  assert.deepEqual(full.screenshotSize, { width: 1, height: 1 });
+  assert.deepEqual(full.screenshot, Buffer.from([30, 40, 50, 255]));
+  fs.writeFileSync(file, buffer.subarray(0, 25));
+  assert.throws(() => parseSaveGame(file, true), /Unexpected end/);
+});
