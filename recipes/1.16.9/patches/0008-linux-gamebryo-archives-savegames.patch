diff --git a/extensions/gamebryo-ba2-support/src/archivePath.ts b/extensions/gamebryo-ba2-support/src/archivePath.ts
new file mode 100644
index 0000000..fb8dbc5
--- /dev/null
+++ b/extensions/gamebryo-ba2-support/src/archivePath.ts
@@ -0,0 +1,38 @@
+import * as path from "node:path";
+
+function unsafeArchivePath(archivePath: string): Error {
+  return new Error(`Unsafe archive path: ${archivePath}`);
+}
+
+/**
+ * Convert the Windows-style paths stored in BSA/BA2 archives to a native,
+ * relative output path without allowing an archive entry to escape its target.
+ */
+export function resolveArchiveOutputPath(outputPath: string, archivePath: string): string {
+  const portablePath = archivePath.replace(/\\/g, "/");
+  const segments = portablePath.split("/");
+  if (
+    portablePath.startsWith("/") ||
+    /^[A-Za-z]:/.test(portablePath) ||
+    segments.some(
+      (segment) =>
+        segment.length === 0 || segment === "." || segment === ".." || segment.includes("\0"),
+    )
+  ) {
+    throw unsafeArchivePath(archivePath);
+  }
+
+  const outputRoot = path.resolve(outputPath);
+  const resolvedPath = path.resolve(outputRoot, ...segments);
+  const relativePath = path.relative(outputRoot, resolvedPath);
+  if (
+    relativePath.length === 0 ||
+    relativePath === ".." ||
+    relativePath.startsWith(`..${path.sep}`) ||
+    path.isAbsolute(relativePath)
+  ) {
+    throw unsafeArchivePath(archivePath);
+  }
+
+  return resolvedPath;
+}
diff --git a/extensions/gamebryo-ba2-support/src/ba2.ts b/extensions/gamebryo-ba2-support/src/ba2.ts
