@@ -0,0 +1,44 @@
+// The metadata contract consumed by the 1.16 plugin UI. The Linux worker maps
+// libloot's current Node binding back to these historical field names.
+export interface MessageContent {
+  text: string;
+  language: string;
+}
+
+export interface Message {
+  type: number;
+  content: string | MessageContent[];
+  condition?: string;
+}
+
+export interface Tag {
+  name: string;
+  isAddition: boolean;
+  condition?: string;
+}
+
+export interface PluginCleaningData {
+  CRC: number;
+  itmCount: number;
+  deletedReferenceCount: number;
+  deletedNavmeshCount: number;
+  cleaningUtility: string;
+  info: MessageContent[];
+}
+
+export interface PluginReference {
+  name: string;
+  displayName?: string;
+}
+
+export interface PluginMetadata {
+  name: string;
+  group?: string;
+  messages: Message[];
+  tags: Tag[];
+  cleanInfo: PluginCleaningData[];
+  dirtyInfo: PluginCleaningData[];
+  requirements: PluginReference[];
+  incompatibilities: PluginReference[];
+  loadAfterFiles: PluginReference[];
+}
