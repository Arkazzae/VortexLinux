diff --git a/scripts/build-linux.sh b/scripts/build-linux.sh
new file mode 100644
index 0000000..05d12f2
--- /dev/null
+++ b/scripts/build-linux.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$source_root"
+export CI=1
+export NO_PARALLEL=1
+export npm_config_runtime=electron
+export npm_config_target=37.4.0
+export npm_config_disturl=https://electronjs.org/headers
+export PATH="$source_root/node_modules/.bin:$PATH"
+
+install_dependencies() {
+  yarn --cwd "$1" install --frozen-lockfile --ignore-scripts --non-interactive --network-timeout 120000
+}
+
+case "${1:-build}" in
+  prepare)
+    install_dependencies "$source_root"
+    node node_modules/electron/install.js
+    node node_modules/node-gyp/bin/node-gyp.js install --target "$npm_config_target"
+    for module in Native IPC; do
+      module_path="$source_root/extensions/fomod-installer/src/ModInstaller.${module}.TypeScript"
+      install_dependencies "$module_path"
+      (cd "$module_path" && node build.js build Release)
+    done
+    install_dependencies "$source_root/app"
+    for tree in "$source_root" "$source_root/app"; do
+      bash scripts/rebuild-linux-native.sh "$tree"
+      for module in Native IPC; do
+        name="$(tr '[:upper:]' '[:lower:]' <<< "$module")"
+        cp -a "extensions/fomod-installer/src/ModInstaller.${module}.TypeScript/dist/." \
+          "$tree/node_modules/fomod-installer-$name/dist/"
+      done
+    done
+    ;;
+  build)
+    : "${LIBLOOT_NODE_PATH:?Build the pinned libloot binding first}"
+    node node_modules/typescript/bin/tsc -p api -d --target es2022
+    node node_modules/typescript/bin/tsc -p src/util/vortex-run -d
+    install -dm755 node_modules/vortex-run/lib app/node_modules/vortex-run/lib
+    cp -a src/util/vortex-run/lib/. node_modules/vortex-run/lib/
+    cp -a src/util/vortex-run/lib/. app/node_modules/vortex-run/lib/
+    # Preserve the legacy extension build entry points and their asset copying.
+    mapfile -t projects < <(node - <<'NODE'
+for (const project of require('./BuildSubprojects.json').flat()) {
+  if (project.type === 'build-copy' && (!project.os || project.os.includes('linux'))) {
+    console.log(project.path + '\t' + project.copyTo.replace('{BUILD_DIR}', 'app'));
+  }
+}
+NODE
+    )
+    for entry in "${projects[@]}"; do
+      IFS=$'\t' read -r project target <<< "$entry"
+      install_dependencies "$source_root/$project"
+      bash scripts/rebuild-linux-native.sh "$source_root/$project"
+      if [[ "$project" == extensions/modtype-umm ]]; then
+        yarn --cwd "$project" run postinstall
+      fi
+      yarn --cwd "$project" run build
+      install -dm755 "$target"
+      cp -a "$project/dist/." "$target/"
+    done
+    yarn run _assets_app
+    yarn run build_dist
+    node scripts/build-linux-self-test.cjs
+    node node_modules/electron-builder/cli.js --config electron-builder-config.json \
+      --publish never --linux dir --x64 -c.compression=store
+    ;;
+  *)
+    printf 'Usage: build-linux.sh prepare|build\n' >&2
+    exit 2
+    ;;
+esac
diff --git a/scripts/rebuild-linux-native.sh b/scripts/rebuild-linux-native.sh
new file mode 100644
index 0000000..9ce1df6
--- /dev/null
+++ b/scripts/rebuild-linux-native.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+modules_root="${1:?Usage: rebuild-linux-native.sh DIRECTORY_WITH_NODE_MODULES}"
+export npm_config_runtime=electron
+export npm_config_target=37.4.0
+export npm_config_disturl=https://electronjs.org/headers
+# Do not inherit a local -march=native when producing redistributable addons.
+export CFLAGS='-march=x86-64 -mtune=generic -O2 -pipe -fPIC'
+export CXXFLAGS="$CFLAGS"
+export PATH="$source_root/node_modules/.bin:$PATH"
+
+for module in diskusage drivelist vortexmt xxhash-addon leveldown bsdiff-node font-scanner; do
+  module_path="$modules_root/node_modules/$module"
+  if [[ ! -f "$module_path/binding.gyp" ]]; then
+    continue
+  fi
+  (
+    cd "$module_path"
+    if [[ "$module" == vortexmt ]]; then
+      autogypi
+    fi
+    node "$source_root/node_modules/node-gyp/bin/node-gyp.js" rebuild --release
+    if [[ "$module" == leveldown ]]; then
+      install -Dm755 build/Release/leveldown.node prebuilds/linux-x64/node.napi.glibc.node
+    fi
+  )
+done
