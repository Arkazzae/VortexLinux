+};
diff --git a/test-setup.linux.ts b/test-setup.linux.ts
new file mode 100644
index 0000000..2f35ad5
--- /dev/null
+++ b/test-setup.linux.ts
@@ -0,0 +1,39 @@
+import Module, { createRequire } from "node:module";
+import * as os from "node:os";
+import * as path from "node:path";
+import { vi } from "vitest";
+
+// Vite aliases cover ESM imports. Legacy dependencies also use CommonJS require.
+const require = createRequire(import.meta.url);
+const electron = require("./test-mocks/electron.cjs");
+const loader = Module as typeof Module & { _load: (...args: any[]) => any };
+const originalLoad = loader._load;
+loader._load = function (request, ...args) {
+  if (request === "electron" || request === "@electron/remote") return electron;
+  if (request === "original-fs") return require("node:fs");
+  if (request === "winapi-bindings") return require("./test-mocks/windows-native.cjs");
+  return originalLoad.call(this, request, ...args);
+};
+
+Object.defineProperty(globalThis, "window", {
+  configurable: true,
+  value: Object.assign(new EventTarget(), { api: {}, performance: globalThis.performance }),
+});
+vi.mock("./src/util/log", () => ({ log: vi.fn() }));
+vi.mock("./src/util/errorHandling", () => ({
+  createErrorReport: vi.fn(),
+  getVisibleWindow: () => undefined,
+  disableErrorReport: vi.fn(),
+}));
+vi.mock("./src/util/message", () => ({ showError: vi.fn() }));
+vi.mock("./src/util/getVortexPath", () => {
+  const getPath = (name: string) => path.join(os.tmpdir(), "vortex-legacy-test", name);
+  return { default: getPath, getVortexPathAsync: async (name: string) => getPath(name) };
+});
+vi.mock("./src/util/application", () => ({ getApplication: () => ({ version: "1.16.9" }) }));
+vi.mock("./src/extensions/gamemode_management/util/getGame", () => ({
+  getGame: () => ({ details: {} }), getGames: () => [], getGameStores: () => [],
+}));
+vi.mock("./src/extensions/gamemode_management/util/discovery", () => ({ suggestStagingPath: vi.fn() }));
+vi.mock("./src/extensions/mod_management/InstallManager", () => ({ INI_TWEAKS_PATH: "ini tweaks" }));
+vi.mock("./src/extensions/ini_prep/TweakList", () => ({ default: () => null }));
