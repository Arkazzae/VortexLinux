+const os = require("node:os");
+const path = require("node:path");
+const { EventEmitter } = require("node:events");
+
+const app = Object.assign(new EventEmitter(), {
+  getName: () => "Vortex",
+  getVersion: () => "1.16.9",
+  getPath: (name) => path.join(os.tmpdir(), "vortex-legacy-test", name),
+  getAppPath: () => process.cwd(),
+  setPath() {},
+});
+const dialog = {
+  showMessageBox: async () => ({ response: 0 }),
+  showMessageBoxSync: () => 0,
+};
+const ipcMain = Object.assign(new EventEmitter(), { handle() {}, removeHandler() {} });
+const ipcRenderer = Object.assign(new EventEmitter(), { send() {}, sendSync() {} });
+module.exports = {
+  app, dialog, ipcMain, ipcRenderer,
+  shell: { openExternal: async () => {}, showItemInFolder() {} },
+  BrowserWindow: { getAllWindows: () => [], getFocusedWindow: () => undefined },
+  getCurrentWindow: () => undefined,
+};
