index 0000000..feb6874
--- /dev/null
+++ b/src/extensions/hardlink_activator/hardlinkIdentity.ts
@@ -0,0 +1,101 @@
+import * as nodeFs from "fs";
+
+import PromiseBB from "bluebird";
+import type { IEntry } from "turbowalk";
+import turbowalk from "turbowalk";
+
+/**
+ * Resolve a hard-link identity without assuming the Windows-only turbowalk
+ * details are available. Device and inode together are unique within a POSIX
+ * filesystem and bigint stats avoid precision loss for large inode values.
+ */
+export async function resolveHardlinkKey(entry: IEntry): Promise<string | undefined> {
+  if (entry.isDirectory || entry.linkCount === 1) {
+    return undefined;
+  }
+  if (entry.linkCount !== undefined && entry.idStr !== undefined) {
+    return entry.linkCount > 1 ? `native:${entry.idStr}` : undefined;
+  }
+
+  try {
+    const stats = await nodeFs.promises.lstat(entry.filePath, { bigint: true });
+    return stats.nlink > 1n ? `posix:${stats.dev}:${stats.ino}` : undefined;
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code === "ENOENT") {
+      return undefined;
+    }
+    throw err;
+  }
+}
+
+export function collectHardlinkKeys(rootPath: string): PromiseBB<Set<string>> {
+  const keys = new Set<string>();
+  let queue = PromiseBB.resolve();
+
+  return turbowalk(
+    rootPath,
+    (entries) => {
+      queue = queue.then(() =>
+        PromiseBB.map(
+          entries,
+          async (entry) => {
+            const key = await resolveHardlinkKey(entry);
+            if (key !== undefined) {
+              keys.add(key);
+            }
+          },
+          { concurrency: 50 },
+        ).then(() => undefined),
+      );
+    },
+    { details: true, skipHidden: false },
+  )
+    .then(() => queue)
+    .then(() => keys);
+}
+
+export function purgeMatchingHardlinks(
+  dataPath: string,
+  keys: Set<string>,
+  onProgress?: (num: number, total: number) => void,
+): PromiseBB<number> {
+  let purged = 0;
+  let queue = PromiseBB.resolve();
+
+  if (keys.size === 0) {
+    return PromiseBB.resolve(0);
+  }
+
+  return turbowalk(
+    dataPath,
+    (entries) => {
+      queue = queue.then(() =>
+        PromiseBB.map(
+          entries,
+          async (entry) => {
+            const key = await resolveHardlinkKey(entry);
+            if (key === undefined || !keys.has(key)) {
+              return;
+            }
+
+            try {
+              await nodeFs.promises.unlink(entry.filePath);
+              ++purged;
+              if (purged % 1000 === 0) {
+                onProgress?.(purged, keys.size);
+              }
+            } catch (err) {
+              if ((err as NodeJS.ErrnoException).code !== "ENOENT") {
+                throw err;
+              }
+            }
+          },
+          { concurrency: 50 },
+        ).then(() => undefined),
+      );
+    },
+    { details: true, skipHidden: false },
+  )
+    .then(() => queue)
+    .then(() => purged);
+}
diff --git a/src/extensions/hardlink_activator/index.linux.test.ts b/src/extensions/hardlink_activator/index.linux.test.ts
