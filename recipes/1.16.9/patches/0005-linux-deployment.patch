diff --git a/src/test-utils/deploymentTest.ts b/src/test-utils/deploymentTest.ts
new file mode 100644
index 0000000..5adc425
--- /dev/null
+++ b/src/test-utils/deploymentTest.ts
@@ -0,0 +1,125 @@
+import * as nodeFs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import PromiseBB from "bluebird";
+import { test as baseTest, vi } from "vitest";
+
+import hardlinkInit, { IExtensionContextEx } from "../extensions/hardlink_activator";
+import type { IDeployedFile, IDeploymentMethod } from "../extensions/mod_management/types/IDeploymentMethod";
+import BlacklistSet from "../extensions/mod_management/util/BlacklistSet";
+import type { IExtensionApi } from "../types/IExtensionContext";
+import type { IGame } from "../types/IGame";
+import type { Normalize } from "../util/getNormalizeFunc";
+
+// Keep the game's registry and Electron extension loader out of filesystem
+// integration tests. Deployment, hardlinks and manifest writes remain real.
+const games = vi.hoisted(() => new Map<string, IGame>());
+vi.mock("../extensions/gamemode_management/util/getGame", () => ({
+  getGame: (gameId: string) => games.get(gameId),
+}));
+vi.mock("../util/api", async () => ({
+  getGame: (gameId: string) => games.get(gameId),
+  UserCanceled: (await import("../util/CustomErrors")).UserCanceled,
+}));
+vi.mock("../extensions/gamemode_management/util/discovery", () => ({
+  suggestStagingPath: vi.fn(),
+}));
+
+interface IDeploymentOptions {
+  files: Record<string, string>;
+  modName?: string;
+  gameId?: string;
+}
+
+interface IDeploymentHarness {
+  api: IExtensionApi;
+  method: IDeploymentMethod;
+  gameDir: string;
+  stagingDir: string;
+  normalize: Normalize;
+  deploy: (lastDeployment?: IDeployedFile[]) => Promise<IDeployedFile[]>;
+  inGame: (relativePath: string) => string;
+}
+
+function makeDeploymentHarness(options: IDeploymentOptions) {
+  const gameId = options.gameId ?? "skyrimse";
+  const modName = options.modName ?? "SomeMod";
+  const root = nodeFs.mkdtempSync(path.join(os.tmpdir(), "vortex-legacy-deploy-"));
+  const gameDir = path.join(root, "game", "Data");
+  const stagingDir = path.join(root, "staging");
+  const modDir = path.join(stagingDir, modName);
+  nodeFs.mkdirSync(gameDir, { recursive: true });
+  nodeFs.mkdirSync(modDir, { recursive: true });
+  for (const [relativePath, content] of Object.entries(options.files)) {
+    const source = path.join(modDir, relativePath);
+    nodeFs.mkdirSync(path.dirname(source), { recursive: true });
+    nodeFs.writeFileSync(source, content);
+  }
+
+  const game = {
+    id: gameId,
+    details: {},
+    directoryCleaning: "tag",
+    getModPaths: () => ({ "": gameDir }),
+    executable: () => "Game.exe",
+  } as unknown as IGame;
+  games.set(gameId, game);
+  const state = {
+    settings: {
+      mods: { cleanupOnDeploy: false, installPath: { [gameId]: stagingDir } },
+      profiles: { activeProfileId: "test-profile" },
+      gameMode: { discovered: { [gameId]: { path: path.dirname(gameDir) } } },
+    },
+    persistent: { profiles: { "test-profile": { id: "test-profile", gameId } } },
+  };
+  const api = {
+    getState: () => state,
+    store: { getState: () => state, dispatch: vi.fn() },
+    translate: (message: string) => message,
+    events: { emit: vi.fn() },
+    showErrorNotification: vi.fn(),
+    showDialog: vi.fn(() => PromiseBB.resolve({ action: "Cancel" })),
+  } as unknown as IExtensionApi;
+
+  let method: IDeploymentMethod;
+  hardlinkInit({
+    api,
+    registerDeploymentMethod: (registered: IDeploymentMethod) => { method = registered; },
+  } as IExtensionContextEx);
+  const normalize: Normalize = (input) => input.toLowerCase();
+  const blacklist = new BlacklistSet([], game, normalize);
+  const harness: IDeploymentHarness = {
+    api, method, gameDir, stagingDir, normalize,
+    inGame: (relativePath) => path.join(gameDir, relativePath),
+    deploy: async (lastDeployment = []) => {
+      await method.prepare(gameDir, false, lastDeployment, normalize);
+      await method.activate(modDir, modName, "", blacklist);
+      return method.finalize(gameId, gameDir, stagingDir);
+    },
+  };
+  return {
+    harness,
+    cleanup: () => {
+      games.delete(gameId);
+      nodeFs.rmSync(root, { recursive: true, force: true, maxRetries: 10, retryDelay: 50 });
+    },
+  };
+}
+
+export const test = baseTest.extend<{
+  makeDeployment: (options: IDeploymentOptions) => IDeploymentHarness;
+}>({
+  makeDeployment: async ({ task: _task }, use) => {
+    const cleanups: Array<() => void> = [];
+    try {
+      await use((options) => {
+        const { harness, cleanup } = makeDeploymentHarness(options);
+        cleanups.push(cleanup);
+        return harness;
+      });
+    } finally {
+      cleanups.forEach((cleanup) => cleanup());
+    }
+  },
+});
