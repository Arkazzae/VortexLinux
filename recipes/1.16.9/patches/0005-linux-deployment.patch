@@ -0,0 +1,52 @@
+import type { IExtensionApi } from "../../../types/IExtensionContext";
+import * as fs from "../../../util/fs";
+import { log } from "../../../util/log";
+import { suggestStagingPath } from "../../gamemode_management/util/discovery";
+import { setInstallPath } from "../actions/settings";
+import { installPathForGame } from "../selectors";
+
+const STAGING_DIR_TAG = "__vortex_staging_folder";
+
+export function stagingDirectoryHasMods(entries: string[]): boolean {
+  return entries.some((entry) => entry !== STAGING_DIR_TAG);
+}
+
+/**
+ * Apply the same-filesystem staging suggestion when doing so cannot orphan any
+ * installed mods. Non-empty staging folders still go through Settings, whose
+ * transfer workflow can move their contents safely.
+ */
+export async function applySuggestedStagingPathIfEmpty(
+  api: IExtensionApi,
+  gameId: string,
+): Promise<boolean> {
+  const currentPath = installPathForGame(api.getState(), gameId);
+  let entries: string[];
+
+  try {
+    entries = await fs.readdirAsync(currentPath);
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code !== "ENOENT") {
+      log("warn", "failed to inspect staging directory before automatic fix", {
+        gameId,
+        currentPath,
+        error: err,
+      });
+      return false;
+    }
+    entries = [];
+  }
+
+  if (stagingDirectoryHasMods(entries)) {
+    return false;
+  }
+
+  const suggestion = await suggestStagingPath(api, gameId);
+  api.store.dispatch(setInstallPath(gameId, suggestion));
+  log("info", "applied same-filesystem staging suggestion", {
+    gameId,
+    from: currentPath,
+    to: suggestion,
+  });
+  return true;
+}
