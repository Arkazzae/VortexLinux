index 0000000..d1e1282
--- /dev/null
+++ b/src/extensions/mod_management/util/getDeploymentNormalizeFunc.ts
@@ -0,0 +1,30 @@
+import * as path from "path";
+
+import type { IGame } from "../../../types/IGame";
+import getNormalizeFunc from "../../../util/getNormalizeFunc";
+
+/**
+ * Windows games keep case-insensitive path semantics even when they run via
+ * Wine/Proton on a case-sensitive Linux filesystem. Deployment keys must use
+ * those semantics or two mods can deploy the same Windows path under different
+ * casing and alternate between old and new content.
+ */
+export function hasWindowsPathSemantics(game: IGame, discoveredPath?: string): boolean {
+  try {
+    return path.extname(game?.executable?.(discoveredPath) ?? "").toLowerCase() === ".exe";
+  } catch {
+    // Some extensions inspect the discovered directory in executable(). If an
+    // extension cannot answer here, retain the filesystem-detection fallback.
+    return false;
+  }
+}
+
+export default function getDeploymentNormalizeFunc(
+  game: IGame,
+  discoveredPath: string | undefined,
+  deploymentPath: string,
+) {
+  return getNormalizeFunc(deploymentPath, {
+    caseInsensitive: hasWindowsPathSemantics(game, discoveredPath),
+  });
+}
