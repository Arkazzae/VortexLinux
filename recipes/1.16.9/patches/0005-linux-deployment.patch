+import * as nodeFs from "fs/promises";
+import * as os from "os";
+import * as path from "path";
+
+import { expect, it } from "vitest";
+
+import { restoreIniBackup } from "./index";
+
+it("skips an optional ini whose backup was never created", async () => {
+  const tempPath = await nodeFs.mkdtemp(path.join(os.tmpdir(), "vortex-ini-purge-"));
+  try {
+    const iniPath = path.join(tempPath, "Optional.ini");
+
+    await expect(restoreIniBackup(iniPath)).resolves.toBeUndefined();
+    await expect(nodeFs.stat(iniPath)).rejects.toMatchObject({ code: "ENOENT" });
+  } finally {
+    await nodeFs.rm(tempPath, { recursive: true, force: true });
+  }
+});
+
+it("restores existing ini backups during purge", async () => {
+  const tempPath = await nodeFs.mkdtemp(path.join(os.tmpdir(), "vortex-ini-purge-"));
+  try {
+    const iniPath = path.join(tempPath, "Existing.ini");
+    const contents = "[General]\nvalue=restored\n";
+    await nodeFs.writeFile(iniPath + ".base", contents);
+
+    await restoreIniBackup(iniPath);
+
+    await expect(nodeFs.readFile(iniPath, "utf8")).resolves.toBe(contents);
+    await expect(nodeFs.readFile(iniPath + ".baked", "utf8")).resolves.toBe(contents);
+  } finally {
+    await nodeFs.rm(tempPath, { recursive: true, force: true });
+  }
+});
