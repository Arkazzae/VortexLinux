+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+import getNormalizeFunc from "./getNormalizeFunc";
+
+describe("getNormalizeFunc", () => {
+  const temporaryPaths: string[] = [];
+
+  afterEach(() => {
+    temporaryPaths.splice(0).forEach((entry) => fs.rmSync(entry, { force: true, recursive: true }));
+  });
+
+  it("can force Windows case semantics on a case-sensitive host", async () => {
+    const temporary = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-normalize-"));
+    temporaryPaths.push(temporary);
+
+    const normalize = await getNormalizeFunc(path.join(temporary, "missing", "Data"), {
+      caseInsensitive: true,
+    });
+
+    expect(normalize("SFSE/Plugins/Test.dll")).toBe(normalize("sfse/plugins/test.DLL"));
+  });
+});
