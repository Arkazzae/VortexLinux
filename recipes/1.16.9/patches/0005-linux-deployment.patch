+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { copyFileAtomic, writeFileAtomic } from "./fsAtomic";
+
+describe("atomic configuration writes", () => {
+  let directory: string;
+  beforeEach(() => {
+    directory = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-atomic-"));
+  });
+  afterEach(() => fs.rmSync(directory, { recursive: true, force: true }));
+
+  it("preserves the destination and removes temporary files when the copy source is missing", async () => {
+    const destination = path.join(directory, "Settings.ini");
+    fs.writeFileSync(destination, "existing settings");
+
+    await expect(copyFileAtomic(path.join(directory, "missing.ini"), destination))
+      .rejects.toMatchObject({ code: "ENOENT" });
+
+    expect(fs.readFileSync(destination, "utf8")).toBe("existing settings");
+    expect(fs.readdirSync(directory)).toEqual(["Settings.ini"]);
+  });
+
+  it("copies a new configuration without modifying another hardlink to the old destination", async () => {
+    const source = path.join(directory, "new.ini");
+    const destination = path.join(directory, "Settings.ini");
+    const staged = path.join(directory, "staged.ini");
+    fs.writeFileSync(source, "new settings");
+    fs.writeFileSync(staged, "mod settings");
+    fs.linkSync(staged, destination);
+
+    await copyFileAtomic(source, destination);
+
+    expect(fs.readFileSync(destination, "utf8")).toBe("new settings");
+    expect(fs.readFileSync(staged, "utf8")).toBe("mod settings");
+    expect(fs.statSync(destination).ino).not.toBe(fs.statSync(staged).ino);
+    expect(fs.readdirSync(directory).sort()).toEqual(["Settings.ini", "new.ini", "staged.ini"]);
+  });
+
+  it("uses existing filename casing before creating and renaming the temporary file", async () => {
+    const target = path.join(directory, "Config", "Settings.ini");
+    fs.mkdirSync(path.dirname(target));
+    fs.writeFileSync(target, "original");
+
+    await writeFileAtomic(path.join(directory, "config", "settings.ini"), "updated");
+
+    expect(fs.readFileSync(target, "utf8")).toBe("updated");
+    expect(fs.readdirSync(path.dirname(target))).toEqual(["Settings.ini"]);
+  });
+});
