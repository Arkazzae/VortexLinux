+/**
+ * A game added by hand has no store to ask, so it lives where plain Wine runs
+ * everything: $WINEPREFIX, or ~/.wine when that isn't set.
+ */
+function defaultWinePrefix(): string | undefined {
+  const prefix = path.resolve(
+    expandHome(process.env.WINEPREFIX || path.join(os.homedir(), ".wine")),
+  );
+  return fs.existsSync(path.join(prefix, "drive_c")) ? prefix : undefined;
+}
