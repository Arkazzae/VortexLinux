+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import {
+  GetPrivateProfileSection,
+  GetPrivateProfileSectionNames,
+  GetPrivateProfileString,
+  WritePrivateProfileString,
+} from "./linuxIni";
+import { getDiskSpace, getVolumePath } from "./volume";
+
+export {
+  GetPrivateProfileSection,
+  GetPrivateProfileSectionNames,
+  GetPrivateProfileString,
+  WritePrivateProfileString,
+};
+
+function platformError(operation: string, code = "ENOSYS"): NodeJS.ErrnoException {
+  return Object.assign(new Error(`${operation} is not available on this platform`), { code });
+}
+
+export const GetDiskFreeSpaceEx = getDiskSpace;
+export const GetVolumePathName = getVolumePath;
+
+export function GetProcessList() {
+  try {
+    return fs
+      .readdirSync("/proc", { withFileTypes: true })
+      .filter((entry) => entry.isDirectory() && /^\d+$/.test(entry.name))
+      .flatMap((entry) => {
+        const processID = Number(entry.name);
+        try {
+          return [
+            {
+              exeFile: path.win32.basename(processExecutable(processID).replace(/\//g, "\\")),
+              numThreads: 0,
+              parentProcessID: Number(fs.readFileSync(`/proc/${processID}/stat`, "utf8").replace(/^.*\) /, "").split(" ")[1]),
+              priClassBase: 0,
+              processID,
+            },
+          ];
+        } catch {
+          return [];
+        }
+      });
+  } catch {
+    return [];
+  }
+}
+
+function processExecutable(pid: number): string {
+  const executable = fs.readlinkSync(`/proc/${pid}/exe`);
+  const firstArgument = fs.readFileSync(`/proc/${pid}/cmdline`, "utf8").split("\0")[0];
+  return /\.(?:exe|com)$/i.test(firstArgument) ? firstArgument : executable;
+}
+
+export function GetModuleList(pid: number) {
+  try { return [{ exePath: processExecutable(pid) }]; } catch { return []; }
+}
+export const GetProcessWindowList = () => [];
+export const SetForegroundWindow = () => false;
+export const GetTasks = () => [];
+export const CheckYourPrivilege = () => [];
+export const GetUserSID = () => `unix:${process.getuid?.() ?? "unknown"}`;
+export const SupportsAppContainer = () => false;
+export const IsThisWine = () => false;
+export const WhoLocks = () => [];
+export const AbortSystemShutdown = () => false;
+export const InitiateSystemShutdown = () => false;
+
+export const GetNativeArch = () => ({
+  nativeArch: process.arch,
+  nativeMachineCode: 0,
+  usedFallback: true,
+});
+
+export const GetSystemPreferredUILanguages = () => [Intl.DateTimeFormat().resolvedOptions().locale];
+export const GetUserPreferredUILanguages = GetSystemPreferredUILanguages;
+export const GetProcessPreferredUILanguages = GetSystemPreferredUILanguages;
+export const SetProcessPreferredUILanguages = () => undefined;
+
+export function WithRegOpen(_hive: string, _keyPath: string, callback: (key: Buffer) => void) {
+  callback(Buffer.alloc(0));
+}
+
+export const RegEnumKeys = (_key?: Buffer) => [];
+export const RegEnumValues = (_key?: Buffer) => [];
+
+export function RegGetValue(): never {
+  throw platformError("Registry lookup", "ENOENT");
+}
+
+export function RegSetKeyValue(): never {
+  throw platformError("Registry update");
+}
+
+export function ShellExecuteEx(): never {
+  throw platformError("ShellExecuteEx");
+}
+
+export function RunTask(): never {
+  throw platformError("RunTask");
+}
+
+const linuxWinapi = {
+  GetPrivateProfileSection,
+  GetPrivateProfileSectionNames,
+  GetPrivateProfileString,
+  WritePrivateProfileString,
+  AbortSystemShutdown,
+  CheckYourPrivilege,
+  GetDiskFreeSpaceEx,
+  GetModuleList,
+  GetNativeArch,
+  GetProcessList,
+  GetProcessPreferredUILanguages,
+  GetProcessWindowList,
+  GetSystemPreferredUILanguages,
+  GetTasks,
+  GetUserPreferredUILanguages,
+  GetUserSID,
+  GetVolumePathName,
+  InitiateSystemShutdown,
+  IsThisWine,
+  RegEnumKeys,
+  RegEnumValues,
+  RegGetValue,
+  RegSetKeyValue,
+  RunTask,
+  SetForegroundWindow,
+  SetProcessPreferredUILanguages,
+  ShellExecuteEx,
+  SupportsAppContainer,
+  WhoLocks,
+  WithRegOpen,
+};
+
+export default linuxWinapi;
