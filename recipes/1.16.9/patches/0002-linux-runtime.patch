@@ -0,0 +1,153 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { resetCompatibilityPathCache, resolveWindowsUserPathSync } from "./compatibilityPaths";
+
+const tempDirPlaceholder = "__TEMP_DIR__";
+
+describe.runIf(process.platform === "linux")("compatibility profile paths", () => {
+  let tempDir: string;
+  let oldAppData: string | undefined;
+  let oldDocuments: string | undefined;
+  let oldPrefixes: string | undefined;
+  let oldSavedGames: string | undefined;
+
+  beforeEach(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-prefixes-"));
+    oldAppData = process.env.VORTEX_LINUX_APPDATA;
+    oldDocuments = process.env.VORTEX_LINUX_DOCUMENTS;
+    oldPrefixes = process.env.VORTEX_COMPAT_PREFIXES;
+    oldSavedGames = process.env.VORTEX_LINUX_SAVED_GAMES;
+    process.env.VORTEX_LINUX_APPDATA = path.join(tempDir, ".config");
+    process.env.VORTEX_LINUX_DOCUMENTS = path.join(tempDir, "Documents");
+    process.env.VORTEX_COMPAT_PREFIXES = path.join(tempDir, "prefix");
+    process.env.VORTEX_LINUX_SAVED_GAMES = path.join(tempDir, "Saved Games");
+    resetCompatibilityPathCache();
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { force: true, recursive: true });
+    restoreEnvironment("VORTEX_LINUX_APPDATA", oldAppData);
+    restoreEnvironment("VORTEX_LINUX_DOCUMENTS", oldDocuments);
+    restoreEnvironment("VORTEX_COMPAT_PREFIXES", oldPrefixes);
+    restoreEnvironment("VORTEX_LINUX_SAVED_GAMES", oldSavedGames);
+    resetCompatibilityPathCache();
+  });
+
+  it("maps a Windows Documents path into an arbitrary compatibility prefix", () => {
+    const actualDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "Documents",
+      "My Games",
+      "Example",
+    );
+    fs.mkdirSync(actualDirectory, { recursive: true });
+    fs.writeFileSync(path.join(actualDirectory, "Settings.ini"), "");
+
+    const requested = path.join(
+      process.env.VORTEX_LINUX_DOCUMENTS,
+      "my games",
+      "example",
+      "settings.ini",
+    );
+    expect(resolveWindowsUserPathSync(requested)).toBe(path.join(actualDirectory, "Settings.ini"));
+  });
+
+  it("maps a not-yet-created file when its destination directory exists", () => {
+    const actualDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "Documents",
+      "My Games",
+      "Example",
+    );
+    fs.mkdirSync(actualDirectory, { recursive: true });
+
+    const requested = path.join(
+      process.env.VORTEX_LINUX_DOCUMENTS,
+      "My Games",
+      "Example",
+      "NewSettings.ini",
+    );
+    expect(resolveWindowsUserPathSync(requested)).toBe(
+      path.join(actualDirectory, "NewSettings.ini"),
+    );
+  });
+
+  it.each([
+    ["Roaming", path.join(tempDirPlaceholder, ".config"), ["AppData", "Roaming"]],
+    ["Local", path.join(tempDirPlaceholder, "Local"), ["AppData", "Local"]],
+    ["LocalLow", path.join(tempDirPlaceholder, "LocalLow"), ["AppData", "LocalLow"]],
+    ["Saved Games", path.join(tempDirPlaceholder, "Saved Games"), ["Saved Games"]],
+  ])("maps %s data into its matching compatibility profile", (_name, linuxRoot, winRoot) => {
+    linuxRoot = linuxRoot.replace(tempDirPlaceholder, tempDir);
+    const actualDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      ...winRoot,
+      "Example Game",
+    );
+    fs.mkdirSync(actualDirectory, { recursive: true });
+    fs.writeFileSync(path.join(actualDirectory, "Settings.ini"), "");
+
+    const requested = path.join(linuxRoot, "Example Game", "Settings.ini");
+    expect(resolveWindowsUserPathSync(requested)).toBe(path.join(actualDirectory, "Settings.ini"));
+  });
+
+  it("does not remap Vortex userData into a leftover Wine prefix", () => {
+    const prefixStaging = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "AppData",
+      "Roaming",
+      "Vortex",
+      "cyberpunk2077",
+      "mods",
+    );
+    fs.mkdirSync(prefixStaging, { recursive: true });
+    fs.writeFileSync(path.join(prefixStaging, "stale.txt"), "prefix");
+
+    const stagingFile = path.join(
+      process.env.VORTEX_LINUX_APPDATA!,
+      "Vortex",
+      "cyberpunk2077",
+      "mods",
+      "redscript-mod",
+      "r6",
+      "scripts",
+      "NoIntroVideos.reds",
+    );
+    expect(resolveWindowsUserPathSync(stagingFile)).toBe(stagingFile);
+  });
+
+  it("leaves unrelated and unmatched paths unchanged", () => {
+    const unrelated = path.join(tempDir, "Downloads", "archive.zip");
+    const unmatched = path.join(process.env.VORTEX_LINUX_DOCUMENTS, "Unknown", "file.ini");
+    expect(resolveWindowsUserPathSync(unrelated)).toBe(unrelated);
+    expect(resolveWindowsUserPathSync(unmatched)).toBe(unmatched);
+  });
+});
+
+function restoreEnvironment(key: string, value: string | undefined) {
+  if (value === undefined) {
+    delete process.env[key];
+  } else {
+    process.env[key] = value;
+  }
+}
