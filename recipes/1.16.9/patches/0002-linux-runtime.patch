+import * as fs from "node:fs";
+
+import { resolveCaseInsensitiveSync } from "./linuxCompatibility";
+
+interface IniDocument {
+  filePath: string;
+  text: string;
+  encoding: BufferEncoding;
+  bom: Buffer;
+}
+
+function readDocument(input: string): IniDocument {
+  const filePath = resolveCaseInsensitiveSync(input);
+  let bytes: Buffer;
+  try {
+    bytes = fs.readFileSync(filePath);
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code !== "ENOENT") throw err;
+    bytes = Buffer.alloc(0);
+  }
+  const utf16 = bytes[0] === 0xff && bytes[1] === 0xfe;
+  const utf8Bom = bytes[0] === 0xef && bytes[1] === 0xbb && bytes[2] === 0xbf;
+  const bom = bytes.subarray(0, utf16 ? 2 : utf8Bom ? 3 : 0);
+  const body = bytes.subarray(bom.length);
+  const encoding = utf16
+    ? "utf16le"
+    : Buffer.from(body.toString("utf8")).equals(body)
+      ? "utf8"
+      : "latin1";
+  return { filePath, text: body.toString(encoding), encoding, bom };
+}
+
+function sectionName(line: string): string | undefined {
+  return /^\s*\[([^\]]+)\]\s*$/.exec(line)?.[1].trim();
+}
+
+function entry(line: string): { key: string; value: string } | undefined {
+  const match = /^\s*([^;#=\s][^=]*?)\s*=\s*(.*?)\s*$/.exec(line);
+  return match === null ? undefined : { key: match[1], value: match[2] };
+}
+
+function sectionBounds(lines: string[], section: string): [number, number] | undefined {
+  const start = lines.findIndex(
+    (line) => sectionName(line)?.toLowerCase() === section.toLowerCase(),
+  );
+  if (start === -1) return undefined;
+  let end = start + 1;
+  while (end < lines.length && sectionName(lines[end]) === undefined) end += 1;
+  return [start, end];
+}
+
+export function GetPrivateProfileSectionNames(filePath: string): string[] {
+  const names = new Map<string, string>();
+  for (const line of readDocument(filePath).text.split(/\r\n|\n|\r/)) {
+    const name = sectionName(line);
+    if (name !== undefined && !names.has(name.toLowerCase())) names.set(name.toLowerCase(), name);
+  }
+  return [...names.values()];
+}
+
+export function GetPrivateProfileSection(
+  section: string,
+  filePath: string,
+): Record<string, string> {
+  const lines = readDocument(filePath).text.split(/\r\n|\n|\r/);
+  const bounds = sectionBounds(lines, section);
+  const result: Record<string, string> = Object.create(null);
+  const keys = new Set<string>();
+  if (bounds === undefined) return result;
+  for (const line of lines.slice(bounds[0] + 1, bounds[1])) {
+    const item = entry(line);
+    if (item !== undefined && !keys.has(item.key.toLowerCase())) {
+      result[item.key] = item.value;
+      keys.add(item.key.toLowerCase());
+    }
+  }
+  return result;
+}
+
+export function GetPrivateProfileString(
+  section: string,
+  key: string,
+  fallback: string,
+  filePath: string,
+): string[] {
+  const values = GetPrivateProfileSection(section, filePath);
+  const actual = Object.keys(values).find((name) => name.toLowerCase() === key.toLowerCase());
+  const value = actual === undefined ? fallback : values[actual];
+  return [value.replace(/^(["'])(.*)\1$/, "$2")];
+}
+
+export function WritePrivateProfileString(
+  section: string,
+  key: string | null,
+  value: string | null | undefined,
+  input: string,
+): void {
+  if (
+    /[\r\n\0\[\]]/.test(section) ||
+    (key !== null && /[\r\n\0=]/.test(key)) ||
+    /[\r\n\0]/.test(value ?? "")
+  ) {
+    throw new Error("INI names and values must fit on one line");
+  }
+  const document = readDocument(input);
+  const eol = /\r\n|\n|\r/.exec(document.text)?.[0] ?? "\r\n";
+  const lines = document.text === "" ? [] : document.text.split(/\r\n|\n|\r/);
+  const bounds = sectionBounds(lines, section);
+  const deleting = value === null || value === undefined || key === null;
+  if (bounds === undefined) {
+    if (deleting) return;
+    if (lines.length > 0 && lines.at(-1) !== "") lines.push("");
+    lines.push(`[${section}]`, `${key}=${value}`, "");
+  } else if (key === null) {
+    lines.splice(bounds[0], bounds[1] - bounds[0]);
+  } else {
+    const matches: number[] = [];
+    for (let i = bounds[0] + 1; i < bounds[1]; i += 1) {
+      if (entry(lines[i])?.key.toLowerCase() === key.toLowerCase()) matches.push(i);
+    }
+    if (matches.length > 0) {
+      for (const index of matches.slice().reverse()) {
+        if (deleting || index !== matches[0]) lines.splice(index, 1);
+        else lines[index] = lines[index].replace(/=.*/, () => `=${value}`);
+      }
+    } else if (!deleting) {
+      let insert = bounds[1];
+      while (insert > bounds[0] + 1 && lines[insert - 1] === "") insert -= 1;
+      lines.splice(insert, 0, `${key}=${value}`);
+    } else return;
+  }
+  const text = lines.join(eol);
+  const body = Buffer.from(text, document.encoding);
+  if (body.toString(document.encoding) !== text)
+    throw new Error("INI value cannot be represented in the file's encoding");
+  // Keep symlinks and hardlinks intact when updating a deployed configuration.
+  fs.writeFileSync(document.filePath, Buffer.concat([document.bom, body]));
+}
