new file mode 100644
index 0000000..f4d5dc6
--- /dev/null
+++ b/src/util/compatibilityPaths.ts
@@ -0,0 +1,356 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { canonicalPath, findSteamInstallation, steamLibraries } from "./linux/steamLibraries";
+
+interface ICandidate {
+  existingParts: number;
+  path: string;
+}
+
+export interface CompatibilityGame {
+  path?: string;
+  store?: string;
+  executable?: string;
+  environment?: Record<string, string>;
+}
+
+type PrefixResolver = (game: CompatibilityGame) => string | null | undefined;
+let gameProvider: (() => CompatibilityGame | undefined) | undefined;
+let selectedPrefixCache:
+  | { key: string; prefix: string | null | undefined; expires: number }
+  | undefined;
+// A missing prefix usually appears after the game's first launch, so retry it
+// periodically instead of rescanning Steam manifests for every file operation.
+const MISSING_PREFIX_RETRY_MS = 10_000;
+const storeResolvers = new Map<string, PrefixResolver>();
+
+export function setCompatibilityGameProvider(provider: typeof gameProvider): void {
+  gameProvider = provider;
+  resetCompatibilityPathCache();
+}
+
+export function registerCompatibilityStore(store: string, resolver: PrefixResolver): void {
+  storeResolvers.set(store, resolver);
+  resetCompatibilityPathCache();
+}
+
+export function getCompatibilityGame(): CompatibilityGame | undefined {
+  return gameProvider?.();
+}
+
+export function selectedGamePrefix(game = gameProvider?.()): string | null | undefined {
+  if (game === undefined) return undefined;
+  const key = JSON.stringify([
+    game.path,
+    game.store,
+    game.executable,
+    game.environment?.WINEPREFIX,
+  ]);
+  if (selectedPrefixCache?.key === key && Date.now() < selectedPrefixCache.expires) {
+    return selectedPrefixCache.prefix;
+  }
+  const prefix = resolveGamePrefix(game);
+  selectedPrefixCache = {
+    key,
+    prefix,
+    expires: prefix === undefined ? Date.now() + MISSING_PREFIX_RETRY_MS : Infinity,
+  };
+  return prefix;
+}
+
+function resolveGamePrefix(game: CompatibilityGame): string | null | undefined {
+  if (game.environment?.WINEPREFIX) return path.resolve(expandHome(game.environment.WINEPREFIX));
+  if (game.path === undefined) return null;
+  if (game.executable) {
+    if (/\.(?:sh|x86_64|x86)$/i.test(game.executable)) return null;
+    let fd: number | undefined;
+    try {
+      fd = fs.openSync(path.resolve(game.path, game.executable), "r");
+      const header = Buffer.alloc(4);
+      fs.readSync(fd, header, 0, 4, 0);
+      if (header.equals(Buffer.from([0x7f, 0x45, 0x4c, 0x46]))) return null;
+    } catch {
+      /* The game may have been moved or uninstalled. */
+    } finally {
+      if (fd !== undefined) fs.closeSync(fd);
+    }
+  }
+  const custom = storeResolvers.get(game.store ?? "");
+  if (custom !== undefined) return custom(game);
+  if (game.store === "steam") {
+    const installation = findSteamInstallation(game.path);
+    if (installation !== undefined) {
+      return installation.prefix;
+    }
+  }
+  return undefined;
+}
+
+interface IUserPathMapping {
+  linuxRoot: string;
+  windowsRoot: string[];
+  /** Only games use this root; Linux applications do not store files there. */
+  gameData: boolean;
+}
+
+let cachedPrefixKey: string | undefined;
+let cachedPrefixes: string[] = [];
+
+function expandHome(input: string): string {
+  return input.replace(/^\$HOME(?=\/|$)/, os.homedir());
+}
+
+function xdgDocumentsPath(): string {
+  if (process.env.VORTEX_LINUX_DOCUMENTS !== undefined) {
+    return process.env.VORTEX_LINUX_DOCUMENTS;
+  }
+
+  try {
+    const config = fs.readFileSync(
+      path.join(
+        process.env.XDG_CONFIG_HOME ?? path.join(os.homedir(), ".config"),
+        "user-dirs.dirs",
+      ),
+      "utf8",
+    );
+    const match = config.match(/^XDG_DOCUMENTS_DIR=(?:"([^"]*)"|'([^']*)'|([^\n]*))$/m);
+    const value = match?.[1] ?? match?.[2] ?? match?.[3];
+    if (value !== undefined && value.length > 0) {
+      return path.normalize(expandHome(value));
+    }
+  } catch {
+    // Fall back to the freedesktop default below.
+  }
+
+  return path.join(os.homedir(), "Documents");
+}
+
+function linuxAppDataPath(): string {
+  return (
+    process.env.VORTEX_LINUX_APPDATA ??
+    process.env.XDG_CONFIG_HOME ??
+    path.join(os.homedir(), ".config")
+  );
+}
+
+/**
+ * Electron stores Vortex itself under {appData}/Vortex. That directory must
+ * stay on the Linux filesystem; leftover Wine copies of %APPDATA%\\Vortex
+ * in Steam prefixes are not a substitute for staging, downloads, or state.
+ */
+function vortexUserDataPath(): string {
+  return process.env.VORTEX_USERDATA ?? path.join(linuxAppDataPath(), "Vortex");
+}
+
+function isPathInside(root: string, candidate: string): boolean {
+  const relative = path.relative(path.resolve(root), path.resolve(candidate));
+  return (
+    relative === "" ||
+    (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
+  );
+}
+
+function linuxUserPathMappings(): IUserPathMapping[] {
+  const appData = linuxAppDataPath();
+  const localAppData =
+    process.env.VORTEX_LINUX_LOCAL_APPDATA ?? path.resolve(appData, "..", "Local");
+  const localLow = process.env.VORTEX_LINUX_LOCAL_LOW ?? path.resolve(appData, "..", "LocalLow");
+  const savedGames = process.env.VORTEX_LINUX_SAVED_GAMES ?? path.join(os.homedir(), "Saved Games");
+
+  return [
+    { linuxRoot: xdgDocumentsPath(), windowsRoot: ["Documents"], gameData: false },
+    { linuxRoot: appData, windowsRoot: ["AppData", "Roaming"], gameData: false },
+    { linuxRoot: localAppData, windowsRoot: ["AppData", "Local"], gameData: true },
+    { linuxRoot: localLow, windowsRoot: ["AppData", "LocalLow"], gameData: true },
+    { linuxRoot: savedGames, windowsRoot: ["Saved Games"], gameData: true },
+  ];
+}
+
+function findSteamPrefixes(): string[] {
+  return steamLibraries().flatMap((library) => {
+    const compatData = path.join(library, "steamapps", "compatdata");
+    try {
+      return fs
+        .readdirSync(compatData, { withFileTypes: true })
+        .filter((entry) => entry.isDirectory())
+        .map((entry) => path.join(compatData, entry.name, "pfx"))
+        .filter(fs.existsSync);
+    } catch {
+      return [];
+    }
+  });
+}
+
+/**
+ * Returns undefined when the selected game needs a prefix that does not exist
+ * yet, so callers can refuse to place its data on the Linux side instead.
+ */
+function compatibilityPrefixes(): string[] | undefined {
+  const game = gameProvider?.();
+  if (game !== undefined) {
+    const prefix = selectedGamePrefix(game);
+    if (prefix === null) return [];
+    if (prefix === undefined || !fs.existsSync(path.join(prefix, "drive_c", "users"))) {
+      return undefined;
+    }
+    return [prefix];
+  }
+  const configured = process.env.VORTEX_COMPAT_PREFIXES ?? "";
+  const cacheKey = `${os.homedir()}\0${configured}`;
+  if (cacheKey === cachedPrefixKey) {
+    return cachedPrefixes;
+  }
+
+  const explicit = configured
+    .split(path.delimiter)
+    .filter(Boolean)
+    .map((entry) => path.resolve(expandHome(entry)));
+  cachedPrefixes = [...new Set([...explicit, ...findSteamPrefixes()].map(canonicalPath))];
+  cachedPrefixKey = cacheKey;
+  return cachedPrefixes;
+}
+
+function currentUserName(): string | undefined {
+  try {
+    return os.userInfo().username.toLowerCase();
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Proton always runs as steamuser and plain Wine as the current user. A prefix
+ * can still contain another profile, for example after a tool ran through plain
+ * Wine in a Proton prefix, so choose the profile the game itself uses.
+ */
+function prefixUsers(users: string[]): string[] {
+  const find = (name: string | undefined) =>
+    users.find((user) => name !== undefined && user.toLowerCase() === name);
+  const selected = find("steamuser") ?? find(currentUserName());
+  return selected !== undefined ? [selected] : users;
+}
+
+function windowsUserRoots(prefixes: string[], relativeRoot: string[]): string[] {
+  return prefixes.flatMap((prefix) => {
+    const users = path.join(prefix, "drive_c", "users");
+    try {
+      const profiles = fs
+        .readdirSync(users, { withFileTypes: true })
+        .filter(
+          (entry) =>
+            entry.isDirectory() &&
+            !["public", "default", "default user", "all users"].includes(entry.name.toLowerCase()),
+        )
+        .map((entry) => entry.name);
+      return prefixUsers(profiles)
+        .map((user) => path.join(users, user, ...relativeRoot))
+        .filter(fs.existsSync);
+    } catch {
+      return [];
+    }
+  });
+}
+
+function resolveCandidate(
+  root: string,
+  relative: string,
+  minimumExistingParts: number,
+): ICandidate | undefined {
+  const parts = relative.split(path.sep).filter(Boolean);
+  let current = root;
+  let existingParts = 0;
+
+  try {
+    for (const [index, part] of parts.entries()) {
+      const exact = path.join(current, part);
+      if (fs.existsSync(exact)) {
+        current = exact;
+        existingParts += 1;
+        continue;
+      }
+
+      const match = fs
+        .readdirSync(current)
+        .find((entry) => entry.toLowerCase() === part.toLowerCase());
+      if (match === undefined) {
+        current = path.join(current, ...parts.slice(index));
+        break;
+      }
+      current = path.join(current, match);
+      existingParts += 1;
+    }
+
+    if (existingParts < minimumExistingParts) {
+      return undefined;
+    }
+    return {
+      existingParts,
+      path: current,
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+export function resolveSelectedWindowsUserPathSync(input: string): string {
+  return gameProvider?.() === undefined ? input : resolveWindowsUserPathSync(input);
+}
+
+export function resolveWindowsUserPathSync(input: string): string {
+  if (process.platform !== "linux" || !path.isAbsolute(input)) {
+    return input;
+  }
+
+  if (isPathInside(vortexUserDataPath(), input)) {
+    return input;
+  }
+
+  const selected = gameProvider?.() !== undefined;
+  let prefixes: string[] | undefined;
+  const candidates = linuxUserPathMappings()
+    .flatMap((mapping) => {
+      const relative = path.relative(mapping.linuxRoot, input);
+      if (relative.startsWith("..") || path.isAbsolute(relative) || relative.length === 0) {
+        return [];
+      }
+      const myGames = relative.split(path.sep)[0].toLowerCase() === "my games";
+      const gameData = mapping.gameData || myGames;
+      prefixes ??= compatibilityPrefixes();
+      if (prefixes === undefined) {
+        if (!gameData) return [];
+        throw Object.assign(
+          new Error(
+            "The selected game's Wine/Proton prefix is unavailable. Launch the game once, or configure its WINEPREFIX.",
+          ),
+          { code: "ENOENT" },
+        );
+      }
+      // The selected game's own data belongs in its prefix even before the game
+      // creates it. Other paths are redirected only when the prefix already has
+      // them, so Linux files in Documents or ~/.config stay where they are.
+      const minimumExistingParts = selected && gameData ? 0 : myGames ? 2 : 1;
+      return windowsUserRoots(prefixes, mapping.windowsRoot).map((root) =>
+        resolveCandidate(root, relative, minimumExistingParts),
+      );
+    })
+    .filter((candidate): candidate is ICandidate => candidate !== undefined);
+
+  const destinations = [...new Set(candidates.map((candidate) => canonicalPath(candidate.path)))];
+  if (destinations.length > 1) {
+    throw Object.assign(
+      new Error(
+        "Several compatibility prefixes contain this game data. Select the game's installation or configure its WINEPREFIX.",
+      ),
+      { code: "EAMBIGUOUS" },
+    );
+  }
+  return candidates[0]?.path ?? input;
+}
+
+export function resetCompatibilityPathCache() {
+  cachedPrefixKey = undefined;
+  cachedPrefixes = [];
+  selectedPrefixCache = undefined;
+}
