+  it("normalizes mixed separators before resolving a path", () => {
+    const patched = linuxPath();
+    patchPathCompatibility(patched, "linux");
+
+    expect(patched.resolve("/games/Cyberpunk 2077", "r6\\cache/../scripts")).toBe(
+      "/games/Cyberpunk 2077/r6/scripts",
+    );
+  });
+
+  it("normalizes explicit win32 layout identifiers for native comparisons", () => {
+    const explicitWin32 = windowsNormalize();
+    const native = linuxPath();
+    patchWin32NormalizeCompatibility(explicitWin32, native, "linux");
+
+    expect(explicitWin32.normalize("bin/x64/plugins/cyber_engine_tweaks.asi")).toBe(
+      "bin/x64/plugins/cyber_engine_tweaks.asi",
