diff --git a/src/util/linux/steamLibraries.ts b/src/util/linux/steamLibraries.ts
new file mode 100644
index 0000000..4b832f0
--- /dev/null
+++ b/src/util/linux/steamLibraries.ts
@@ -0,0 +1,94 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { parse } from "simple-vdf";
+
+export function steamRoots(home = os.homedir()): string[] {
+  return [
+    path.join(process.env.XDG_DATA_HOME ?? path.join(home, ".local", "share"), "Steam"),
+    path.join(home, ".steam", "debian-installation"),
+    path.join(home, ".var", "app", "com.valvesoftware.Steam", "data", "Steam"),
+    path.join(home, ".var", "app", "com.valvesoftware.Steam", ".local", "share", "Steam"),
+    path.join(home, "snap", "steam", "common", ".local", "share", "Steam"),
+    path.join(home, ".steam", "steam"),
+  ];
+}
+
+export function canonicalPath(input: string): string {
+  try {
+    return fs.realpathSync(input);
+  } catch {
+    return path.resolve(input);
+  }
+}
+
+export function steamLibraries(roots = steamRoots()): string[] {
+  const libraries = new Set<string>();
+  for (const root of roots) {
+    if (fs.existsSync(root)) libraries.add(canonicalPath(root));
+    for (const directory of ["steamapps", "config"]) {
+      try {
+        const data = parse(
+          fs.readFileSync(path.join(root, directory, "libraryfolders.vdf"), "utf8"),
+        ) as any;
+        for (const library of Object.values(
+          data.libraryfolders ?? data.LibraryFolders ?? {},
+        ) as any[]) {
+          const location = typeof library === "string" ? library : library?.path;
+          if (typeof location === "string" && path.isAbsolute(location))
+            libraries.add(canonicalPath(location));
+        }
+      } catch {
+        /* Steam may be absent or still writing its manifest. */
+      }
+    }
+  }
+  return [...libraries];
+}
+
+export interface SteamInstallation {
+  appId: string;
+  gamePath: string;
+  steamAppsPath: string;
+  prefix: string;
+}
+
+export function findSteamInstallation(gamePath: string): SteamInstallation | undefined {
+  const target = canonicalPath(gamePath);
+  // Include the selected library even when Steam lives at a custom location.
+  const common = path.dirname(target);
+  const selectedRoot =
+    path.basename(common) === "common" && path.basename(path.dirname(common)) === "steamapps"
+      ? path.dirname(path.dirname(common))
+      : undefined;
+  const libraries = new Set([...steamLibraries(), ...(selectedRoot ? [selectedRoot] : [])]);
+  for (const library of libraries) {
+    const steamAppsPath = path.join(library, "steamapps");
+    let names: string[];
+    try {
+      names = fs.readdirSync(steamAppsPath);
+    } catch {
+      continue;
+    }
+    for (const name of names.filter((entry) => /^appmanifest_\d+\.acf$/.test(entry))) {
+      try {
+        const manifest = (parse(fs.readFileSync(path.join(steamAppsPath, name), "utf8")) as any)
+          .AppState;
+        const appId = String(manifest?.appid ?? "");
+        if (!/^\d+$/.test(appId) || typeof manifest?.installdir !== "string") continue;
+        const installed = canonicalPath(path.join(steamAppsPath, "common", manifest.installdir));
+        if (installed === target)
+          return {
+            appId,
+            gamePath: installed,
+            steamAppsPath,
+            prefix: path.join(steamAppsPath, "compatdata", appId, "pfx"),
+          };
+      } catch {
+        /* Ignore incomplete manifests. */
+      }
+    }
+  }
+  return undefined;
+}
