+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import linuxWinapi from "./linuxWinapi";
+
+describe.runIf(process.platform === "linux")("Linux winapi compatibility", () => {
+  let tempDir: string;
+
+  beforeEach(() => {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-winapi-"));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tempDir, { force: true, recursive: true });
+  });
+
+  it("provides portable volume and process information", () => {
+    expect(linuxWinapi.GetVolumePathName(tempDir)).not.toBe("");
+    expect(linuxWinapi.GetDiskFreeSpaceEx(tempDir).freeToCaller).toBeGreaterThan(0);
+    expect(linuxWinapi.GetProcessList().some((entry) => entry.processID === process.pid)).toBe(
+      true,
+    );
+  });
+
+  it("reports the executable path and parent of the current Linux process", () => {
+    const executable = fs.readlinkSync(`/proc/${process.pid}/exe`);
+    expect(linuxWinapi.GetModuleList(process.pid)).toEqual([{ exePath: executable }]);
+    expect(linuxWinapi.GetProcessList().find((entry) => entry.processID === process.pid))
+      .toMatchObject({ exeFile: path.basename(executable), parentProcessID: process.ppid });
+  });
+
+  it("represents the unavailable registry as an empty key tree", () => {
+    const callback = vi.fn((key: Buffer) => {
+      expect(linuxWinapi.RegEnumKeys(key)).toEqual([]);
+      expect(linuxWinapi.RegEnumValues(key)).toEqual([]);
+    });
+
+    linuxWinapi.WithRegOpen("HKEY_CURRENT_USER", "Software", callback);
+    expect(callback).toHaveBeenCalledOnce();
+    expect(() => linuxWinapi.RegGetValue()).toThrow(/not available/);
+  });
+
+  it("reports unsupported isolation without throwing", () => {
+    expect(linuxWinapi.SupportsAppContainer()).toBe(false);
+    expect(linuxWinapi.GetTasks()).toEqual([]);
+    expect(linuxWinapi.GetProcessWindowList()).toEqual([]);
+  });
+});
