@@ -0,0 +1,197 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  resetCompatibilityPathCache,
+  resolveWindowsUserPathSync,
+  setCompatibilityGameProvider,
+} from "./compatibilityPaths";
+import { findSteamInstallation, steamLibraries, steamRoots } from "./linux/steamLibraries";
+import { resolveCaseInsensitiveSync } from "./linuxCompatibility";
+
+vi.mock("node:os", async (original) => ({
+  ...(await original<typeof os>()),
+  homedir: vi.fn(),
+}));
+
+describe.runIf(process.platform === "linux")("selected compatibility prefix", () => {
+  let home: string;
+  let documents: string;
+  const relative = "My Games/Example/settings.ini";
+  function fixture(prefix: string): string {
+    const file = path.join(prefix, "drive_c/users/steamuser/Documents", relative);
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, "[General]\n");
+    return file;
+  }
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-selected-prefix-"));
+    documents = path.join(home, "Documents");
+    vi.mocked(os.homedir).mockReturnValue(home);
+    vi.stubEnv("XDG_DATA_HOME", path.join(home, ".local/share"));
+    vi.stubEnv("VORTEX_LINUX_DOCUMENTS", documents);
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", "");
+    setCompatibilityGameProvider(undefined);
+  });
+  it("creates new game configuration directories inside the selected prefix", () => {
+    const prefix = path.join(home, "new-prefix");
+    const userDocuments = path.join(prefix, "drive_c/users/steamuser/Documents");
+    fs.mkdirSync(userDocuments, { recursive: true });
+    fs.mkdirSync(path.join(prefix, "drive_c/users/Public/Documents"), { recursive: true });
+    setCompatibilityGameProvider(() => ({ path: home, environment: { WINEPREFIX: prefix } }));
+    const destination = resolveCaseInsensitiveSync(path.join(documents, relative));
+    expect(destination).toBe(path.join(userDocuments, relative));
+    fs.mkdirSync(path.dirname(destination), { recursive: true });
+    fs.writeFileSync(destination, "fixture");
+    expect(fs.existsSync(path.join(documents, relative))).toBe(false);
+  });
+
+  it("keeps Linux files outside the selected prefix unless the prefix already has them", () => {
+    const prefix = path.join(home, "prefix");
+    const userDocuments = path.join(prefix, "drive_c/users/steamuser/Documents");
+    fs.mkdirSync(path.join(userDocuments, "Shared"), { recursive: true });
+    fs.mkdirSync(path.join(prefix, "drive_c/users/steamuser/AppData/Roaming"), { recursive: true });
+    vi.stubEnv("VORTEX_LINUX_APPDATA", path.join(home, ".config"));
+    const archive = path.join(documents, "Mods/archive.7z");
+    fs.mkdirSync(path.dirname(archive), { recursive: true });
+    fs.writeFileSync(archive, "archive");
+    const settings = path.join(home, ".config/someapp/settings.json");
+    fs.mkdirSync(path.dirname(settings), { recursive: true });
+    fs.writeFileSync(settings, "{}");
+    setCompatibilityGameProvider(() => ({ path: home, environment: { WINEPREFIX: prefix } }));
+    expect(resolveCaseInsensitiveSync(archive)).toBe(archive);
+    expect(resolveCaseInsensitiveSync(path.join(documents, "Mods/new.7z.tmp"))).toBe(
+      path.join(documents, "Mods/new.7z.tmp"),
+    );
+    expect(resolveCaseInsensitiveSync(settings)).toBe(settings);
+    expect(resolveCaseInsensitiveSync(path.join(documents, "shared/file.txt"))).toBe(
+      path.join(userDocuments, "Shared/file.txt"),
+    );
+  });
+
+  it("uses Proton's steamuser profile when a prefix also has a Wine user profile", () => {
+    const prefix = path.join(home, "prefix");
+    const expected = fixture(prefix);
+    fs.mkdirSync(path.join(prefix, "drive_c/users", os.userInfo().username, "Documents/My Games"), {
+      recursive: true,
+    });
+    setCompatibilityGameProvider(() => ({ path: home, environment: { WINEPREFIX: prefix } }));
+    expect(resolveCaseInsensitiveSync(path.join(documents, relative))).toBe(expected);
+    expect(resolveCaseInsensitiveSync(path.join(documents, "My Games/New/new.ini"))).toBe(
+      path.join(prefix, "drive_c/users/steamuser/Documents/My Games/New/new.ini"),
+    );
+  });
+
+  it("only refuses game data while the selected prefix is missing", () => {
+    setCompatibilityGameProvider(() => ({
+      environment: { WINEPREFIX: path.join(home, "missing") },
+    }));
+    const archive = path.join(documents, "Mods/archive.7z");
+    expect(resolveCaseInsensitiveSync(archive)).toBe(archive);
+    expect(() => resolveWindowsUserPathSync(path.join(home, "Saved Games/Example/save"))).toThrow(
+      /unavailable/,
+    );
+  });
+
+  afterEach(() => {
