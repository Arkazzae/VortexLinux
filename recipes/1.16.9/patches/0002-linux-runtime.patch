+import * as fs from "fs";
+import * as os from "os";
+import * as path from "path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { resolveNativeExecutable, resolvePlatformPath } from "./nativeExecutable";
+
+describe("native executable resolution", () => {
+  let root: string;
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-native-executable-"));
+  });
+
+  afterEach(() => {
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  function executable(relativePath: string): void {
+    const target = path.join(root, relativePath);
+    fs.mkdirSync(path.dirname(target), { recursive: true });
+    fs.writeFileSync(target, "#!/bin/sh\n");
+    fs.chmodSync(target, 0o755);
+  }
+
+  it("keeps an existing declared executable", () => {
+    executable("bin/sample.exe");
+    executable("bin/sample");
+
+    expect(resolveNativeExecutable(root, "bin/sample.exe", "linux")).toBe("bin/sample.exe");
+  });
+
+  it("finds an executable with the same stem", () => {
+    executable("bin/sample");
+
+    expect(resolveNativeExecutable(root, "bin/sample.exe", "linux")).toBe("bin/sample");
+  });
+
+  it("matches a native executable to a decorated Windows variant", () => {
+    executable("bin/sample");
+    executable("bin/unrelated");
+
+    expect(resolveNativeExecutable(root, "bin/sample_render.exe", "linux")).toBe("bin/sample");
+  });
+
+  it("does not return a non-executable or unrelated file", () => {
+    fs.mkdirSync(path.join(root, "bin"), { recursive: true });
+    fs.writeFileSync(path.join(root, "bin", "sample"), "data");
+    executable("bin/different");
+
+    expect(resolveNativeExecutable(root, "bin/sample_render.exe", "linux")).toBe(
+      "bin/sample_render.exe",
+    );
+  });
+
+  it("does not alter declarations on other platforms", () => {
+    executable("bin/sample");
+
+    expect(resolveNativeExecutable(root, "bin/sample.exe", "win32")).toBe("bin/sample.exe");
+  });
+
+  it("returns an absolute platform path for validation", () => {
+    executable("bin/sample");
+
+    expect(resolvePlatformPath(root, "bin/sample.exe", "linux")).toBe(
+      path.join(root, "bin", "sample"),
+    );
+  });
+});
diff --git a/src/util/nativeExecutable.ts b/src/util/nativeExecutable.ts
new file mode 100644
index 0000000..ac03b41
--- /dev/null
+++ b/src/util/nativeExecutable.ts
@@ -0,0 +1,113 @@
+import * as fs from "fs";
+import * as path from "path";
+
+function isExecutableFile(filePath: string): boolean {
+  try {
+    const stat = fs.statSync(filePath);
+    if (!stat.isFile()) {
+      return false;
+    }
+    fs.accessSync(filePath, fs.constants.X_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function normalizedStem(fileName: string): string {
+  return path.basename(fileName, path.extname(fileName)).toLocaleLowerCase();
+}
+
+function scoreCandidate(requestedStem: string, candidateName: string): number {
+  const candidateStem = normalizedStem(candidateName);
+  if (candidateStem === requestedStem) {
+    return 100;
+  }
+
+  const requestedTokens = requestedStem.split(/[^a-z0-9]+/).filter(Boolean);
+  const candidateTokens = candidateStem.split(/[^a-z0-9]+/).filter(Boolean);
+  if (requestedTokens.length === 0 || candidateTokens.length === 0) {
+    return 0;
+  }
+
+  const candidateIsRequestedPrefix =
+    requestedStem.startsWith(candidateStem) &&
+    /[^a-z0-9]/.test(requestedStem.charAt(candidateStem.length));
+  if (candidateIsRequestedPrefix) {
+    return 80 + Math.min(candidateStem.length, 19);
+  }
+
+  const requestedIsCandidatePrefix =
+    candidateStem.startsWith(requestedStem) &&
+    /[^a-z0-9]/.test(candidateStem.charAt(requestedStem.length));
+  if (requestedIsCandidatePrefix) {
+    return 70 + Math.min(requestedStem.length, 19);
+  }
+
+  const commonTokens = candidateTokens.filter((token) => requestedTokens.includes(token));
+  return commonTokens.length === Math.min(requestedTokens.length, candidateTokens.length)
+    ? 50 + commonTokens.join("").length
+    : 0;
+}
+
+/**
+ * Resolve a Windows executable declared by an extension to a native executable
+ * shipped beside it by the Linux build of the application. The resolver is
+ * deliberately local and name-based: it never contains application IDs or a
+ * catalogue of special cases.
+ */
+export function resolveNativeExecutable(
+  basePath: string,
+  declaredPath: string,
+  platform: NodeJS.Platform = process.platform,
+): string {
+  if (platform !== "linux" || !declaredPath?.toLocaleLowerCase().endsWith(".exe")) {
+    return declaredPath;
+  }
+
+  const absoluteDeclared = path.isAbsolute(declaredPath)
+    ? declaredPath
+    : path.join(basePath, declaredPath);
+  if (fs.existsSync(absoluteDeclared)) {
+    return declaredPath;
+  }
+
+  const directory = path.dirname(absoluteDeclared);
+  const requestedStem = normalizedStem(absoluteDeclared);
+  let candidates: string[];
+  try {
+    candidates = fs.readdirSync(directory);
+  } catch {
+    return declaredPath;
+  }
+
+  const best = candidates
+    .filter((candidate) => !candidate.toLocaleLowerCase().endsWith(".exe"))
+    .map((candidate) => ({
+      candidate,
+      score: scoreCandidate(requestedStem, candidate),
+    }))
+    .filter(
+      ({ candidate, score }) => score >= 50 && isExecutableFile(path.join(directory, candidate)),
+    )
+    .sort((lhs, rhs) => rhs.score - lhs.score || lhs.candidate.localeCompare(rhs.candidate))[0];
+
+  if (best === undefined) {
+    return declaredPath;
+  }
+
+  const resolvedAbsolute = path.join(directory, best.candidate);
+  return path.isAbsolute(declaredPath)
+    ? resolvedAbsolute
+    : path.relative(basePath, resolvedAbsolute);
+}
+
+export function resolvePlatformPath(
+  basePath: string,
+  declaredPath: string,
+  platform: NodeJS.Platform = process.platform,
+): string {
+  return path.isAbsolute(declaredPath)
+    ? resolveNativeExecutable(basePath, declaredPath, platform)
+    : path.join(basePath, resolveNativeExecutable(basePath, declaredPath, platform));
+}
