+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import {
+  getFileVersion,
+  getProductVersion,
+  getFileVersionLocalized,
+  getProductVersionLocalized,
+} from "./linuxExeVersion";
+
+describe("native Linux PE version reader", () => {
+  let directory: string;
+  beforeEach(() => {
+    directory = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-pe-version-"));
+  });
+  afterEach(() => fs.rmSync(directory, { recursive: true, force: true }));
+
+  it("reads fixed and localized versions from the bundled Windows executable", () => {
+    const executable = path.resolve(__dirname, "../../assets/dotnetprobe.exe");
+    expect(getFileVersion(executable)).toBe("1.0.0.0");
+    expect(getProductVersion(executable)).toBe("1.0.0.0");
+    expect(getFileVersionLocalized(executable)).toBe("1.0.0.0");
+    expect(getProductVersionLocalized(executable)).toMatch(/^1\.0\.0\+/);
+  });
+
+  it("returns an empty fallback for missing and non-PE files", () => {
+    const plainFile = path.join(directory, "ordinary.exe");
+    fs.writeFileSync(plainFile, "This file is not a PE executable.\n");
+    for (const file of [path.join(directory, "missing.exe"), plainFile]) {
+      for (const readVersion of [getFileVersion, getProductVersion,
+        getFileVersionLocalized, getProductVersionLocalized]) {
+        expect(readVersion(file)).toBe("");
+      }
+    }
+  });
+});
