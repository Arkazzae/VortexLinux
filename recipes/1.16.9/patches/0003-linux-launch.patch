index 0000000..65a8d0e
--- /dev/null
+++ b/src/util/linux/proton.ts
@@ -0,0 +1,148 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import { parse } from "simple-vdf";
+
+import { steamLibraries } from "./steamLibraries";
+
+export interface IProtonInfo {
+  usesProton: boolean;
+  compatDataPath?: string;
+  protonPath?: string;
+}
+
+function value(object: any, key: string): any {
+  return object?.[Object.keys(object).find((entry) => entry.toLowerCase() === key.toLowerCase())];
+}
+
+export async function detectProtonUsage(steamAppsPath: string, appId: string): Promise<boolean> {
+  return fs.existsSync(path.join(getCompatDataPath(steamAppsPath, appId), "pfx"));
+}
+export function getCompatDataPath(steamAppsPath: string, appId: string): string {
+  return path.join(steamAppsPath, "compatdata", appId);
+}
+export function getWinePrefixPath(compatDataPath: string): string {
+  return path.join(compatDataPath, "pfx");
+}
+
+export async function getConfiguredProtonName(
+  steamPath: string,
+  appId: string,
+): Promise<string | undefined> {
+  try {
+    let config: any = parse(fs.readFileSync(path.join(steamPath, "config", "config.vdf"), "utf8"));
+    for (const key of ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"]) {
+      config = value(config, key);
+    }
+    // Steam keeps an empty name after the per-game override is cleared.
+    const name = (id: string): string | undefined => {
+      const candidate = config?.[id]?.name;
+      return typeof candidate === "string" && candidate.length > 0 ? candidate : undefined;
+    };
+    return name(appId) ?? name("0");
+  } catch {
+    return undefined;
+  }
+}
+
+function installations(steamPath: string): string[] {
+  const directories = [
+    path.join(steamPath, "compatibilitytools.d"),
+    ...(process.env.STEAM_EXTRA_COMPAT_TOOLS_PATHS ?? "").split(path.delimiter).filter(Boolean),
+    // Distribution packages such as proton-ge-custom install here.
+    "/usr/share/steam/compatibilitytools.d",
+    "/usr/local/share/steam/compatibilitytools.d",
+    ...steamLibraries([steamPath]).map((library) => path.join(library, "steamapps", "common")),
+  ];
+  return directories.flatMap((directory) => {
+    try {
+      return fs
+        .readdirSync(directory)
+        .map((entry) => path.join(directory, entry))
+        .filter((entry) => fs.existsSync(path.join(entry, "proton")));
+    } catch {
+      return [];
+    }
+  });
+}
+
+export async function resolveProtonPath(
+  steamPath: string,
+  protonName: string,
+): Promise<string | undefined> {
+  const installed = installations(steamPath);
+  for (const directory of installed) {
+    try {
+      const manifest = parse(
+        fs.readFileSync(path.join(directory, "compatibilitytool.vdf"), "utf8"),
+      );
+      const tools = value(value(manifest, "compatibilitytools"), "compat_tools");
+      if (Object.hasOwn(tools ?? {}, protonName)) return directory;
+    } catch {
+      /* Older tools may not have a manifest. */
+    }
+  }
+  const exact = installed.find((directory) => path.basename(directory) === protonName);
+  if (exact) return exact;
+  const keyword = /^proton_(.+)$/i.exec(protonName)?.[1];
+  if (!keyword) return undefined;
+  const pattern = /^\d+$/.test(keyword) ? new RegExp(`\\b${keyword}(?:\\.\\d+)?\\b`) : undefined;
+  const matches = installed.filter((directory) => {
+    const name = path.basename(directory).toLowerCase();
+    return (
+      name.startsWith("proton") &&
+      (pattern ? pattern.test(name) : name.includes(keyword.toLowerCase()))
+    );
+  });
+  return matches.length === 1 ? matches[0] : undefined;
+}
+
+export async function findLatestProton(steamPath: string): Promise<string | undefined> {
+  return installations(steamPath)
+    .filter((directory) => /^proton\s+\d/i.test(path.basename(directory)))
+    .sort((left, right) =>
+      path.basename(right).localeCompare(path.basename(left), "en", { numeric: true }),
+    )[0];
+}
+
+export async function getProtonInfo(
+  steamPath: string,
+  steamAppsPath: string,
+  appId: string,
+): Promise<IProtonInfo> {
+  if (!(await detectProtonUsage(steamAppsPath, appId))) return { usesProton: false };
+  const protonName = await getConfiguredProtonName(steamPath, appId);
+  const protonPath =
+    protonName !== undefined
+      ? await resolveProtonPath(steamPath, protonName)
+      : await findLatestProton(steamPath);
+  return { usesProton: true, compatDataPath: getCompatDataPath(steamAppsPath, appId), protonPath };
+}
+
+export function isWindowsExecutable(filePath: string): boolean {
+  return [".exe", ".bat", ".cmd"].includes(path.extname(filePath).toLowerCase());
+}
+export function buildProtonEnvironment(
+  compatDataPath: string,
+  steamPath: string,
+  existingEnv?: Record<string, string>,
+): Record<string, string> {
+  const preloads = [
+    path.join(steamPath, "ubuntu12_32", "gameoverlayrenderer.so"),
+    path.join(steamPath, "ubuntu12_64", "gameoverlayrenderer.so"),
+  ];
+  return {
+    ...existingEnv,
+    STEAM_COMPAT_DATA_PATH: compatDataPath,
+    STEAM_COMPAT_CLIENT_INSTALL_PATH: steamPath,
+    WINEPREFIX: getWinePrefixPath(compatDataPath),
+    LD_PRELOAD: preloads.join(":"),
+  };
+}
+export function buildProtonCommand(
+  protonPath: string,
+  exePath: string,
+  args: string[],
+): { executable: string; args: string[] } {
+  return { executable: path.join(protonPath, "proton"), args: ["run", exePath, ...args] };
+}
