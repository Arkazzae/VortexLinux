@@ -0,0 +1,248 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import type { CompatibilityGame } from "../compatibilityPaths";
+import type { ToolCommand } from "./gameTools";
+import { canonicalPath, steamRoots } from "./steamLibraries";
+
+export type HeroicStoreId = "epic" | "gog" | "amazon";
+export interface HeroicGame {
+  appid: string;
+  name: string;
+  gamePath: string;
+  gameStoreId: HeroicStoreId;
+  configPath: string;
+  flatpak: boolean;
+  native: boolean;
+}
+const runners = { epic: "legendary", gog: "gog", amazon: "nile" };
+
+export function heroicRoots(): Array<{ configPath: string; flatpak: boolean }> {
+  return [
+    {
+      configPath: path.join(
+        process.env.XDG_CONFIG_HOME ?? path.join(os.homedir(), ".config"),
+        "heroic",
+      ),
+      flatpak: false,
+    },
+    {
+      configPath: path.join(os.homedir(), ".var/app/com.heroicgameslauncher.hgl/config/heroic"),
+      flatpak: true,
+    },
+  ];
+}
+function readJson(file: string): any {
+  try {
+    return JSON.parse(fs.readFileSync(file, "utf8"));
+  } catch {
+    return undefined;
+  }
+}
+function absolute(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const expanded = value.replace(/^~(?=\/|$)/, os.homedir());
+  return path.isAbsolute(expanded) ? expanded : undefined;
+}
+export function readHeroicGames(): HeroicGame[] {
+  const games: HeroicGame[] = [];
+  for (const root of heroicRoots()) {
+    if (!fs.existsSync(root.configPath)) continue;
+    const epic =
+      readJson(path.join(root.configPath, "legendaryConfig/legendary/installed.json")) ??
+      readJson(path.join(path.dirname(root.configPath), "legendary/installed.json")) ??
+      {};
+    const gog = readJson(path.join(root.configPath, "gog_store/installed.json"))?.installed ?? [];
+    const gogLibrary = readJson(path.join(root.configPath, "store_cache/gog_library.json"))?.games;
+    const gogTitles = new Map(
+      (Array.isArray(gogLibrary) ? gogLibrary : []).map((entry: any) => [
+        entry?.app_name,
+        entry?.title,
+      ]),
+    );
+    const amazon = readJson(path.join(root.configPath, "nile_config/nile/installed.json")) ?? [];
+    const titleData = readJson(path.join(root.configPath, "nile_config/nile/library.json"));
+    const titles = new Map(
+      (Array.isArray(titleData) ? titleData : []).map((entry: any) => [
+        entry?.product?.id,
+        entry?.product?.title,
+      ]),
+    );
+    const add = (
+      store: HeroicStoreId,
+      id: unknown,
+      title: unknown,
+      location: unknown,
+      platform: unknown,
+    ) => {
+      const gamePath = absolute(location);
+      if (
+        typeof id !== "string" ||
+        !id ||
+        /[\\/]/.test(id) ||
+        !gamePath ||
+        !fs.existsSync(gamePath)
+      )
+        return;
+      games.push({
+        ...root,
+        appid: id,
+        name: typeof title === "string" ? title : id,
+        gamePath: canonicalPath(gamePath),
+        gameStoreId: store,
+        native: typeof platform === "string" && platform.toLowerCase() === "linux",
+      });
+    };
+    for (const [id, game] of Object.entries(epic) as Array<[string, any]>)
+      add("epic", game?.app_name ?? id, game?.title, game?.install_path, game?.platform);
+    if (Array.isArray(gog))
+      for (const game of gog)
+        add(
+          "gog",
+          game?.appName,
+          game?.title ?? gogTitles.get(game?.appName),
+          game?.install_path,
+          game?.platform,
+        );
+    if (Array.isArray(amazon))
+      for (const game of amazon)
+        add("amazon", game?.id, titles.get(game?.id), game?.path, "windows");
+  }
+  return games;
+}
+export function findHeroicGame(game: CompatibilityGame): HeroicGame | undefined {
+  if (!game.path) return undefined;
+  const matches = readHeroicGames().filter(
+    (entry) => entry.gameStoreId === game.store && entry.gamePath === canonicalPath(game.path),
+  );
+  if (matches.length > 1)
+    throw new Error(
+      "This game is registered in several Heroic installations. Remove the stale registration or set WINEPREFIX explicitly.",
+    );
+  return matches[0];
+}
+function settings(game: HeroicGame): any {
+  const defaults = readJson(path.join(game.configPath, "config.json"))?.defaultSettings ?? {};
+  const config = readJson(path.join(game.configPath, "GamesConfig", `${game.appid}.json`));
+  return { ...defaults, ...config?.[game.appid] };
+}
+export function heroicPrefix(game: HeroicGame): string | null | undefined {
+  if (game.native) return null;
+  const config = settings(game);
+  const prefix = absolute(config.winePrefix);
+  if (!prefix) return undefined;
+  const direct = fs.existsSync(path.join(prefix, "drive_c"));
+  const nested = fs.existsSync(path.join(prefix, "pfx/drive_c"));
+  if (direct && nested && canonicalPath(prefix) !== canonicalPath(path.join(prefix, "pfx"))) {
+    throw new Error("Heroic's prefix contains two different Windows installations");
+  }
+  return direct
+    ? prefix
+    : config.wineVersion?.type === "proton"
+      ? path.join(prefix, "pfx")
+      : prefix;
+}
+export function findProgram(name: string): string | undefined {
+  const candidates = path.isAbsolute(name)
+    ? [name]
+    : (process.env.PATH ?? "")
+        .split(path.delimiter)
+        .filter(Boolean)
+        .map((directory) => path.join(directory, name));
+  return candidates.find((candidate) => {
+    try {
+      fs.accessSync(candidate, fs.constants.X_OK);
+      return fs.statSync(candidate).isFile();
+    } catch {
+      return false;
+    }
+  });
+}
+export function heroicLauncher(
+  flatpak: boolean,
+): { executable: string; args: string[] } | undefined {
+  if (!heroicRoots().some((root) => root.flatpak === flatpak && fs.existsSync(root.configPath)))
+    return undefined;
+  const executable = flatpak
+    ? findProgram("flatpak")
+    : findProgram(process.env.HEROIC_BINARY ?? "heroic");
+  return executable
+    ? { executable, args: flatpak ? ["run", "com.heroicgameslauncher.hgl"] : [] }
+    : undefined;
+}
+export function heroicLaunchCommand(game: HeroicGame, args: string[] = []): ToolCommand {
+  const launcher = heroicLauncher(game.flatpak);
+  if (!launcher)
+    throw new Error("Heroic was not found. Install Heroic or set HEROIC_BINARY to its executable.");
+  const url = new URL("heroic://launch");
+  url.searchParams.set("appName", game.appid);
+  url.searchParams.set("runner", runners[game.gameStoreId]);
+  for (const argument of args) url.searchParams.append("arg", encodeURIComponent(argument));
+  return {
+    executable: launcher.executable,
+    args: [...launcher.args, url.toString()],
+    options: { shell: false },
+  };
+}
+export async function heroicToolCommand(
+  command: ToolCommand,
+  selected: CompatibilityGame,
+): Promise<ToolCommand> {
+  const game = findHeroicGame(selected);
+  if (!game) throw new Error("The selected game is not registered in Heroic");
+  const config = settings(game);
+  const prefix = command.options.env?.WINEPREFIX ?? heroicPrefix(game);
+  if (!prefix || !fs.existsSync(path.join(prefix, "drive_c")))
+    throw new Error("The Heroic Wine prefix is unavailable. Launch the game once in Heroic.");
+  const runner = config.wineVersion;
+  const binary = absolute(runner?.bin);
+  if (!binary) throw new Error("Select a Wine or Proton version for this game in Heroic");
+  let executable = binary;
+  let args = [command.executable, ...command.args];
+  const environment = Object.fromEntries(
+    (config.enviromentOptions ?? [])
+      .filter((entry: any) => typeof entry.key === "string" && typeof entry.value === "string")
+      .map((entry: any) => [entry.key, entry.value]),
+  );
+  const env: Record<string, string> = {
+    ...environment,
+    ...command.options.env,
+    WINEPREFIX: prefix,
+  };
+  if (runner.type === "proton") {
+    const umu = !game.flatpak ? findProgram("umu-run") : undefined;
+    const bundledUmu = path.join(game.configPath, "tools/runtimes/umu/umu_run.py");
+    const umuBinary = umu ?? (fs.existsSync(bundledUmu) ? bundledUmu : undefined);
+    env.PROTONPATH = path.dirname(binary);
+    env.GAMEID = "umu-0";
+    env.STORE = { epic: "egs", gog: "gog", amazon: "amazon" }[game.gameStoreId];
+    if (config.disableUMU !== true && umuBinary) {
+      executable = umuBinary;
+      env.PROTON_VERB = "run";
+      // UMU, like Heroic, expects the compatibility data directory that holds pfx.
+      if (path.basename(prefix) === "pfx") env.WINEPREFIX = path.dirname(prefix);
+    } else {
+      if (path.basename(prefix) !== "pfx")
+        throw new Error(
+          "This Heroic prefix requires UMU. Install UMU in Heroic before running tools.",
+        );
+      env.STEAM_COMPAT_DATA_PATH = path.dirname(prefix);
+      env.STEAM_COMPAT_CLIENT_INSTALL_PATH = steamRoots().find((root) => fs.existsSync(root)) ?? "";
+      args = ["run", ...args];
+    }
+  } else if (runner.type !== "wine") throw new Error(`Unsupported Heroic runner: ${runner.type}`);
+  if (game.flatpak) {
+    const flatpak = findProgram("flatpak");
+    if (!flatpak) throw new Error("Flatpak was not found");
+    args = [
+      "run",
+      `--command=${executable}`,
+      ...Object.entries(env).map(([key, value]) => `--env=${key}=${value}`),
+      "com.heroicgameslauncher.hgl",
+      ...args,
+    ];
+    executable = flatpak;
+  } else if (!findProgram(executable)) throw new Error(`Heroic's runner is missing: ${executable}`);
+  return { executable, args, options: { ...command.options, shell: false, env } };
+}
