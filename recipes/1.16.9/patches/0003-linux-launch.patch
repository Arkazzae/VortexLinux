@@ -0,0 +1,49 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { GameEntryNotFound, GameStoreNotFound, type IGameStore } from "../types/IGameStore";
+import epicGamesLauncher from "./EpicGamesLauncher";
+
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+// The legacy barrel also exports UI modules; the store only needs these errors.
+vi.mock("../types/api", async () => import("../types/IGameStore"));
+
+describe.runIf(process.platform === "linux")("Epic Games store without Heroic", () => {
+  let root: string;
+  let store: IGameStore;
+  beforeEach(async () => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-epic-absent-"));
+    vi.mocked(os.homedir).mockReturnValue(root);
+    vi.stubEnv("XDG_CONFIG_HOME", path.join(root, ".config"));
+    store = epicGamesLauncher!;
+    await store.reloadGames();
+  });
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    vi.restoreAllMocks();
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+  it("exposes the Heroic store on Linux", () => {
+    expect(store).toBeDefined();
+    expect(store.id).toBe("epic");
+  });
+
+  it("reports that Epic and its games are unavailable", async () => {
+    await expect(store.allGames()).resolves.toEqual([]);
+    await expect(store.getGameStorePath()).resolves.toBeUndefined();
+    await expect(store.isGameInstalled?.("Example")).resolves.toBe(false);
+    await expect(store.isGameStoreInstalled?.()).resolves.toBe(false);
+  });
+
+  it("rejects lookups with the normal missing-entry error", async () => {
+    await expect(store.findByAppId("Example")).rejects.toBeInstanceOf(GameEntryNotFound);
+    await expect(store.findByName("Example")).rejects.toBeInstanceOf(GameEntryNotFound);
+  });
+
+  it("rejects launch attempts with the normal missing-store error", async () => {
+    await expect(store.launchGame("Example")).rejects.toBeInstanceOf(GameStoreNotFound);
+  });
+});
