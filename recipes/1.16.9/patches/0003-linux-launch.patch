@@ -0,0 +1,92 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import {
+  type CompatibilityGame,
+  getCompatibilityGame,
+  selectedGamePrefix,
+} from "../compatibilityPaths";
+import { mapWineArgument } from "../linuxCompatibility";
+import {
+  buildProtonCommand,
+  buildProtonEnvironment,
+  getProtonInfo,
+  isWindowsExecutable,
+} from "./proton";
+import { canonicalPath, findSteamInstallation, steamLibraries, steamRoots } from "./steamLibraries";
+
+export interface ToolOptions {
+  cwd?: string;
+  env?: Record<string, string>;
+  shell?: boolean;
+}
+export interface ToolCommand {
+  executable: string;
+  args: string[];
+  options: ToolOptions;
+}
+type StoreRunner = (command: ToolCommand, game: CompatibilityGame) => Promise<ToolCommand>;
+const runners = new Map<string, StoreRunner>();
+export function registerGameToolRunner(store: string, runner: StoreRunner): void {
+  runners.set(store, runner);
+}
+
+export async function resolveGameTool(
+  executable: string,
+  args: string[],
+  options: ToolOptions,
+  game = getCompatibilityGame(),
+): Promise<ToolCommand> {
+  const command = { executable, args, options };
+  if (process.platform !== "linux" || !isWindowsExecutable(executable)) return command;
+  if (!game && !options.env?.WINEPREFIX) return command;
+  const wineArgs = args.map(mapWineArgument);
+  if (game && runners.has(game.store ?? "")) {
+    return runners.get(game.store)({ ...command, args: wineArgs }, game);
+  }
+  const prefix = options.env?.WINEPREFIX ?? selectedGamePrefix(game);
+  if (!prefix || !fs.existsSync(path.join(prefix, "drive_c"))) {
+    throw new Error(
+      "The game's Wine prefix is unavailable. Launch the game once or configure WINEPREFIX for this tool.",
+    );
+  }
+  if (game?.store === "steam") {
+    const installed = game.path ? findSteamInstallation(game.path) : undefined;
+    if (!installed) throw new Error("Cannot find the selected game's Steam installation");
+    const library = canonicalPath(path.dirname(installed.steamAppsPath));
+    const steam = steamRoots().find((root) => steamLibraries([root]).includes(library));
+    if (!steam) throw new Error("Cannot find Steam's configuration for this game library");
+    const proton = await getProtonInfo(steam, installed.steamAppsPath, installed.appId);
+    if (!proton.protonPath)
+      throw new Error(
+        "The Proton version selected in Steam is not installed or could not be identified",
+      );
+    if (options.env?.WINEPREFIX && canonicalPath(prefix) !== canonicalPath(installed.prefix)) {
+      throw new Error(
+        "This tool's WINEPREFIX differs from the selected Steam game. Use the game's prefix with Proton.",
+      );
+    }
+    const result = buildProtonCommand(proton.protonPath, executable, wineArgs);
+    return {
+      ...result,
+      options: {
+        ...options,
+        shell: false,
+        env: {
+          ...buildProtonEnvironment(proton.compatDataPath, steam, options.env),
+          SteamAppId: installed.appId,
+          SteamGameId: installed.appId,
+        },
+      },
+    };
+  }
+  return {
+    executable: "wine",
+    args: [executable, ...wineArgs],
+    options: {
+      ...options,
+      shell: false,
+      env: { ...options.env, WINEPREFIX: prefix },
+    },
+  };
+}
