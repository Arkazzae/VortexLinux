+export async function resolveGameVersion(game: IGame, discovery: IDiscoveryResult): Promise<string> {
+  if (game.getGameVersion !== undefined) {
+    try {
+      const version = await getExtGameVersion(game, discovery);
+      if (knownVersion(version)) return version;
+    } catch { /* Fall back to executable metadata. */ }
+  }
+  return getExecGameVersion(game, discovery);
+}
