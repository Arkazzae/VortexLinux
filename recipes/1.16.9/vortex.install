post_install() {
  update-desktop-database -q
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
  echo ":: To select Vortex for Nexus links, run:"
  echo "   xdg-mime default com.nexusmods.vortex.desktop x-scheme-handler/nxm"
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
}
