@@ -0,0 +1,51 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import type { LootAsync } from "loot";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { adaptLootForLinux, resolvePluginPaths } from "./linuxLoot";
+
+describe.runIf(process.platform === "linux")("LOOT plugin paths on Linux", () => {
+  let game: string;
+  let data: string;
+  beforeEach(() => {
+    game = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-linux-loot-"));
+    data = path.join(game, "data");
+    fs.mkdirSync(data);
+    for (const name of ["Skyrim.esm", "Alpha.esp"]) fs.writeFileSync(path.join(data, name), "");
+    fs.writeFileSync(path.join(data, "Beta.esp.ghost"), "");
+  });
+  afterEach(() => fs.rmSync(game, { recursive: true, force: true }));
+
+  it("finds plugin IDs and paths whatever their casing, including ghosted plugins", () => {
+    // gameDataPath spells the folder "Data"; this game's folder is "data".
+    const dataPath = path.join(game, "Data");
+    expect(
+      resolvePluginPaths(dataPath, ["skyrim.esm", path.join(dataPath, "ALPHA.ESP"), "beta.esp"]),
+    ).toEqual([
+      path.join(data, "Skyrim.esm"),
+      path.join(data, "Alpha.esp"),
+      path.join(data, "Beta.esp.ghost"),
+    ]);
+  });
+
+  it("passes a missing plugin on as given so libloot reports it", () => {
+    expect(resolvePluginPaths(data, ["missing.esp", "/elsewhere/Gone.esp"])).toEqual([
+      "missing.esp",
+      "/elsewhere/Gone.esp",
+    ]);
+  });
+
+  it("resolves only what is loaded and forwards everything else", async () => {
+    const loadPlugins = vi.fn(async () => undefined);
+    const sortPlugins = vi.fn(async () => ["Alpha.esp"]);
+    const loot = { loadPlugins, sortPlugins } as unknown as LootAsync;
+    const adapted = adaptLootForLinux(loot, () => data);
+    await adapted.loadPlugins(["alpha.esp"], true);
+    expect(loadPlugins).toHaveBeenCalledWith([path.join(data, "Alpha.esp")], true);
+    await adapted.sortPlugins(["alpha.esp"]);
+    expect(sortPlugins).toHaveBeenCalledWith(["alpha.esp"]);
+  });
+});
diff --git a/src/renderer/src/extensions/gamebryo_plugin_management/util/linuxLoot.ts b/src/renderer/src/extensions/gamebryo_plugin_management/util/linuxLoot.ts
