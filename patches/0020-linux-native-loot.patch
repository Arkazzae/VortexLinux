--- /dev/null
+++ b/src/renderer/src/extensions/gamebryo_plugin_management/util/linuxLoot.ts
@@ -0,0 +1,36 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import type { LootAsync } from "loot";
+
+import { resolveCaseInsensitiveSync } from "../../../util/linuxCompatibility";
+
+/**
+ * libloot opens plugins at exactly the paths it is given. Vortex passes plugin IDs, which are
+ * lower case, and on a case-sensitive filesystem neither they nor a "data" folder spelled
+ * differently from "Data" would be found. Resolve each one to the file on disk, ghosted or not.
+ * A plugin that isn't there is passed on as given, so libloot reports it.
+ */
+export function resolvePluginPaths(dataPath: string, plugins: string[]): string[] {
+  return plugins.map((plugin) => {
+    const requested = path.isAbsolute(plugin) ? plugin : path.join(dataPath, plugin);
+    for (const candidate of [requested, `${requested}.ghost`]) {
+      const resolved = resolveCaseInsensitiveSync(candidate);
+      if (fs.existsSync(resolved)) return resolved;
+    }
+    return plugin;
+  });
+}
+
+/** Once loaded, libloot looks plugins up by name regardless of case, so only loading needs this. */
+export function adaptLootForLinux(loot: LootAsync, dataPath: () => string): LootAsync {
+  return new Proxy(loot, {
+    get(target, key, receiver) {
+      if (key === "loadPlugins") {
+        return (plugins: string[], headersOnly: boolean) =>
+          target.loadPlugins(resolvePluginPaths(dataPath(), plugins), headersOnly);
+      }
+      return Reflect.get(target, key, receiver);
+    },
+  });
+}
