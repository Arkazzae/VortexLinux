new file mode 100644
--- /dev/null
+++ b/src/renderer/src/extensions/mod_management/util/archivePaths.ts
@@ -0,0 +1,41 @@
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+
+/**
+ * Some archives made on Windows separate folders with "\" instead of "/". 7-Zip on Linux keeps
+ * the backslashes as part of the name, so "red4ext\plugins\Mod.dll" is extracted as one file.
+ * Move every such entry to the folders its name describes, merging with folders that already
+ * exist. "." and ".." segments are dropped, so nothing can leave the extraction folder.
+ */
+export async function splitBackslashNames(root: string): Promise<void> {
+  const visit = async (directory: string): Promise<void> => {
+    for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
+      const source = path.join(directory, entry.name);
+      if (!entry.name.includes("\\")) {
+        if (entry.isDirectory()) await visit(source);
+        continue;
+      }
+      const parts = entry.name
+        .split("\\")
+        .filter((part) => part.length > 0 && part !== "." && part !== "..");
+      if (parts.length === 0) continue;
+      const target = path.join(directory, ...parts);
+      await move(source, target, entry.isDirectory());
+      if (entry.isDirectory()) await visit(target);
+    }
+  };
+  await visit(root);
+}
+
+async function move(source: string, target: string, isDirectory: boolean): Promise<void> {
+  const existing = await fs.stat(target).catch(() => undefined);
+  if (isDirectory && existing?.isDirectory()) {
+    for (const child of await fs.readdir(source, { withFileTypes: true })) {
+      await move(path.join(source, child.name), path.join(target, child.name), child.isDirectory());
+    }
+    await fs.rmdir(source);
+    return;
+  }
+  await fs.mkdir(path.dirname(target), { recursive: true });
+  await fs.rename(source, target);
+}
