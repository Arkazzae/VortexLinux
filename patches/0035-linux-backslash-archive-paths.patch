diff --git a/src/renderer/src/extensions/mod_management/util/archivePaths.test.ts b/src/renderer/src/extensions/mod_management/util/archivePaths.test.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/extensions/mod_management/util/archivePaths.test.ts
@@ -0,0 +1,92 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { splitBackslashNames } from "./archivePaths";
+
+function tree(root: string): string[] {
+  const result: string[] = [];
+  const walk = (directory: string) => {
+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+      const full = path.join(directory, entry.name);
+      const relative = path.relative(root, full);
+      if (entry.isDirectory()) {
+        result.push(`${relative}/`);
+        walk(full);
+      } else {
+        result.push(`${relative}=${fs.readFileSync(full, "utf8")}`);
+      }
+    }
+  };
+  walk(root);
+  return result.sort();
+}
+
+describe.runIf(process.platform === "linux")("archive entries with backslash separators", () => {
+  let root: string;
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-archive-paths-"));
+  });
+  afterEach(() => fs.rmSync(root, { recursive: true, force: true }));
+
+  it("turns the names 7-Zip extracts from a Windows-style archive into folders", async () => {
+    // What 7-Zip on Linux extracts from the Appearance Runtime Plugin archive.
+    fs.mkdirSync(path.join(root, "red4ext\\plugins\\"));
+    fs.writeFileSync(
+      path.join(root, "red4ext\\plugins\\AppearanceRuntimePlugin\\AppearanceRuntimePlugin.dll"),
+      "dll",
+    );
+    fs.mkdirSync(path.join(root, "normal"));
+    fs.writeFileSync(path.join(root, "normal", "readme.txt"), "readme");
+
+    await splitBackslashNames(root);
+
+    expect(tree(root)).toEqual([
+      "normal/",
+      "normal/readme.txt=readme",
+      "red4ext/",
+      "red4ext/plugins/",
+      "red4ext/plugins/AppearanceRuntimePlugin/",
+      "red4ext/plugins/AppearanceRuntimePlugin/AppearanceRuntimePlugin.dll=dll",
+    ]);
+  });
+
+  it("merges into folders that already exist, also below a renamed folder", async () => {
+    fs.mkdirSync(path.join(root, "Data", "Scripts"), { recursive: true });
+    fs.writeFileSync(path.join(root, "Data", "Scripts", "kept.pex"), "kept");
+    fs.mkdirSync(path.join(root, "Data\\Scripts"));
+    fs.writeFileSync(path.join(root, "Data\\Scripts", "added.pex"), "added");
+    fs.writeFileSync(path.join(root, "Data\\Scripts", "Source\\added.psc"), "source");
+
+    await splitBackslashNames(root);
+
+    expect(tree(root)).toEqual([
+      "Data/",
+      "Data/Scripts/",
+      "Data/Scripts/Source/",
+      "Data/Scripts/Source/added.psc=source",
+      "Data/Scripts/added.pex=added",
+      "Data/Scripts/kept.pex=kept",
+    ]);
+  });
+
+  it("keeps entries inside the extraction folder", async () => {
+    fs.writeFileSync(path.join(root, "..\\..\\escape.txt"), "x");
+    fs.writeFileSync(path.join(root, "\\absolute.txt"), "y");
+
+    await splitBackslashNames(root);
+
+    expect(tree(root)).toEqual(["absolute.txt=y", "escape.txt=x"]);
+  });
+
+  it("leaves archives without backslashes untouched", async () => {
+    fs.mkdirSync(path.join(root, "Data"));
+    fs.writeFileSync(path.join(root, "Data", "plugin.esp"), "esp");
+
+    await splitBackslashNames(root);
+
+    expect(tree(root)).toEqual(["Data/", "Data/plugin.esp=esp"]);
+  });
+});
