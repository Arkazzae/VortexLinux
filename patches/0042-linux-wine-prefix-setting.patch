+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { isEqual } from "lodash";
+
+type Environment = Record<string, string>;
+
+/** The absolute folder a typed or picked value names; undefined for a relative one. */
+export function resolvePrefixInput(input: string): string | undefined {
+  const expanded = input.trim().replace(/^(?:~|\$HOME)(?=\/|$)/, os.homedir());
+  return path.isAbsolute(expanded) ? path.resolve(expanded) : undefined;
+}
+
+export type WinePrefixProblem = "not-a-prefix" | "not-for-proton";
+
+/** Why a folder can't be this game's prefix; undefined when it can. */
+export function winePrefixProblem(
+  folder: string,
+  store: string | undefined,
+): WinePrefixProblem | undefined {
+  if (!fs.existsSync(path.join(folder, "drive_c"))) {
+    return "not-a-prefix";
+  }
+  // Proton is given the folder around the prefix and always looks for pfx inside it.
+  return store === "steam" && path.basename(folder) !== "pfx" ? "not-for-proton" : undefined;
+}
+
+const LAUNCHERS: Record<string, string> = {
+  amazon: "Heroic",
+  bottles: "Bottles",
+  epic: "Heroic",
+  gog: "Heroic",
+  lutris: "Lutris",
+  steam: "Steam",
+};
+
+/** The program that starts games of this store on Linux. */
+export function launcherName(store: string): string {
+  return LAUNCHERS[store] ?? store;
+}
+
+/**
+ * What to store for a game to use `prefix`, or the detected one without it. The game's
+ * other variables stay, and envCustomized follows the same rule as the tool edit dialog
+ * because launching a game ignores the stored environment without it.
+ */
+export function winePrefixParameters(
+  discovery: { environment?: Environment; envCustomized?: boolean },
+  gameEnvironment: Environment | undefined,
+  prefix: string | undefined,
+): { environment: Environment; envCustomized: boolean } {
+  const original = gameEnvironment ?? {};
+  const { WINEPREFIX: _previous, ...environment } = discovery.envCustomized
+    ? (discovery.environment ?? {})
+    : original;
+  if (prefix !== undefined) {
+    environment.WINEPREFIX = prefix;
+  }
+  return { environment, envCustomized: !isEqual(environment, original) };
+}
