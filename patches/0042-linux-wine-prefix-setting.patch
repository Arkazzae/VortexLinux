+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  canChooseWinePrefix,
+  registerCompatibilityStore,
+  resetCompatibilityPathCache,
+  selectedGamePrefix,
+} from "../compatibilityPaths";
+import { isWinePrefix, resolvePrefixInput, winePrefixParameters } from "./winePrefixSetting";
+
+describe.runIf(process.platform === "linux")("Wine prefix setting", () => {
+  let root: string;
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-wine-prefix-"));
+    vi.stubEnv("HOME", root);
+    vi.stubEnv("WINEPREFIX", "");
+    resetCompatibilityPathCache();
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    resetCompatibilityPathCache();
+    fs.rmSync(root, { force: true, recursive: true });
+  });
+
+  const windowsGame = () => {
+    const gamePath = path.join(root, "Games/Example");
+    fs.mkdirSync(gamePath, { recursive: true });
+    fs.writeFileSync(path.join(gamePath, "Example.exe"), "MZ");
+    return { path: gamePath, executable: "Example.exe" };
+  };
+
+  it("expands the home folder and refuses relative paths", () => {
+    expect(resolvePrefixInput("~/.wine")).toBe(path.join(root, ".wine"));
+    expect(resolvePrefixInput(" $HOME/prefixes/game/ ")).toBe(path.join(root, "prefixes/game"));
+    expect(resolvePrefixInput("/mnt/prefix/")).toBe("/mnt/prefix");
+    expect(resolvePrefixInput("prefixes/game")).toBeUndefined();
+  });
+
+  it("recognises a prefix by its drive_c folder", () => {
+    expect(isWinePrefix(root)).toBe(false);
+    fs.mkdirSync(path.join(root, "drive_c"));
+    expect(isWinePrefix(root)).toBe(true);
+  });
+
+  it("keeps the game's other variables when setting and clearing the prefix", () => {
+    const set = winePrefixParameters(
+      { environment: { DXVK_HUD: "1" }, envCustomized: true },
+      { SteamAppId: "1" },
+      "/prefix",
+    );
+    expect(set).toEqual({
+      environment: { DXVK_HUD: "1", WINEPREFIX: "/prefix" },
+      envCustomized: true,
+    });
+
+    expect(winePrefixParameters(set, { SteamAppId: "1" }, undefined)).toEqual({
+      environment: { DXVK_HUD: "1" },
+      envCustomized: true,
+    });
+  });
+
+  it("starts from the extension's variables until the user customised them", () => {
+    expect(
+      winePrefixParameters({ environment: { STALE: "1" } }, { SteamAppId: "1" }, "/prefix"),
+    ).toEqual({
+      environment: { SteamAppId: "1", WINEPREFIX: "/prefix" },
+      envCustomized: true,
+    });
+  });
+
+  it("stops counting as customised once the prefix is cleared again", () => {
+    const set = winePrefixParameters({}, { SteamAppId: "1" }, "/prefix");
+    expect(winePrefixParameters(set, { SteamAppId: "1" }, undefined)).toEqual({
+      environment: { SteamAppId: "1" },
+      envCustomized: false,
+    });
+  });
+
+  it("makes the game use the chosen prefix", () => {
+    const game = windowsGame();
+    const prefix = path.join(root, "chosen");
+    expect(selectedGamePrefix(game)).toBeUndefined();
+
+    const { environment } = winePrefixParameters({}, undefined, prefix);
+
+    expect(selectedGamePrefix({ ...game, environment })).toBe(prefix);
+  });
+
+  it("offers the setting only for a Windows game no launcher owns", () => {
+    registerCompatibilityStore("test-launcher", () => undefined);
+    const game = windowsGame();
+    expect(canChooseWinePrefix(game)).toBe(true);
+    expect(canChooseWinePrefix({ ...game, store: "steam" })).toBe(false);
+    expect(canChooseWinePrefix({ ...game, store: "test-launcher" })).toBe(false);
+    expect(canChooseWinePrefix(undefined)).toBe(false);
+
+    const native = path.join(root, "Games/Native");
+    fs.mkdirSync(native);
+    fs.writeFileSync(path.join(native, "run.sh"), "#!/bin/sh\n");
+    expect(canChooseWinePrefix({ path: native, executable: "run.sh" })).toBe(false);
+  });
+
+  it("keeps the setting reachable after a prefix was chosen", () => {
+    const game = windowsGame();
+    expect(canChooseWinePrefix({ ...game, environment: { WINEPREFIX: "/gone" } })).toBe(true);
+  });
+});
