+import { mdiFolderOpen } from "@mdi/js";
+import React, { useCallback, useContext, useEffect, useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { useDispatch, useSelector } from "react-redux";
+
+import { MainContext } from "@/contexts";
+import { Alert } from "@/ui/components/alert/Alert";
+import { Button } from "@/ui/components/button/Button";
+import { TextField } from "@/ui/components/form/text_field/TextField";
+import { Typography } from "@/ui/components/typography/Typography";
+
+import { detectedGamePrefix } from "../../../util/compatibilityPaths";
+import {
+  launcherName,
+  resolvePrefixInput,
+  winePrefixParameters,
+  winePrefixProblem,
+} from "../../../util/linux/winePrefixSetting";
+import { activeGameId } from "../../../util/selectors";
+import { setGameParameters } from "../actions/settings";
+import { currentGame, currentGameDiscovery } from "../selectors";
+
+/** Shows the prefix a game runs in and lets the user point it somewhere else. */
+export default function WinePrefixSettings() {
+  const { t } = useTranslation(["common"]);
+  const { api } = useContext(MainContext);
+  const dispatch = useDispatch();
+  const gameId = useSelector(activeGameId);
+  const game = useSelector(currentGame);
+  const discovery = useSelector(currentGameDiscovery);
+  const store = discovery?.store || undefined;
+  const saved = discovery?.environment?.WINEPREFIX ?? "";
+  const [draft, setDraft] = useState(saved);
+  const [error, setError] = useState<string | undefined>(undefined);
+
+  const detected = useMemo(() => {
+    try {
+      const executable = discovery?.executable ?? game?.executable;
+      return detectedGamePrefix({ ...discovery, executable }) ?? undefined;
+    } catch {
+      return undefined;
+    }
+  }, [discovery, game]);
+
+  useEffect(() => {
+    setDraft(saved);
+    setError(undefined);
+  }, [gameId, saved]);
+
+  const apply = useCallback(
+    (input: string) => {
+      setDraft(input);
+      const clearing = input.trim() === "";
+      const prefix = clearing ? undefined : resolvePrefixInput(input);
+      // A folder that can't work would fail every file operation in it, so it is never stored.
+      const problem = clearing
+        ? undefined
+        : prefix === undefined
+          ? "not-a-prefix"
+          : winePrefixProblem(prefix, store);
+      if (problem !== undefined) {
+        setError(
+          problem === "not-a-prefix"
+            ? t("This folder is not a Wine prefix: it has no drive_c folder.")
+            : t("Proton needs the folder named pfx, inside the game's compatdata folder."),
+        );
+        return;
+      }
+      setError(undefined);
+      if ((prefix ?? "") !== saved) {
+        dispatch(
+          setGameParameters(gameId, winePrefixParameters(discovery, game?.environment, prefix)),
+        );
+      }
+    },
+    [dispatch, discovery, game, gameId, saved, store, t],
+  );
+
+  const browse = useCallback(() => {
+    void api.selectDir({ defaultPath: saved || detected }).then((selected) => {
+      if (selected !== undefined) {
+        apply(selected);
+      }
+    });
+  }, [api, apply, detected, saved]);
+
+  const launcher = store !== undefined ? launcherName(store) : undefined;
+  const inUse = saved || detected;
+  const source =
+    saved !== ""
+      ? t("Chosen by you")
+      : launcher !== undefined
+        ? t("Found through {{launcher}}", { replace: { launcher } })
+        : t("Wine's default prefix");
+
+  return (
+    <form
+      className="space-y-4"
+      id="wine-prefix-settings"
+      onSubmit={(event) => {
+        event.preventDefault();
+        apply(draft);
+      }}
+    >
+      <div id="wine-prefix-in-use">
+        <Typography className="font-semibold" typographyType="body-sm">
+          {t("Prefix in use")}
+        </Typography>
+
+        {inUse ? (
+          <>
+            <Typography as="div" className="break-all">
+              {inUse}
+            </Typography>
+
+            <Typography appearance="subdued" typographyType="body-sm">
+              {source}
+            </Typography>
+          </>
+        ) : (
+          <Typography as="div">
+            {t("No prefix found yet. Start the game once, or choose one below.")}
+          </Typography>
+        )}
+
+        {saved !== "" && detected !== undefined && detected !== saved && (
+          <Typography appearance="subdued" className="break-all" typographyType="body-sm">
+            {t("Detected: {{path}}", { replace: { path: detected } })}
+          </Typography>
+        )}
+      </div>
+
+      {launcher !== undefined && (
+        <Alert severity="warning">
+          {t(
+            "{{launcher}} starts this game in its own prefix, and Vortex can't change that. " +
+              "A different folder here only moves the game's INI and plugin files and where " +
+              "tools run, so those changes won't reach the game unless it is the game's real prefix.",
+            { replace: { launcher } },
+          )}
+        </Alert>
+      )}
+
+      <TextField
+        errorMessage={error}
+        hints={t("A folder with drive_c inside. Leave it empty to use the detected prefix.")}
+        label={t("Use a different prefix")}
+        placeholder={detected ?? ""}
+        value={draft}
+        onBlur={() => apply(draft)}
+        onChange={(event) => setDraft(event.target.value)}
+      />
+
+      <div className="flex gap-x-2">
+        <Button appearance="weak" brand="neutral" leftIconPath={mdiFolderOpen} onClick={browse}>
+          {t("Browse")}
+        </Button>
+
+        {saved !== "" && (
+          <Button appearance="weak" brand="neutral" onClick={() => apply("")}>
+            {t("Use detected prefix")}
+          </Button>
+        )}
+      </div>
+    </form>
+  );
+}
