+/** Whether the game runs in Wine at all, so it has a prefix to show and change. */
+export function usesWinePrefix(game = gameProvider?.()): boolean {
+  return process.platform === "linux" && game !== undefined && selectedGamePrefix(game) !== null;
+}
+
+/** The prefix Vortex finds for a game on its own, whatever the user chose instead. */
+export function detectedGamePrefix(game: CompatibilityGame): string | null | undefined {
+  const { WINEPREFIX: _chosen, ...environment } = game.environment ?? {};
+  return resolveGamePrefix({ ...game, environment });
+}
+
 /**
  * A game added by hand has no store to ask, so it lives where plain Wine runs
  * everything: $WINEPREFIX, or ~/.wine when that isn't set.
diff --git a/src/renderer/src/util/linux/winePrefixSetting.test.ts b/src/renderer/src/util/linux/winePrefixSetting.test.ts
