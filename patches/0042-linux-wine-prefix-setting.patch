+/** A game added by hand runs in a prefix of the user's choosing; a launcher owns any other. */
+export function canChooseWinePrefix(game = gameProvider?.()): boolean {
+  return (
+    process.platform === "linux" &&
+    game !== undefined &&
+    !game.store &&
+    selectedGamePrefix(game) !== null
+  );
+}
