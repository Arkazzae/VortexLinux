diff --git a/src/renderer/src/util/extensionPaths.test.ts b/src/renderer/src/util/extensionPaths.test.ts
new file mode 100644
index 0000000..e2ee1c8
--- /dev/null
+++ b/src/renderer/src/util/extensionPaths.test.ts
@@ -0,0 +1,54 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { extensionInStack, isInsideExtensionRoot } from "./extensionPaths";
+
+// Fedora Atomic links /home to /var/home: Vortex records extension paths
+// under /home while Node reports module filenames and stack frames under
+// /var/home.
+describe.runIf(process.platform === "linux")("extension roots behind a symlink", () => {
+  let root: string;
+  let linked: string;
+  let real: string;
+
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-extension-paths-"));
+    real = path.join(root, "var", "home", "plugins");
+    fs.mkdirSync(path.join(real, "game-example"), { recursive: true });
+    fs.symlinkSync(path.join(root, "var", "home"), path.join(root, "home"));
+    linked = path.join(root, "home", "plugins");
+  });
+
+  afterEach(() => {
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  it("places a module reported by its real path inside the linked root", () => {
+    expect(isInsideExtensionRoot(path.join(real, "game-example", "index.js"), linked)).toBe(true);
+  });
+
+  it("keeps modules outside the root outside", () => {
+    expect(isInsideExtensionRoot(path.join(root, "app", "index.js"), linked)).toBe(false);
+  });
+
+  it("names the extension a stack frame under the real path points into", () => {
+    const stack = `Error: boom\n    at ${path.join(real, "game-example", "index.js")}:3:9`;
+
+    expect(extensionInStack(stack, linked)).toBe("game-example");
+  });
+
+  it("names an extension installed as an update archive", () => {
+    const stack = `Error: boom\n    at ${path.join(linked, "Vortex Extension Update - game-example", "index.js")}:3:9`;
+
+    expect(extensionInStack(stack, linked)).toBe("game-example");
+  });
+
+  it("does not claim a stack that never enters the root", () => {
+    const stack = `Error: boom\n    at ${path.join(root, "app", "renderer.js")}:1:1`;
+
+    expect(extensionInStack(stack, linked)).toBeUndefined();
+  });
+});
diff --git a/src/renderer/src/util/extensionPaths.ts b/src/renderer/src/util/extensionPaths.ts
new file mode 100644
index 0000000..46ef365
--- /dev/null
+++ b/src/renderer/src/util/extensionPaths.ts
@@ -0,0 +1,45 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+// Node reports module filenames and stack frames with symlinks resolved, but
+// extension paths are built from userData and keep them. On Fedora Atomic
+// /home links to /var/home, so a plain prefix check misses every
+// user-installed extension. Cached because the require hook asks on every
+// require in the application.
+const realRoots = new Map<string, string>();
+
+function realRoot(root: string): string {
+  let real = realRoots.get(root);
+  if (real === undefined) {
+    try {
+      real = fs.realpathSync(root);
+    } catch {
+      real = root;
+    }
+    realRoots.set(root, real);
+  }
+  return real;
+}
+
+function spellings(root: string): string[] {
+  const real = realRoot(root);
+  return real === root ? [root] : [root, real];
+}
+
+export function isInsideExtensionRoot(filename: string, root: string): boolean {
+  return spellings(root).some((spelling) => filename.startsWith(spelling));
+}
+
+/**
+ * Name of the extension below root that a stack trace runs through, or
+ * undefined if the stack never enters root.
+ */
+export function extensionInStack(stack: string, root: string): string | undefined {
+  const spelling = spellings(root).find((iter) => stack.includes(`at ${iter}`));
+  if (spelling === undefined) {
+    return undefined;
+  }
+  const extPath = (spelling + path.sep).replace(/[\\]/g, "\\\\");
+  const re = new RegExp(`at ${extPath}(Vortex Extension Update - )?([^/\\\\]*)`);
+  return stack.match(re)?.[2] ?? "unknown";
+}
