+async function openSaveDirectory(api: types.IExtensionApi, savesPath: string, create = false) {
+  try {
+    if (create) await fs.ensureDirAsync(savesPath);
+    await util.opn(await resolveSaveDirectory(savesPath));
+  } catch (err) {
+    api.showErrorNotification("Failed to open savegame directory", err, {
+      allowReport: (err as any).code !== "ENOENT",
+    });
+  }
