+
+// The extension filesystem maps My Games into the selected Wine prefix. The
+// desktop opener and turbowalk need the resulting on-disk directory.
+export async function resolveSaveDirectory(savesPath: string): Promise<string> {
+  return process.platform === "linux" ? realpath(savesPath) : savesPath;
+}
