+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+const common = vi.hoisted(() => ({
+  applications: "",
+  refreshDesktopDatabase: vi.fn(),
+  getDefaultUrlSchemeHandler: vi.fn(),
+  setDefaultUrlSchemeHandler: vi.fn(),
+}));
+
+vi.mock("../../log", () => ({ log: vi.fn() }));
+vi.mock("./common", () => ({
+  applicationsDirectory: () => common.applications,
+  refreshDesktopDatabase: common.refreshDesktopDatabase,
+  getDefaultUrlSchemeHandler: common.getDefaultUrlSchemeHandler,
+  setDefaultUrlSchemeHandler: common.setDefaultUrlSchemeHandler,
+}));
+
+import { registerLinuxNxmProtocolHandler } from "./nxm";
+
+const options = { setAsDefault: true, executablePath: "/tmp/.mount_x/vortex", appPath: "" };
+
+describe.runIf(process.platform === "linux")("nxm links from an AppImage", () => {
+  let root: string;
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-nxm-"));
+    common.applications = path.join(root, "applications");
+    vi.stubEnv("NODE_ENV", "production");
+    vi.stubEnv("IS_FLATPAK", "");
+    vi.clearAllMocks();
+  });
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  it("registers a desktop entry that starts the AppImage file itself", () => {
+    const appImage = path.join(root, "My Apps", "Vortex-2.9.0-x86_64.AppImage");
+    vi.stubEnv("APPIMAGE", appImage);
+    common.getDefaultUrlSchemeHandler.mockReturnValue("org.mo2.desktop");
+
+    expect(registerLinuxNxmProtocolHandler(options)).toBe(true);
+
+    const desktop = fs.readFileSync(
+      path.join(common.applications, "com.nexusmods.vortex.appimage.desktop"),
+      "utf8",
+    );
+    const wrapper = path.join(common.applications, "com.nexusmods.vortex.appimage.sh");
+    expect(desktop).toContain(`Exec=${wrapper} %u\n`);
+    expect(desktop).toContain("MimeType=x-scheme-handler/nxm;\n");
+    expect(desktop).toContain("NoDisplay=true\n");
+    expect(fs.readFileSync(wrapper, "utf8")).toContain(`exec "${appImage}" "$@"\n`);
+    expect(fs.statSync(wrapper).mode & 0o111).not.toBe(0);
+    expect(common.refreshDesktopDatabase).toHaveBeenCalledWith(common.applications);
+    expect(common.setDefaultUrlSchemeHandler).toHaveBeenCalledWith(
+      "nxm",
+      "com.nexusmods.vortex.appimage.desktop",
+    );
+  });
+
+  it("follows the AppImage when it was moved or replaced", () => {
+    vi.stubEnv("APPIMAGE", path.join(root, "old.AppImage"));
+    registerLinuxNxmProtocolHandler(options);
+    common.refreshDesktopDatabase.mockClear();
+
+    vi.stubEnv("APPIMAGE", path.join(root, "new.AppImage"));
+    registerLinuxNxmProtocolHandler(options);
+
+    const wrapper = path.join(common.applications, "com.nexusmods.vortex.appimage.sh");
+    expect(fs.readFileSync(wrapper, "utf8")).toContain(`exec "${path.join(root, "new.AppImage")}"`);
+    expect(common.refreshDesktopDatabase).toHaveBeenCalledOnce();
+
+    common.refreshDesktopDatabase.mockClear();
+    registerLinuxNxmProtocolHandler(options);
+    expect(common.refreshDesktopDatabase).not.toHaveBeenCalled();
+  });
+
+  it("leaves package installs on the packaged desktop file", () => {
+    vi.stubEnv("APPIMAGE", "");
+    registerLinuxNxmProtocolHandler(options);
+    expect(fs.existsSync(common.applications)).toBe(false);
+    expect(common.setDefaultUrlSchemeHandler).toHaveBeenCalledWith(
+      "nxm",
+      "com.nexusmods.vortex.desktop",
+    );
+  });
+});
