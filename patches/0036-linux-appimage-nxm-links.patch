+/**
+ * Write the desktop entry an AppImage uses for nxm:// links. The wrapper runs the AppImage
+ * file, whose AppRun adds --download for nxm:// arguments. Vortex rewrites both on every
+ * registration, so moving or replacing the AppImage only needs one start of the new file.
+ */
+function ensureAppImageDesktopEntry(applicationsDir: string, appImage: string): boolean {
+  const wrapperPath = path.join(applicationsDir, APPIMAGE_WRAPPER_FILE_NAME);
+  const desktopFilePath = path.join(applicationsDir, APPIMAGE_DESKTOP_ID);
+
+  warnIfApplicationsPathNeedsEscaping(applicationsDir);
+
+  const wrapperChanged = writeFileIfChanged(
+    wrapperPath,
+    "#!/bin/sh\n" +
+      "unset LD_LIBRARY_PATH\n" +
+      "unset LD_PRELOAD\n" +
+      `exec "${escapeShellScriptArgument(appImage)}" "$@"\n`,
+    0o755,
+  );
+
+  // Hidden from menus: integrating the AppImage itself is left to AppImageLauncher or Gear Lever.
+  const desktopChanged = writeFileIfChanged(
+    desktopFilePath,
+    "[Desktop Entry]\n" +
+      "Type=Application\n" +
+      "Name=Vortex (AppImage)\n" +
+      "GenericName=Mod Manager\n" +
+      "Comment=Handles Nexus Mods download links for the Vortex AppImage\n" +
+      "NoDisplay=true\n" +
+      `Exec=${escapeDesktopExecFilePath(wrapperPath)} %u\n` +
+      `TryExec=${escapeDesktopFilePath(wrapperPath)}\n` +
+      "Icon=vortex\n" +
+      "Terminal=false\n" +
+      "MimeType=x-scheme-handler/nxm;\n" +
+      "StartupWMClass=Vortex\n",
+    0o755,
+  );
+
+  return wrapperChanged || desktopChanged;
+}
