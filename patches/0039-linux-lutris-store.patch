diff --git a/src/renderer/src/util/linux/lutris.ts b/src/renderer/src/util/linux/lutris.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/util/linux/lutris.ts
@@ -0,0 +1,349 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+import { load } from "js-yaml";
+
+import type { CompatibilityGame } from "../compatibilityPaths";
+import type { ToolCommand } from "./gameTools";
+import { findProgram } from "./heroic";
+import { canonicalPath } from "./steamLibraries";
+
+const FLATPAK_ID = "net.lutris.Lutris";
+
+export interface LutrisRoot {
+  dataPath: string;
+  configPath: string;
+  flatpak: boolean;
+}
+
+export interface LutrisGame {
+  /** Store-wide ID: the service's own ID (e.g. a GOG product ID), never Lutris' row ID. */
+  appid: string;
+  name: string;
+  /** The folder of the configured executable, or the game directory. */
+  gamePath: string;
+  gameStoreId: "lutris";
+  /** Lutris' database ID, used for lutris:rungameid. */
+  id: number;
+  slug: string;
+  directory?: string;
+  prefix?: string;
+  exe?: string;
+  /** Prefix and directory, as configured and resolved, for matching game folders. */
+  locations: string[];
+  /** The executable, as configured and resolved. */
+  exePaths: string[];
+  wineVersion?: string;
+  env: Record<string, string>;
+  root: LutrisRoot;
+}
+
+export function lutrisRoots(): LutrisRoot[] {
+  const home = os.homedir();
+  const flatpak = path.join(home, ".var/app", FLATPAK_ID);
+  return [
+    {
+      dataPath: path.join(process.env.XDG_DATA_HOME ?? path.join(home, ".local/share"), "lutris"),
+      configPath: path.join(process.env.XDG_CONFIG_HOME ?? path.join(home, ".config"), "lutris"),
+      flatpak: false,
+    },
+    {
+      dataPath: path.join(flatpak, "data/lutris"),
+      configPath: path.join(flatpak, "config/lutris"),
+      flatpak: true,
+    },
+  ];
+}
+
+function readYaml(file: string): any {
+  try {
+    return load(fs.readFileSync(file, "utf8"));
+  } catch {
+    return undefined;
+  }
+}
+
+function absolute(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const expanded = value.replace(/^~(?=\/|$)/, os.homedir());
+  return path.isAbsolute(expanded) ? path.normalize(expanded) : undefined;
+}
+
+function stringEnv(value: unknown): Record<string, string> {
+  if (value === null || typeof value !== "object") return {};
+  return Object.fromEntries(
+    Object.entries(value).flatMap(([key, entry]) =>
+      key && ["string", "number", "boolean"].includes(typeof entry) ? [[key, String(entry)]] : [],
+    ),
+  );
+}
+
+/** Lutris 0.5.17+ moved its configuration into the data directory; older setups keep it in ~/.config. */
+function configFile(root: LutrisRoot, ...parts: string[]): string | undefined {
+  return [root.configPath, root.dataPath]
+    .map((base) => path.join(base, ...parts))
+    .find((file) => fs.existsSync(file));
+}
+
+function isInside(root: string, candidate: string): boolean {
+  const relative = path.relative(root, candidate);
+  return (
+    relative === "" ||
+    (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
+  );
+}
+
+/**
+ * A path as configured and with symlinks resolved. Game folders are often
+ * linked into a prefix from another disk, so either form may be the one that
+ * lies inside the prefix.
+ */
+function aliases(input: string): string[] {
+  const resolved = path.resolve(input);
+  const canonical = canonicalPath(input);
+  return resolved === canonical ? [resolved] : [resolved, canonical];
+}
+
+function insideAny(roots: string[], candidates: string[]): boolean {
+  return roots.some((root) => candidates.some((candidate) => isInside(root, candidate)));
+}
+
+interface LutrisRow {
+  id: number;
+  name: string | null;
+  slug: string | null;
+  directory: string | null;
+  configpath: string | null;
+  service: string | null;
+  service_id: string | null;
+}
+
+function readRows(database: string): LutrisRow[] {
+  let db: DatabaseSync | undefined;
+  try {
+    db = new DatabaseSync(database, { readOnly: true });
+    // Only Windows games installed through Lutris' Wine runner have a prefix.
+    // Steam games imported by Lutris and native games stay with their own stores.
+    return db
+      .prepare(
+        "SELECT id, name, slug, directory, configpath, service, service_id FROM games " +
+          "WHERE installed = 1 AND runner = 'wine'",
+      )
+      .all() as unknown as LutrisRow[];
+  } catch {
+    // Lutris may be writing to its database; the next scan tries again.
+    return [];
+  } finally {
+    db?.close();
+  }
+}
+
+function gameRoot(exe: string | undefined, directory: string | undefined, row: LutrisRow) {
+  if (exe === undefined) return directory;
+  // GOG and Epic installs mark their root folder; game extensions expect that one.
+  const markers =
+    row.service === "gog" && row.service_id
+      ? [`goggame-${row.service_id}.info`]
+      : row.service === "egs"
+        ? [".egstore"]
+        : [];
+  const stop = directory ?? path.parse(exe).root;
+  for (let current = path.dirname(exe); isInside(stop, current); current = path.dirname(current)) {
+    if (markers.some((marker) => fs.existsSync(path.join(current, marker)))) return current;
+    if (current === stop || current === path.dirname(current)) break;
+  }
+  return path.dirname(exe);
+}
+
+export function readLutrisGames(): LutrisGame[] {
+  const games: LutrisGame[] = [];
+  for (const root of lutrisRoots()) {
+    const database = path.join(root.dataPath, "pga.db");
+    if (!fs.existsSync(database)) continue;
+    const runnerConfig = readYaml(configFile(root, "runners/wine.yml") ?? "") ?? {};
+    const systemConfig = readYaml(configFile(root, "system.yml") ?? "") ?? {};
+    for (const row of readRows(database)) {
+      if (!row.configpath || /[\\/]/.test(row.configpath)) continue;
+      const config = readYaml(configFile(root, "games", `${row.configpath}.yml`) ?? "");
+      if (config === undefined || config === null || typeof config !== "object") continue;
+      const directory = absolute(row.directory);
+      const prefix = absolute(config.game?.prefix);
+      const configuredExe = typeof config.game?.exe === "string" ? config.game.exe : undefined;
+      const exe =
+        absolute(configuredExe) ??
+        (configuredExe === undefined
+          ? undefined
+          : [directory, prefix]
+              .filter((base): base is string => base !== undefined)
+              .map((base) => path.join(base, configuredExe))
+              .find((candidate) => fs.existsSync(candidate)));
+      const location = gameRoot(exe, directory, row) ?? prefix;
+      if (location === undefined) continue;
+      const serviceId =
+        typeof row.service === "string" && row.service && row.service_id
+          ? row.service_id
+          : undefined;
+      games.push({
+        appid: serviceId ?? `lutris-${row.slug ?? row.id}`,
+        name: row.name ?? config.name ?? row.slug ?? String(row.id),
+        gamePath: canonicalPath(location),
+        gameStoreId: "lutris",
+        id: row.id,
+        slug: row.slug ?? "",
+        directory: directory && canonicalPath(directory),
+        prefix: prefix && canonicalPath(prefix),
+        exe: exe && canonicalPath(exe),
+        locations: [prefix, directory]
+          .filter((entry): entry is string => entry !== undefined)
+          .flatMap(aliases),
+        exePaths: exe ? aliases(exe) : [],
+        wineVersion:
+          typeof config.wine?.version === "string"
+            ? config.wine.version
+            : typeof runnerConfig.wine?.version === "string"
+              ? runnerConfig.wine.version
+              : undefined,
+        env: { ...stringEnv(systemConfig.system?.env), ...stringEnv(config.system?.env) },
+        root,
+      });
+    }
+  }
+  return games;
+}
+
+/** Lutris games whose prefix or install directory contains the game folder, or that start an executable inside it. */
+export function matchLutrisGames(gamePath: string | undefined): LutrisGame[] {
+  if (!gamePath) return [];
+  const targets = aliases(gamePath);
+  return readLutrisGames().filter(
+    (entry) => insideAny(entry.locations, targets) || insideAny(targets, entry.exePaths),
+  );
+}
+
+export function lutrisPrefixOf(entry: LutrisGame): string | undefined {
+  if (!entry.prefix) return undefined;
+  const direct = fs.existsSync(path.join(entry.prefix, "drive_c"));
+  const nested = fs.existsSync(path.join(entry.prefix, "pfx/drive_c"));
+  if (
+    direct &&
+    nested &&
+    canonicalPath(entry.prefix) !== canonicalPath(path.join(entry.prefix, "pfx"))
+  )
+    throw new Error("The Lutris prefix contains two different Windows installations");
+  if (direct) return entry.prefix;
+  return nested ? path.join(entry.prefix, "pfx") : undefined;
+}
+
+/** The prefix shared by every Lutris game that contains the selected game folder. */
+export function lutrisPrefix(game: CompatibilityGame): string | undefined {
+  const matches = matchLutrisGames(game.path);
+  // A game that was never launched has no prefix yet; that is not a conflict.
+  const prefixes = [
+    ...new Set(
+      matches
+        .map((entry) => lutrisPrefixOf(entry))
+        .filter((prefix): prefix is string => prefix !== undefined)
+        .map(canonicalPath),
+    ),
+  ];
+  if (prefixes.length > 1)
+    throw new Error(
+      "Several Lutris games with different prefixes contain this game. Set WINEPREFIX for it explicitly.",
+    );
+  return prefixes[0];
+}
+
+/**
+ * The Lutris game to launch: the one whose executable lies inside the selected
+ * game folder. Several games can share a prefix (e.g. a launcher and its games),
+ * so without a unique executable match the caller should not launch through Lutris.
+ */
+export function findLutrisLaunchGame(game: CompatibilityGame): LutrisGame | undefined {
+  if (!game.path) return undefined;
+  const targets = aliases(game.path);
+  const candidates = matchLutrisGames(game.path).filter((entry) =>
+    insideAny(targets, entry.exePaths),
+  );
+  return candidates.length === 1 ? candidates[0] : undefined;
+}
+
+export function lutrisLauncher(
+  flatpak: boolean,
+): { executable: string; args: string[] } | undefined {
+  if (!lutrisRoots().some((root) => root.flatpak === flatpak && fs.existsSync(root.dataPath)))
+    return undefined;
+  const executable = flatpak
+    ? findProgram("flatpak")
+    : findProgram(process.env.LUTRIS_BINARY ?? "lutris");
+  return executable ? { executable, args: flatpak ? ["run", FLATPAK_ID] : [] } : undefined;
+}
+
+export function lutrisLaunchCommand(entry: LutrisGame): ToolCommand {
+  const launcher = lutrisLauncher(entry.root.flatpak);
+  if (!launcher)
+    throw new Error("Lutris was not found. Install Lutris or set LUTRIS_BINARY to its executable.");
+  return {
+    executable: launcher.executable,
+    args: [...launcher.args, `lutris:rungameid/${entry.id}`],
+    options: { shell: false },
+  };
+}
+
+function wineBinary(entry: LutrisGame): string {
+  const version = entry.wineVersion;
+  if (!version) throw new Error("Select a Wine version for this game in Lutris");
+  if (version === "system") return "wine";
+  const configured = absolute(version);
+  if (configured && fs.existsSync(configured)) return configured;
+  const build = path.join(entry.root.dataPath, "runners/wine", version);
+  for (const binary of ["bin/wine", "bin/wine64"]) {
+    if (fs.existsSync(path.join(build, binary))) return path.join(build, binary);
+  }
+  if (/proton/i.test(version) || fs.existsSync(path.join(build, "proton")))
+    throw new Error(
+      `Running tools with Lutris' Proton (${version}) is not supported yet. Select a Wine version for this game in Lutris.`,
+    );
+  throw new Error(`Lutris' Wine version ${version} is not installed`);
+}
+
+/** Run a Windows tool with the Wine build and environment Lutris uses for the selected game. */
+export async function lutrisToolCommand(
+  command: ToolCommand,
+  selected: CompatibilityGame,
+): Promise<ToolCommand> {
+  const matches = matchLutrisGames(selected.path);
+  if (matches.length === 0) throw new Error("The selected game is not registered in Lutris");
+  const prefix = command.options.env?.WINEPREFIX ?? lutrisPrefix(selected);
+  if (!prefix || !fs.existsSync(path.join(prefix, "drive_c")))
+    throw new Error("The Lutris Wine prefix is unavailable. Launch the game once in Lutris.");
+  // A launcher and its games may share one prefix with different settings.
+  const launch = findLutrisLaunchGame(selected);
+  const versions = [...new Set(matches.map((entry) => entry.wineVersion))];
+  const entry = launch ?? (versions.length === 1 ? matches[0] : undefined);
+  if (!entry)
+    throw new Error(
+      "Several Lutris games share this prefix with different Wine versions. Set WINEPREFIX for the tool explicitly.",
+    );
+  let executable = wineBinary(entry);
+  const env: Record<string, string> = {
+    ...entry.env,
+    ...command.options.env,
+    WINEPREFIX: prefix,
+  };
+  let args = [command.executable, ...command.args];
+  if (entry.root.flatpak) {
+    const flatpak = findProgram("flatpak");
+    if (!flatpak) throw new Error("Flatpak was not found");
+    args = [
+      "run",
+      `--command=${executable}`,
+      ...Object.entries(env).map(([key, value]) => `--env=${key}=${value}`),
+      FLATPAK_ID,
+      ...args,
+    ];
+    executable = flatpak;
+  } else if (!findProgram(executable)) throw new Error(`Lutris' Wine is missing: ${executable}`);
+  return { executable, args, options: { ...command.options, shell: false, env } };
+}
