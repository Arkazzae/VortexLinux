+    expect(findLutrisLaunchGame({ path: hots, store: "lutris" })?.id).toBe(2);
+  });
+
+  it("matches a game folder linked into the prefix from another disk", async () => {
+    const prefix = prefixAt(path.join(home, "Games/battlenet"));
+    const disk = path.join(home, "disk/Games/Heroes of the Storm");
+    fs.mkdirSync(disk, { recursive: true });
