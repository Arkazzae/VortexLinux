+import Bluebird from "bluebird";
+
+import type { IExtensionApi } from "../types/IExtensionContext";
+import {
+  GameEntryNotFound,
+  GameStoreNotFound,
+  type IGameStore,
+  type IGameStoreSnapshot,
+} from "../types/IGameStore";
+import { registerCompatibilityStore, resetCompatibilityPathCache } from "./compatibilityPaths";
+import { registerGameToolRunner } from "./linux/gameTools";
+import {
+  lutrisLaunchCommand,
+  lutrisLauncher,
+  lutrisPrefix,
+  lutrisRoots,
+  lutrisToolCommand,
+  matchLutrisGames,
+  readLutrisGames,
+  type LutrisGame,
+} from "./linux/lutris";
+
+/**
+ * Windows games installed through Lutris' Wine runner. Games added by hand are
+ * identified by their folder, so Vortex can use the game's own prefix and Wine.
+ */
+export class LutrisStore implements IGameStore {
+  public readonly id = "lutris";
+  public readonly name = "Lutris";
+  // After the native stores, so a game they know is not claimed by Lutris.
+  public readonly priority = 70;
+  private games: LutrisGame[] | undefined;
+  private installed = false;
+  public constructor() {
+    registerCompatibilityStore(this.id, lutrisPrefix);
+    registerGameToolRunner(this.id, lutrisToolCommand);
+  }
+  public allGames(): Bluebird<LutrisGame[]> {
+    return Bluebird.try(() => {
+      if (this.games === undefined) {
+        this.games = readLutrisGames();
+        this.installed = lutrisRoots().some((root) => lutrisLauncher(root.flatpak) !== undefined);
+      }
+      return this.games;
+    });
+  }
+  public snapshot(): IGameStoreSnapshot {
+    return { entries: this.games ?? [], isInstalled: this.installed };
+  }
+  public reloadGames(): Bluebird<void> {
+    this.games = undefined;
+    resetCompatibilityPathCache();
+    return this.allGames().then(() => undefined);
+  }
+  private find(predicate: (game: LutrisGame) => boolean, query: string): Bluebird<LutrisGame> {
+    return this.allGames().then((games) => {
+      const matches = games.filter(predicate);
+      if (matches.length === 0) throw new GameEntryNotFound(query, this.id);
+      if (matches.length > 1)
+        throw new Error(
+          "Several Lutris games match this game. Select the game directory manually.",
+        );
+      return matches[0];
+    });
+  }
+  public findByAppId(id: string | string[]): Bluebird<LutrisGame> {
+    const ids = Array.isArray(id) ? id : [id];
+    return this.find((game) => ids.includes(game.appid), ids.join(", "));
+  }
+  public findByName(name: string): Bluebird<LutrisGame> {
+    return Bluebird.try(() => new RegExp(`^(?:${name})$`, "i")).then((pattern) =>
+      this.find((game) => pattern.test(game.name), name),
+    );
+  }
+  public identifyGame(gamePath: string): Bluebird<boolean> {
+    return Bluebird.try(() => matchLutrisGames(gamePath).length > 0).catch(() => false);
+  }
+  public getGameStorePath(): Bluebird<string | undefined> {
+    return Bluebird.resolve(
+      lutrisRoots()
+        .map((root) => lutrisLauncher(root.flatpak)?.executable)
+        .find(Boolean),
+    );
+  }
+  public isGameStoreInstalled(): Bluebird<boolean> {
+    return this.getGameStorePath().then(Boolean);
+  }
+  public isGameInstalled(name: string): Bluebird<boolean> {
+    return this.findByName(name)
+      .then(() => true)
+      .catch(GameEntryNotFound, () => false);
+  }
+  public launchGame(
+    appInfo: string | { appId: string; parameters?: string[] },
+    api?: IExtensionApi,
+  ): Bluebird<void> {
+    return this.isGameStoreInstalled()
+      .then((installed) => {
+        if (!installed) throw new GameStoreNotFound(this.name);
+        return this.findByAppId(typeof appInfo === "string" ? appInfo : appInfo.appId);
+      })
+      .then((game) => {
+        if (!api) throw new Error("Lutris launch requires the Vortex application API");
+        const command = lutrisLaunchCommand(game);
+        return api.runExecutable(command.executable, command.args, {
+          ...command.options,
+          cwd: game.gamePath,
+          suggestDeploy: true,
+        });
+      });
+  }
+}
