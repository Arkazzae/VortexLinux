+    fs.writeFileSync(path.join(hots, "HeroesSwitcher.exe"), "");
+    yaml(path.join(games, "hots-1.yml"), {
+      game: { exe: "drive_c/Program Files (x86)/Heroes of the Storm/HeroesSwitcher.exe", prefix },
