+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+import { dump } from "js-yaml";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { resetCompatibilityPathCache, selectedGamePrefix } from "./compatibilityPaths";
+import { resolveGameTool } from "./linux/gameTools";
+import {
+  findLutrisLaunchGame,
+  lutrisLaunchCommand,
+  lutrisPrefix,
+  lutrisRoots,
+  readLutrisGames,
+} from "./linux/lutris";
+import { LutrisStore } from "./Lutris";
+
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+
+interface Row {
+  id: number;
+  name: string;
+  slug: string;
+  runner?: string;
+  installed?: number;
+  directory?: string;
+  configpath?: string;
+  service?: string;
+  service_id?: string;
+}
+
+describe.runIf(process.platform === "linux")("Lutris integration", () => {
+  let home: string;
+  let data: string;
+  let config: string;
+  let games: string;
+  function database(rows: Row[], dataPath = data): void {
+    fs.mkdirSync(dataPath, { recursive: true });
+    const db = new DatabaseSync(path.join(dataPath, "pga.db"));
+    db.exec(
+      "CREATE TABLE games (id INTEGER PRIMARY KEY, name TEXT, slug TEXT, runner TEXT, " +
+        "installed INTEGER, directory TEXT, configpath TEXT, service TEXT, service_id TEXT)",
+    );
+    const insert = db.prepare(
+      "INSERT INTO games (id, name, slug, runner, installed, directory, configpath, service, service_id) " +
+        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+    );
+    for (const row of rows)
+      insert.run(
+        row.id,
+        row.name,
+        row.slug,
+        row.runner ?? "wine",
+        row.installed ?? 1,
+        row.directory ?? null,
+        row.configpath ?? null,
+        row.service ?? null,
+        row.service_id ?? null,
+      );
+    db.close();
+  }
+  function yaml(file: string, value: unknown): void {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, typeof value === "string" ? value : dump(value));
+  }
+  function prefixAt(location: string): string {
+    fs.mkdirSync(path.join(location, "drive_c/users"), { recursive: true });
+    return location;
+  }
+  function program(name: string): string {
+    const binary = path.join(home, "bin", name);
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.writeFileSync(binary, "#!/bin/sh\n", { mode: 0o755 });
+    return binary;
+  }
+  function wineBuild(version: string, root = data): string {
+    const binary = path.join(root, "runners/wine", version, "bin/wine");
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.writeFileSync(binary, "#!/bin/sh\n", { mode: 0o755 });
+    return binary;
+  }
+  /** A GOG game installed by Lutris inside its own prefix. */
+  function gogGame(id = 3, slug = "example") {
+    const prefix = prefixAt(path.join(home, "Games", slug));
+    const gameRoot = path.join(prefix, "drive_c/GOG Games/Example Game");
+    fs.mkdirSync(path.join(gameRoot, "bin/x64"), { recursive: true });
+    fs.writeFileSync(path.join(gameRoot, "bin/x64/Example.exe"), "");
+    fs.writeFileSync(path.join(gameRoot, "goggame-1207658691.info"), "{}");
+    database([
+      {
+        id,
+        name: "Example Game",
+        slug,
+        directory: prefix,
+        configpath: `${slug}-1700000000`,
+        service: "gog",
+        service_id: "1207658691",
+      },
+    ]);
+    yaml(path.join(games, `${slug}-1700000000.yml`), {
+      game: { exe: "drive_c/GOG Games/Example Game/bin/x64/Example.exe", prefix },
+      system: { env: { DXVK_HUD: "compiler", GAME_VALUE: 1 } },
+      wine: { version: "wine-ge-8-26" },
+    });
+    return { prefix, gameRoot };
+  }
+
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-lutris-"));
+    vi.mocked(os.homedir).mockReturnValue(home);
+    vi.stubEnv("XDG_DATA_HOME", path.join(home, ".local/share"));
+    vi.stubEnv("XDG_CONFIG_HOME", path.join(home, ".config"));
+    vi.stubEnv("PATH", path.join(home, "bin"));
+    vi.stubEnv("LUTRIS_BINARY", "lutris");
+    [{ dataPath: data, configPath: config }] = lutrisRoots();
+    games = path.join(config, "games");
+    resetCompatibilityPathCache();
+  });
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    resetCompatibilityPathCache();
+    fs.rmSync(home, { recursive: true, force: true });
+  });
+
+  it("reads installed Wine games only and finds the GOG root of a nested executable", () => {
+    const { gameRoot } = gogGame();
+    const db = new DatabaseSync(path.join(data, "pga.db"));
+    const insert = db.prepare(
+      "INSERT INTO games (id, name, slug, runner, installed, directory, configpath) VALUES (?, ?, ?, ?, ?, ?, ?)",
+    );
+    // Lutris imports Steam games and runs native ones without a prefix.
+    insert.run(4, "Steam Game", "steam-game", "steam", 1, path.join(home, "steam"), "steam-game-1");
+    insert.run(5, "Native", "native", "linux", 1, path.join(home, "native"), "native-1");
+    insert.run(6, "Removed", "removed", "wine", 0, path.join(home, "removed"), "removed-1");
+    db.close();
+    expect(readLutrisGames()).toEqual([
+      expect.objectContaining({
+        appid: "1207658691",
+        id: 3,
+        name: "Example Game",
+        gameStoreId: "lutris",
+        gamePath: gameRoot,
+        wineVersion: "wine-ge-8-26",
+        env: { DXVK_HUD: "compiler", GAME_VALUE: "1" },
+      }),
+    ]);
+  });
+
+  it("never exposes Lutris' row ID as a store ID", () => {
+    const prefix = prefixAt(path.join(home, "Games/manual"));
+    database([
+      { id: 220, name: "Manual", slug: "manual", directory: prefix, configpath: "manual-1" },
+    ]);
+    yaml(path.join(games, "manual-1.yml"), {
+      game: { exe: path.join(prefix, "game.exe"), prefix },
+    });
+    expect(readLutrisGames().map((game) => game.appid)).toEqual(["lutris-manual"]);
+  });
+
+  it("reads PyYAML's folded long paths and configuration kept in the data directory", () => {
+    const prefix = prefixAt(path.join(home, "Games/long"));
+    const exe = path.join(
+      prefix,
+      "drive_c/Program Files/A Publisher With A Long Name/A Game Title That Is Long Enough To Wrap/game.exe",
+    );
+    fs.mkdirSync(path.dirname(exe), { recursive: true });
+    fs.writeFileSync(exe, "");
+    database([{ id: 1, name: "Long", slug: "long", directory: prefix, configpath: "long-1" }]);
+    const [head, tail] = [
+      exe.slice(0, exe.indexOf(" Long Enough")),
+      exe.slice(exe.indexOf(" Long Enough") + 1),
+    ];
+    yaml(
+      path.join(data, "games/long-1.yml"),
+      `game:\n  exe: ${head}\n    ${tail}\n  prefix: ${prefix}\nwine:\n  version: system\n`,
+    );
+    expect(readLutrisGames()[0]).toMatchObject({ exe, gamePath: path.dirname(exe) });
+  });
+
+  it("returns no games while the database cannot be read", () => {
+    fs.mkdirSync(data, { recursive: true });
+    fs.writeFileSync(path.join(data, "pga.db"), "not a database");
+    expect(readLutrisGames()).toEqual([]);
+  });
+
+  it("identifies a game folder inside the prefix and resolves its prefix", async () => {
+    const { prefix, gameRoot } = gogGame();
+    const store = new LutrisStore();
+    expect(await store.identifyGame(path.join(gameRoot, "Data"))).toBe(true);
+    expect(await store.identifyGame(path.join(home, "elsewhere"))).toBe(false);
+    expect(lutrisPrefix({ path: gameRoot, store: "lutris" })).toBe(prefix);
+    expect(selectedGamePrefix({ path: gameRoot, store: "lutris", executable: "Example.exe" })).toBe(
+      prefix,
+    );
+    expect((await store.findByAppId(["220", "1207658691"])).id).toBe(3);
+    expect((await store.findByName("example game")).id).toBe(3);
+  });
+
+  it("shares one prefix between a launcher and its games, but launches only an exact match", () => {
+    const prefix = prefixAt(path.join(home, "Games/battlenet"));
+    const launcher = path.join(prefix, "drive_c/Program Files (x86)/Battle.net");
+    const hots = path.join(prefix, "drive_c/Program Files (x86)/Heroes of the Storm");
+    fs.mkdirSync(launcher, { recursive: true });
+    fs.mkdirSync(hots, { recursive: true });
+    fs.writeFileSync(path.join(launcher, "Battle.net.exe"), "");
+    database([
+      {
+        id: 1,
+        name: "Battle.net",
+        slug: "battlenet",
+        directory: prefix,
+        configpath: "battlenet-1",
+      },
+      { id: 2, name: "Heroes of the Storm", slug: "hots", directory: prefix, configpath: "hots-1" },
+    ]);
+    for (const name of ["battlenet-1", "hots-1"])
+      yaml(path.join(games, `${name}.yml`), {
+        game: { exe: "drive_c/Program Files (x86)/Battle.net/Battle.net.exe", prefix },
+        wine: { version: "wine-staging-x86_64" },
