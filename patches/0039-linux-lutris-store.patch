+    expect(await new LutrisStore().identifyGame(linked)).toBe(true);
+    expect(lutrisPrefix({ path: linked, store: "lutris" })).toBe(prefix);
+    expect(findLutrisLaunchGame({ path: linked, store: "lutris" })?.id).toBe(2);
+    // The resolved folder on the other disk is the same game.
