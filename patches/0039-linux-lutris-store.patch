+    yaml(path.join(games, "proton-1.yml"), { game: { prefix } });
+    expect(lutrisPrefix({ path: path.join(prefix, "pfx/drive_c/Game"), store: "lutris" })).toBe(
+      path.join(prefix, "pfx"),
+    );
+  });
+
+  it("launches through the native or Flatpak Lutris client", () => {
+    gogGame(7);
+    const lutris = program("lutris");
+    const [game] = readLutrisGames();
