diff --git a/src/renderer/src/extensions/hardlink_activator/prefixDeploymentTarget.test.ts b/src/renderer/src/extensions/hardlink_activator/prefixDeploymentTarget.test.ts
new file mode 100644
--- /dev/null
+++ b/src/renderer/src/extensions/hardlink_activator/prefixDeploymentTarget.test.ts
@@ -0,0 +1,129 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { makeRealDeploymentMethod } from "../../test-utils/builders";
+import {
+  resetCompatibilityPathCache,
+  setCompatibilityGameProvider,
+} from "../../util/compatibilityPaths";
+import type * as selectors from "../../util/selectors";
+import type * as volume from "../../util/volume";
+import type * as modSelectors from "../mod_management/selectors";
+import moveInit from "../move_activator";
+import hardlinkInit from "./index";
+
+// Real devices can't be created in a test: every path below one of these roots
+// counts as the staging folder's drive, anything else as another drive.
+const fixture = vi.hoisted(() => ({
+  stagingDrive: [] as string[],
+  staging: "",
+  modPaths: {} as Record<string, string>,
+}));
+
+vi.mock("../../util/volume", async (original) => {
+  const actual = await original<typeof volume>();
+  const nodePath = await import("node:path");
+  return {
+    ...actual,
+    getPathDevice: (input: string) =>
+      fixture.stagingDrive.some((root) => input === root || input.startsWith(root + nodePath.sep))
+        ? 1
+        : 2,
+  };
+});
+
+vi.mock("../gamemode_management/util/getGame", () => ({
+  getGame: () => ({ id: "baldursgate3", getModPaths: () => fixture.modPaths }),
+}));
+
+vi.mock("../../util/selectors", async (original) => ({
+  ...(await original<typeof selectors>()),
+  installPathForGame: () => fixture.staging,
+}));
+
+vi.mock("../mod_management/selectors", async (original) => ({
+  ...(await original<typeof modSelectors>()),
+  installPathForGame: () => fixture.staging,
+}));
+
+const identity = (input: string) => input;
+const GAME = "baldursgate3";
+
+describe.runIf(process.platform === "linux")(
+  "deployment methods on a mod path inside the game's prefix",
+  () => {
+    let home: string;
+    let prefix: string;
+    let gameDir: string;
+    let linuxModPath: string;
+    let state: any;
+
+    beforeEach(() => {
+      home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-prefix-target-"));
+      prefix = path.join(home, "steamapps/compatdata/1086940/pfx");
+      gameDir = path.join(home, "steamapps/common/Baldurs Gate 3");
+      fixture.staging = path.join(home, "staging/baldursgate3");
+      // what the game extension asks for: AppData\Local as Vortex maps it on Linux
+      linuxModPath = path.join(home, "Local/Larian Studios/Baldur's Gate 3/Mods");
+      fixture.modPaths = { "": linuxModPath };
+
+      // the game ran once through Proton, so its profile folder exists in the prefix
+      fs.mkdirSync(
+        path.join(prefix, "drive_c/users/steamuser/AppData/Local/Larian Studios/Baldur's Gate 3"),
+        { recursive: true },
+      );
+      fs.mkdirSync(gameDir, { recursive: true });
+      fs.mkdirSync(fixture.staging, { recursive: true });
+      // the staging folder, the game and the prefix share one drive; home is another
+      fixture.stagingDrive = [path.join(home, "staging"), path.join(home, "steamapps")];
+
+      vi.stubEnv("VORTEX_LINUX_APPDATA", path.join(home, ".config"));
+      vi.stubEnv("VORTEX_LINUX_LOCAL_APPDATA", path.join(home, "Local"));
+      vi.stubEnv("VORTEX_LINUX_DOCUMENTS", path.join(home, "Documents"));
+      vi.stubEnv("VORTEX_COMPAT_PREFIXES", "");
+      setCompatibilityGameProvider(() => ({ path: gameDir, environment: { WINEPREFIX: prefix } }));
+
+      state = { settings: { gameMode: { discovered: { [GAME]: { path: gameDir } } } } };
+    });
+
+    afterEach(() => {
+      setCompatibilityGameProvider(undefined);
+      resetCompatibilityPathCache();
+      vi.unstubAllEnvs();
+      fs.rmSync(home, { force: true, recursive: true });
+    });
+
+    it.each([
+      ["hardlink", hardlinkInit],
+      ["move", moveInit],
+    ])("%s deployment compares the staging drive with the prefix", (_name, init) => {
+      const method = makeRealDeploymentMethod({} as any, init);
+
+      expect(method.isSupported(state, GAME, "")).toBeUndefined();
+    });
+
+    it("still refuses hardlinks when the prefix is on another drive than staging", () => {
+      fixture.stagingDrive = [path.join(home, "staging")];
+      const method = makeRealDeploymentMethod({} as any, hardlinkInit);
+
+      const reason = method.isSupported(state, GAME, "");
+
+      expect(reason?.description(identity as any)).toMatch(/same drive/);
+    });
+
+    it("reports a missing prefix instead of a write permission problem", () => {
+      setCompatibilityGameProvider(() => ({
+        path: gameDir,
+        environment: { WINEPREFIX: path.join(home, "missing") },
+      }));
+      const method = makeRealDeploymentMethod({} as any, hardlinkInit);
+
+      const reason = method.isSupported(state, GAME, "");
+
+      expect(reason?.description(identity as any)).toMatch(/unavailable/);
+    });
+  },
+);
