+function prefixLastUsed(compatDataPath: string): number {
+  try {
+    // Proton touches this file every time it starts the game.
+    return fs.statSync(path.join(compatDataPath, "pfx.lock")).mtimeMs;
+  } catch {
+    return 0;
+  }
+}
+
+/**
+ * Where Steam keeps a game's Proton data. That can be another library than the game's,
+ * for example after moving the game to an SD card. With several, the one used last counts,
+ * and a game without any gets the folder next to it.
+ */
+export function findCompatDataPath(
+  appId: string,
+  steamAppsPath: string,
+  libraries: Iterable<string>,
+): string {
+  const beside = path.join(steamAppsPath, "compatdata", appId);
+  const elsewhere = [...libraries].map((library) =>
+    path.join(library, "steamapps", "compatdata", appId),
+  );
+  return (
+    [...new Set([beside, ...elsewhere])]
+      .filter((candidate) => fs.existsSync(path.join(candidate, "pfx")))
+      .sort((lhs, rhs) => prefixLastUsed(rhs) - prefixLastUsed(lhs))[0] ?? beside
+  );
+}
