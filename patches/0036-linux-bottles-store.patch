+++ b/src/renderer/src/util/linux/bottles.ts
@@ -0,0 +1,323 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { load } from "js-yaml";
+
+import type { CompatibilityGame } from "../compatibilityPaths";
+import type { ToolCommand } from "./gameTools";
+import { findProgram } from "./heroic";
+import { canonicalPath } from "./steamLibraries";
+
+const FLATPAK_ID = "com.usebottles.bottles";
+
+export interface BottlesRoot {
+  /** Bottles' data directory, holding runners and the default bottles folder. */
+  dataPath: string;
+  flatpak: boolean;
+}
+
+export interface BottlesProgram {
+  id: string;
+  name: string;
+  exe: string;
+  /** The executable, as configured and resolved. */
+  exePaths: string[];
+}
+
+export interface Bottle {
+  /** The name bottles-cli addresses the bottle by. */
+  name: string;
+  path: string;
+  /** The bottle folder, as configured and resolved. */
+  locations: string[];
+  runner?: string;
+  env: Record<string, string>;
+  programs: BottlesProgram[];
+  root: BottlesRoot;
+  /** Bottles keys bottles by name, so bottles-cli cannot address a duplicate. */
+  duplicateName: boolean;
+}
+
+export interface BottlesGame {
+  appid: string;
+  name: string;
+  gamePath: string;
+  gameStoreId: "bottles";
+  bottle: Bottle;
+  program: BottlesProgram;
+}
+
+export function bottlesRoots(): BottlesRoot[] {
+  const home = os.homedir();
+  return [
+    {
+      dataPath: path.join(process.env.XDG_DATA_HOME ?? path.join(home, ".local/share"), "bottles"),
+      flatpak: false,
+    },
+    { dataPath: path.join(home, ".var/app", FLATPAK_ID, "data/bottles"), flatpak: true },
+  ];
+}
+
+function readYaml(file: string): any {
+  try {
+    return load(fs.readFileSync(file, "utf8"));
+  } catch {
+    return undefined;
+  }
+}
+
+function absolute(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const expanded = value.replace(/^~(?=\/|$)/, os.homedir());
+  return path.isAbsolute(expanded) ? path.normalize(expanded) : undefined;
+}
+
+function isInside(root: string, candidate: string): boolean {
+  const relative = path.relative(root, candidate);
+  return (
+    relative === "" ||
+    (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
+  );
+}
+
+/**
+ * A path as configured and with symlinks resolved. Game folders are often
+ * linked into a prefix from another disk, so either form may be the one that
+ * lies inside the prefix.
+ */
+function aliases(input: string): string[] {
+  const resolved = path.resolve(input);
+  const canonical = canonicalPath(input);
+  return resolved === canonical ? [resolved] : [resolved, canonical];
+}
+
+function insideAny(roots: string[], candidates: string[]): boolean {
+  return roots.some((root) => candidates.some((candidate) => isInside(root, candidate)));
+}
+
+function stringEnv(value: unknown): Record<string, string> {
+  if (value === null || typeof value !== "object") return {};
+  return Object.fromEntries(
+    Object.entries(value).flatMap(([key, entry]) =>
+      key && ["string", "number", "boolean"].includes(typeof entry) ? [[key, String(entry)]] : [],
+    ),
+  );
+}
+
+/** Bottles stores program paths as host paths, older entries as C:\ paths. */
+function programExe(bottlePath: string, value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const drive = /^[cC]:[\\/](.*)$/.exec(value);
+  if (drive) return path.join(bottlePath, "drive_c", ...drive[1].split(/[\\/]+/));
+  return absolute(value);
+}
+
+function bottlesDirectory(root: BottlesRoot): string {
+  const custom = absolute(readYaml(path.join(root.dataPath, "data.yml"))?.custom_bottles_path);
+  return custom && fs.existsSync(custom) ? custom : path.join(root.dataPath, "bottles");
+}
+
+export function readBottles(): Bottle[] {
+  const bottles: Bottle[] = [];
+  for (const root of bottlesRoots()) {
+    const directory = bottlesDirectory(root);
+    let entries: string[];
+    try {
+      entries = fs.readdirSync(directory);
+    } catch {
+      continue;
+    }
+    const found: Bottle[] = [];
+    for (const entry of entries) {
+      // A bottle stored elsewhere leaves a placeholder pointing at it.
+      const placeholder = absolute(readYaml(path.join(directory, entry, "placeholder.yml"))?.Path);
+      const location = placeholder ?? path.join(directory, entry);
+      const config = readYaml(path.join(location, "bottle.yml"));
+      if (config === undefined || config === null || typeof config !== "object") continue;
+      // Steam bottles wrap a Proton prefix that the Steam store already handles.
+      if (config.Environment === "Steam" || typeof config.Name !== "string") continue;
+      const bottlePath = canonicalPath(location);
+      const programs = Object.entries(
+        config.External_Programs !== null && typeof config.External_Programs === "object"
+          ? config.External_Programs
+          : {},
+      ).flatMap(([key, program]: [string, any]) => {
+        const exe = programExe(bottlePath, program?.path);
+        const name = typeof program?.name === "string" ? program.name : undefined;
+        return exe && name
+          ? [
+              {
+                id: String(program?.id ?? key),
+                name,
+                exe: canonicalPath(exe),
+                exePaths: aliases(exe),
+              },
+            ]
+          : [];
+      });
+      found.push({
+        name: config.Name,
+        path: bottlePath,
+        locations: aliases(location),
+        runner: typeof config.Runner === "string" ? config.Runner : undefined,
+        env: stringEnv(config.Environment_Variables),
+        programs,
+        root,
+        duplicateName: false,
+      });
+    }
+    for (const bottle of found) {
+      bottle.duplicateName = found.filter((other) => other.name === bottle.name).length > 1;
+    }
+    bottles.push(...found);
+  }
+  return bottles;
+}
+
+function gameRoot(exe: string, bottlePath: string): string {
+  // GOG games mark their root folder; game extensions expect that one.
+  const stop = isInside(bottlePath, exe) ? bottlePath : path.parse(exe).root;
+  for (let current = path.dirname(exe); isInside(stop, current); current = path.dirname(current)) {
+    try {
+      if (fs.readdirSync(current).some((name) => /^goggame-\d+\.info$/.test(name))) return current;
+    } catch {
+      break;
+    }
+    if (current === stop || current === path.dirname(current)) break;
+  }
+  return path.dirname(exe);
+}
+
+/** Every program added to a bottle, as a game store entry. */
+export function readBottlesGames(): BottlesGame[] {
+  return readBottles().flatMap((bottle) =>
+    bottle.programs.map((program) => ({
+      // Bottles has no store IDs; this can never match another store's game.
+      appid: `bottles-${bottle.name}-${program.id}`,
+      name: program.name,
+      gamePath: canonicalPath(gameRoot(program.exe, bottle.path)),
+      gameStoreId: "bottles" as const,
+      bottle,
+      program,
+    })),
+  );
+}
+
+/** Bottles that contain the game folder, or run a program from inside it. */
+export function matchBottles(gamePath: string | undefined): Bottle[] {
+  if (!gamePath) return [];
+  const targets = aliases(gamePath);
+  return readBottles().filter(
+    (bottle) =>
+      insideAny(bottle.locations, targets) ||
+      bottle.programs.some((program) => insideAny(targets, program.exePaths)),
+  );
+}
+
+function selectedBottle(game: CompatibilityGame): Bottle | undefined {
+  const matches = matchBottles(game.path);
+  if (new Set(matches.map((bottle) => bottle.path)).size > 1)
+    throw new Error("Several bottles contain this game. Set WINEPREFIX for it explicitly.");
+  return matches[0];
+}
+
+export function bottlesPrefix(game: CompatibilityGame): string | undefined {
+  const bottle = selectedBottle(game);
+  return bottle && fs.existsSync(path.join(bottle.path, "drive_c")) ? bottle.path : undefined;
+}
+
+/** The program to start: the only one in the selected bottle whose executable is inside the game folder. */
+export function findBottlesLaunch(
+  game: CompatibilityGame,
+): { bottle: Bottle; program: BottlesProgram } | undefined {
+  if (!game.path) return undefined;
+  const bottle = selectedBottle(game);
+  if (!bottle) return undefined;
+  const targets = aliases(game.path);
+  const programs = bottle.programs.filter((program) => insideAny(targets, program.exePaths));
+  return programs.length === 1 ? { bottle, program: programs[0] } : undefined;
+}
+
+export function bottlesCli(flatpak: boolean): { executable: string; args: string[] } | undefined {
+  if (!bottlesRoots().some((root) => root.flatpak === flatpak && fs.existsSync(root.dataPath)))
+    return undefined;
+  const executable = flatpak
+    ? findProgram("flatpak")
+    : findProgram(process.env.BOTTLES_CLI_BINARY ?? "bottles-cli");
+  return executable
+    ? { executable, args: flatpak ? ["run", "--command=bottles-cli", FLATPAK_ID] : [] }
+    : undefined;
+}
+
+/** bottles-cli joins arguments into a shell command line, so each needs quoting. */
+export function shellQuote(value: string): string {
+  return `'${value.replaceAll("'", `'\\''`)}'`;
+}
+
+export function bottlesLaunchCommand(
+  bottle: Bottle,
+  program: BottlesProgram,
+  args: string[] = [],
+): ToolCommand {
+  if (bottle.duplicateName)
+    throw new Error(
+      `Several bottles are named "${bottle.name}". Rename them in Bottles so Vortex can start the right one.`,
+    );
+  const cli = bottlesCli(bottle.root.flatpak);
+  if (!cli)
+    throw new Error(
+      "bottles-cli was not found. Install Bottles or set BOTTLES_CLI_BINARY to bottles-cli.",
+    );
+  return {
+    executable: cli.executable,
+    args: [...cli.args, "run", "-b", bottle.name, "-p", program.name, ...args.map(shellQuote)],
+    options: { shell: false },
+  };
+}
+
+function runnerBinary(bottle: Bottle): string {
+  const runner = bottle.runner;
+  if (!runner) throw new Error(`Select a runner for the "${bottle.name}" bottle in Bottles`);
+  if (runner.startsWith("sys-")) return "wine";
+  const build = path.join(bottle.root.dataPath, "runners", runner);
+  for (const binary of ["bin/wine", "bin/wine64"]) {
+    if (fs.existsSync(path.join(build, binary))) return path.join(build, binary);
+  }
+  if (/proton/i.test(runner) || fs.existsSync(path.join(build, "proton")))
+    throw new Error(
+      `Running tools with Bottles' Proton runner (${runner}) is not supported yet. Select a Wine runner for the bottle in Bottles.`,
+    );
+  throw new Error(`Bottles' runner ${runner} is not installed`);
+}
+
+/**
+ * Run a Windows tool with the bottle's own runner. bottles-cli would return as
+ * soon as the tool starts, and Vortex has to know when a tool exits.
+ */
+export async function bottlesToolCommand(
+  command: ToolCommand,
+  selected: CompatibilityGame,
+): Promise<ToolCommand> {
+  const bottle = selectedBottle(selected);
+  if (!bottle) throw new Error("The selected game is not in a Bottles bottle");
+  const prefix = command.options.env?.WINEPREFIX ?? bottlesPrefix(selected);
+  if (!prefix || !fs.existsSync(path.join(prefix, "drive_c")))
+    throw new Error("The bottle's Wine prefix is unavailable");
+  let executable = runnerBinary(bottle);
+  const env: Record<string, string> = { ...bottle.env, ...command.options.env, WINEPREFIX: prefix };
+  let args = [command.executable, ...command.args];
+  if (bottle.root.flatpak) {
+    const flatpak = findProgram("flatpak");
+    if (!flatpak) throw new Error("Flatpak was not found");
+    args = [
+      "run",
+      `--command=${executable}`,
+      ...Object.entries(env).map(([key, value]) => `--env=${key}=${value}`),
+      FLATPAK_ID,
+      ...args,
+    ];
+    executable = flatpak;
+  } else if (!findProgram(executable)) throw new Error(`Bottles' runner is missing: ${executable}`);
+  return { executable, args, options: { ...command.options, shell: false, env } };
+}
