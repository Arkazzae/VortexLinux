+    expect((await store.findByName("example game")).program.id).toBe("1f0e");
+  });
+
+  it("matches a game outside the bottle through its program and rejects two bottles", () => {
+    const { location } = bottle("Gaming");
+    const outside = path.join(home, "Games/Outside");
+    fs.mkdirSync(outside, { recursive: true });
+    fs.writeFileSync(path.join(outside, "Outside.exe"), "");
+    const config = path.join(location, "bottle.yml");
+    const parsed = {
+      ...(load(fs.readFileSync(config, "utf8")) as object),
+    } as any;
+    parsed.External_Programs.other = {
+      id: "other",
+      name: "Outside",
+      path: path.join(outside, "Outside.exe"),
+    };
+    yaml(config, parsed);
+    expect(bottlesPrefix({ path: outside, store: "bottles" })).toBe(location);
+    expect(findBottlesLaunch({ path: outside, store: "bottles" })?.program.name).toBe("Outside");
+
+    const second = bottle("Second");
+    const shared = path.join(second.location, "bottle.yml");
+    const secondConfig = load(fs.readFileSync(shared, "utf8")) as any;
+    secondConfig.External_Programs.other = {
+      id: "x",
+      name: "Outside",
+      path: path.join(outside, "Outside.exe"),
+    };
+    yaml(shared, secondConfig);
+    expect(() => bottlesPrefix({ path: outside, store: "bottles" })).toThrow(/Several bottles/);
+  });
+
+  it("matches a game folder linked into the bottle from another disk", () => {
+    const { location } = bottle("Gaming");
+    const disk = path.join(home, "disk/Linked Game");
+    fs.mkdirSync(disk, { recursive: true });
+    const linked = path.join(location, "drive_c/Games/Linked Game");
+    fs.mkdirSync(path.dirname(linked), { recursive: true });
+    fs.symlinkSync(disk, linked);
+    expect(bottlesPrefix({ path: linked, store: "bottles" })).toBe(location);
+  });
+
+  it("starts a program through bottles-cli with shell-safe arguments", () => {
+    const cli = program("bottles-cli");
+    const { gameRoot } = bottle("Gaming");
+    const launch = findBottlesLaunch({ path: gameRoot, store: "bottles" })!;
+    const args = ["-skip intro", "it's", "$(touch nope)"];
