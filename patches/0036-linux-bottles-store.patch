+      "run",
+      `--command=${wine}`,
+      "--env=DXVK_ASYNC=1",
+      "--env=SHARED=yes",
+      `--env=WINEPREFIX=${location}`,
+      "com.usebottles.bottles",
+      path.join(gameRoot, "Tool.exe"),
