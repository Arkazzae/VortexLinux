+      "--command=bottles-cli",
+      "com.usebottles.bottles",
+      "run",
+      "-b",
+      "Gaming",
+      "-p",
+      "Example Game",
+    ]);
+    const command = await resolveGameTool(
+      path.join(gameRoot, "Tool.exe"),
+      [],
+      {},
+      {
+        path: gameRoot,
+        store: "bottles",
+      },
