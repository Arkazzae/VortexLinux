+import Bluebird from "bluebird";
+
+import type { IExtensionApi } from "../types/IExtensionContext";
+import {
+  GameEntryNotFound,
+  GameStoreNotFound,
+  type IGameStore,
+  type IGameStoreSnapshot,
+} from "../types/IGameStore";
+import { registerCompatibilityStore, resetCompatibilityPathCache } from "./compatibilityPaths";
+import {
+  bottlesCli,
+  bottlesLaunchCommand,
+  bottlesPrefix,
+  bottlesRoots,
+  bottlesToolCommand,
+  matchBottles,
+  readBottlesGames,
+  type BottlesGame,
+} from "./linux/bottles";
+import { registerGameToolRunner } from "./linux/gameTools";
+
+/**
+ * Windows games installed in a Bottles bottle. A game folder inside a bottle, or
+ * one holding a program added to a bottle, uses that bottle's prefix and runner.
+ */
+export class BottlesStore implements IGameStore {
+  public readonly id = "bottles";
+  public readonly name = "Bottles";
+  // After the native stores and Lutris, so a game they know is not claimed by Bottles.
+  public readonly priority = 75;
+  private games: BottlesGame[] | undefined;
+  private installed = false;
+  public constructor() {
+    registerCompatibilityStore(this.id, bottlesPrefix);
+    registerGameToolRunner(this.id, bottlesToolCommand);
+  }
+  public allGames(): Bluebird<BottlesGame[]> {
+    return Bluebird.try(() => {
+      if (this.games === undefined) {
+        this.games = readBottlesGames();
+        this.installed = bottlesRoots().some((root) => bottlesCli(root.flatpak) !== undefined);
+      }
+      return this.games;
+    });
+  }
+  public snapshot(): IGameStoreSnapshot {
+    return { entries: this.games ?? [], isInstalled: this.installed };
+  }
+  public reloadGames(): Bluebird<void> {
+    this.games = undefined;
+    resetCompatibilityPathCache();
+    return this.allGames().then(() => undefined);
+  }
+  private find(predicate: (game: BottlesGame) => boolean, query: string): Bluebird<BottlesGame> {
+    return this.allGames().then((games) => {
+      const matches = games.filter(predicate);
+      if (matches.length === 0) throw new GameEntryNotFound(query, this.id);
+      if (matches.length > 1)
+        throw new Error(
+          "Several Bottles programs match this game. Select the game directory manually.",
+        );
+      return matches[0];
+    });
+  }
+  public findByAppId(id: string | string[]): Bluebird<BottlesGame> {
+    const ids = Array.isArray(id) ? id : [id];
+    return this.find((game) => ids.includes(game.appid), ids.join(", "));
+  }
+  public findByName(name: string): Bluebird<BottlesGame> {
+    return Bluebird.try(() => new RegExp(`^(?:${name})$`, "i")).then((pattern) =>
+      this.find((game) => pattern.test(game.name), name),
+    );
+  }
+  public identifyGame(gamePath: string): Bluebird<boolean> {
+    return Bluebird.try(() => matchBottles(gamePath).length > 0).catch(() => false);
+  }
+  public getGameStorePath(): Bluebird<string | undefined> {
+    return Bluebird.resolve(
+      bottlesRoots()
+        .map((root) => bottlesCli(root.flatpak)?.executable)
+        .find(Boolean),
+    );
+  }
+  public isGameStoreInstalled(): Bluebird<boolean> {
+    return this.getGameStorePath().then(Boolean);
+  }
+  public isGameInstalled(name: string): Bluebird<boolean> {
+    return this.findByName(name)
+      .then(() => true)
+      .catch(GameEntryNotFound, () => false);
+  }
+  public launchGame(
+    appInfo: string | { appId: string; parameters?: string[] },
+    api?: IExtensionApi,
+  ): Bluebird<void> {
+    return this.isGameStoreInstalled()
+      .then((installed) => {
+        if (!installed) throw new GameStoreNotFound(this.name);
+        return this.findByAppId(typeof appInfo === "string" ? appInfo : appInfo.appId);
+      })
+      .then((game) => {
+        if (!api) throw new Error("Bottles launch requires the Vortex application API");
+        const command = bottlesLaunchCommand(
+          game.bottle,
+          game.program,
+          typeof appInfo === "string" ? [] : appInfo.parameters,
+        );
+        return api.runExecutable(command.executable, command.args, {
+          ...command.options,
+          cwd: game.gamePath,
+          suggestDeploy: true,
+          detach: true,
+        });
+      });
+  }
+}
