+    // bottles-cli joins the arguments into a /bin/sh command line.
+    const echoed = execFileSync(
+      "/bin/sh",
+      ["-c", `printf '%s\\n' ${args.map(shellQuote).join(" ")}`],
+      {
+        encoding: "utf8",
+      },
+    );
+    expect(echoed.split("\n").slice(0, 3)).toEqual(args);
+  });
+
+  it("refuses to address a bottle whose name is shared", () => {
+    program("bottles-cli");
+    bottle("Default");
+    bottle("Default", { folder: "Default__156" });
+    const games = readBottlesGames();
+    expect(games).toHaveLength(2);
+    expect(() => bottlesLaunchCommand(games[0].bottle, games[0].program)).toThrow(/Rename them/);
+  });
+
+  it("runs tools with the bottle's runner so Vortex can wait for them", async () => {
+    const { location, gameRoot } = bottle("Gaming");
+    new BottlesStore();
+    const wine = runner("soda-9.0-1");
+    const command = await resolveGameTool(
+      path.join(gameRoot, "Tools/Edit.exe"),
+      [path.join(gameRoot, "Data")],
+      { env: { EXTRA: "1" } },
+      { path: gameRoot, store: "bottles" },
+    );
+    expect(command.executable).toBe(wine);
+    expect(command.args[1]).toMatch(/^Z:\\/);
+    expect(command.options.env).toMatchObject({
+      WINEPREFIX: location,
+      EXTRA: "1",
+      DXVK_ASYNC: "1",
+    });
+  });
+
+  it.each([
+    ["sys-wine-9.0", /^wine$/],
+    ["GE-Proton9-20", /Proton runner.*not supported/],
+    ["missing-runner", /not installed/],
+  ])("resolves the %s runner", async (name, expected) => {
+    program("wine");
+    const { gameRoot } = bottle("Gaming", { runner: name });
+    new BottlesStore();
+    const run = resolveGameTool(
+      path.join(gameRoot, "Tool.exe"),
+      [],
+      {},
+      {
+        path: gameRoot,
+        store: "bottles",
+      },
+    );
+    if (expected.source === "^wine$") expect((await run).executable).toBe("wine");
+    else await expect(run).rejects.toThrow(expected);
