+  bottlesLaunchCommand,
+  bottlesPrefix,
+  bottlesRoots,
+  findBottlesLaunch,
+  readBottles,
+  readBottlesGames,
+  shellQuote,
+} from "./linux/bottles";
+import { resolveGameTool } from "./linux/gameTools";
+
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+
+describe.runIf(process.platform === "linux")("Bottles integration", () => {
+  let home: string;
+  let data: string;
+  function yaml(file: string, value: unknown): void {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, dump(value));
+  }
+  function program(name: string): string {
+    const binary = path.join(home, "bin", name);
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.writeFileSync(binary, "#!/bin/sh\n", { mode: 0o755 });
+    return binary;
+  }
+  function runner(name: string, root = data): string {
+    const binary = path.join(root, "runners", name, "bin/wine");
+    fs.mkdirSync(path.dirname(binary), { recursive: true });
+    fs.writeFileSync(binary, "#!/bin/sh\n", { mode: 0o755 });
+    return binary;
+  }
+  /** A bottle whose game lives inside drive_c, as Bottles installs it. */
+  function bottle(
+    name: string,
+    options: { folder?: string; location?: string; root?: string; runner?: string } = {},
+  ) {
+    const root = options.root ?? data;
+    const folder = path.join(root, "bottles", options.folder ?? name);
+    const location = options.location ?? folder;
+    fs.mkdirSync(path.join(location, "drive_c/users"), { recursive: true });
+    const gameRoot = path.join(location, "drive_c/GOG Games/Example");
+    fs.mkdirSync(path.join(gameRoot, "bin"), { recursive: true });
+    fs.writeFileSync(path.join(gameRoot, "bin/Example.exe"), "");
+    fs.writeFileSync(path.join(gameRoot, "goggame-1207658691.info"), "{}");
+    if (options.location) yaml(path.join(folder, "placeholder.yml"), { Path: location });
+    yaml(path.join(location, "bottle.yml"), {
+      Name: name,
+      Path: options.location ?? options.folder ?? name,
+      Custom_Path: options.location !== undefined,
+      Environment: "Gaming",
+      Runner: options.runner ?? "soda-9.0-1",
+      Environment_Variables: { DXVK_ASYNC: 1, SHARED: "yes" },
+      External_Programs: {
+        "1f0e": {
+          id: "1f0e",
+          name: "Example Game",
+          executable: "Example.exe",
+          path: path.join(gameRoot, "bin/Example.exe"),
+        },
+      },
+    });
+    return { location, gameRoot };
+  }
+
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-bottles-"));
+    vi.mocked(os.homedir).mockReturnValue(home);
+    vi.stubEnv("XDG_DATA_HOME", path.join(home, ".local/share"));
+    vi.stubEnv("PATH", path.join(home, "bin"));
+    vi.stubEnv("BOTTLES_CLI_BINARY", "bottles-cli");
+    [{ dataPath: data }] = bottlesRoots();
+    resetCompatibilityPathCache();
+  });
+  afterEach(() => {
+    vi.unstubAllEnvs();
+    resetCompatibilityPathCache();
+    fs.rmSync(home, { recursive: true, force: true });
+  });
+
+  it("lists programs as games rooted at the GOG folder, skipping Steam bottles", () => {
+    const { gameRoot } = bottle("Gaming");
+    yaml(path.join(data, "bottles/SteamProton/bottle.yml"), {
+      Name: "SteamProton",
+      Environment: "Steam",
+    });
+    expect(readBottlesGames()).toEqual([
+      expect.objectContaining({
+        appid: "bottles-Gaming-1f0e",
+        name: "Example Game",
+        gameStoreId: "bottles",
+        gamePath: gameRoot,
+      }),
+    ]);
+    expect(readBottles()[0]).toMatchObject({ env: { DXVK_ASYNC: "1", SHARED: "yes" } });
