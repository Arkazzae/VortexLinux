+    // Like Bottles, ignore a custom directory that does not exist.
+    expect(readBottles().map((entry) => entry.name)).toEqual(["Default"]);
+    fs.mkdirSync(custom);
+    expect(readBottles()).toEqual([]);
+    bottle("Other", { root: path.dirname(custom), folder: "../custom-bottles/Other" });
+    expect(readBottles().map((entry) => entry.name)).toEqual(["Other"]);
+    fs.rmSync(path.join(data, "data.yml"));
+    expect(readBottles()).toEqual([expect.objectContaining({ name: "Default", path: external })]);
+  });
+
+  it("identifies game folders inside a bottle and resolves the bottle as prefix", async () => {
+    const { location, gameRoot } = bottle("Gaming");
