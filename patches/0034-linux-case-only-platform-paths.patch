+    if (matches.length === 0) {
+      // Keep the casing of the prefix that already exists. This matters when
+      // creating a new file below a Windows-authored directory such as
+      // "SFSE/Plugins" through a mod path spelling it "SFSE/plugins".
+      return { path: path.join(current, ...parts.slice(idx)), complete: false };
+    }
+    if (matches.length > 1) {
+      // The host contains multiple case variants and the requested spelling
