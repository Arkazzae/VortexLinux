+/**
+ * Corrects the casing of an absolute path against what exists on disk, without
+ * the Windows user-folder mapping resolveCaseInsensitiveSync applies.
+ */
+export function matchExistingCaseSync(input: string): string {
+  try {
+    return walkExistingCase(input).path;
+  } catch {
+    return input;
+  }
+}
+
+export function resolveCaseInsensitiveSync(input: string): string {
+  if (process.platform !== "linux" || !path.isAbsolute(input)) return input;
+  input = resolveSelectedWindowsUserPathSync(input);
+  if (fs.existsSync(input)) return input;
+
+  try {
+    const walked = walkExistingCase(input);
+    return walked.complete ? walked.path : resolveWindowsUserPathSync(walked.path);
   } catch {
     return resolveWindowsUserPathSync(input);
   }
