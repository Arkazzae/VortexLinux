+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import {
+  resetCompatibilityPathCache,
+  setCompatibilityGameProvider,
+} from "../../../util/compatibilityPaths";
+import { pluginPath } from "./gameSupport";
+
+// Keep the host's own Steam libraries out of the no-game lookup below.
+vi.mock("node:os", async (original) => ({ ...(await original<typeof os>()), homedir: vi.fn() }));
+
+describe.runIf(process.platform === "linux")("plugin folder on Linux", () => {
+  let root: string;
+  afterEach(() => {
+    setCompatibilityGameProvider(undefined);
+    resetCompatibilityPathCache();
+    vi.unstubAllEnvs();
+    fs.rmSync(root, { recursive: true, force: true });
+  });
+
+  it("points plugin management at the selected game's Wine prefix", () => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-plugin-folder-"));
+    vi.mocked(os.homedir).mockReturnValue(root);
+    vi.stubEnv("XDG_DATA_HOME", path.join(root, ".local/share"));
+    vi.stubEnv("VORTEX_COMPAT_PREFIXES", "");
+    const prefix = path.join(root, "pfx");
+    const local = path.join(prefix, "drive_c/users/steamuser/AppData/Local");
+    fs.mkdirSync(local, { recursive: true });
+    // Vortex's main process exports the host folder as LOCALAPPDATA on Linux.
+    vi.stubEnv("LOCALAPPDATA", path.join(root, "Local"));
+    vi.stubEnv("VORTEX_LINUX_LOCAL_APPDATA", path.join(root, "Local"));
+    setCompatibilityGameProvider(() => ({
+      path: path.join(root, "game"),
+      environment: { WINEPREFIX: prefix },
+    }));
+
+    expect(pluginPath("skyrimse")).toBe(path.join(local, "Skyrim Special Edition"));
+
+    // The game's own "Plugins.txt" must not shadow the list Vortex writes.
+    const folder = path.join(local, "Skyrim Special Edition");
+    fs.mkdirSync(folder, { recursive: true });
+    fs.writeFileSync(path.join(folder, "Plugins.txt"), "# stub");
+    expect(pluginPath("skyrimse")).toBe(folder);
+    expect(fs.readdirSync(folder).sort()).toEqual(["plugins.txt"]);
+    expect(fs.readFileSync(path.join(folder, "plugins.txt"), "utf8")).toBe("# stub");
+    fs.writeFileSync(path.join(folder, "LoadOrder.txt"), "old");
+    fs.writeFileSync(path.join(folder, "loadorder.txt"), "vortex");
+    pluginPath("skyrimse");
+    expect(fs.readdirSync(folder).sort()).toEqual([
+      "LoadOrder.txt.vortex_backup",
+      "loadorder.txt",
+      "plugins.txt",
+    ]);
+    expect(fs.readFileSync(path.join(folder, "loadorder.txt"), "utf8")).toBe("vortex");
+
+    // Without a selected game there is nothing to map to.
+    setCompatibilityGameProvider(undefined);
+    expect(pluginPath("skyrimse")).toBe(path.join(root, "Local", "Skyrim Special Edition"));
+  });
+});
