+/**
+ * Plugin management reads, writes and watches this folder with Node's own fs,
+ * which knows nothing about the game's Wine prefix. Hand it the folder the game
+ * actually reads; for native games the mapping leaves the path alone.
+ */
+function prefixedPluginPath(hostPath: string): string {
