+/**
+ * The game creates "Plugins.txt" while Vortex writes "plugins.txt". Windows
+ * doesn't care, but on a case-sensitive disk Wine hands the game whichever name
+ * matches exactly, so a stale capitalised file would shadow Vortex's list. Keep
+ * one file per name, under the name Vortex uses.
+ */
+function unshadowPluginFiles(folder: string): void {
+  let entries: string[];
+  try {
+    entries = nodeFs.readdirSync(folder);
+  } catch {
+    return;
+  }
+  for (const name of ["plugins.txt", "loadorder.txt"]) {
+    const others = entries.filter((entry) => entry !== name && entry.toLowerCase() === name);
+    if (others.length === 0) continue;
+    const target = path.join(folder, name);
+    for (const other of others) {
+      const source = path.join(folder, other);
+      const moveTo = entries.includes(name) ? `${source}.vortex_backup` : target;
+      try {
+        nodeFs.renameSync(source, moveTo);
+        log("info", "renamed differently cased plugin list", { from: source, to: moveTo });
+      } catch (err) {
+        log("warn", "failed to rename differently cased plugin list", {
+          from: source,
+          error: err instanceof Error ? err.message : String(err),
+        });
+      }
+    }
+  }
+}
