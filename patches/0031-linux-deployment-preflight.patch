+++ b/src/renderer/src/extensions/mod_management/LinkingDeployment.staging.test.ts
@@ -0,0 +1,131 @@
+import * as nodeFs from "node:fs";
+import * as path from "node:path";
+
+import { afterEach, expect, vi } from "vitest";
+
+import { test } from "../../test-utils/deploymentTest";
+import type { IGame } from "../../types/IGame";
+import { setCompatibilityGameProvider } from "../../util/compatibilityPaths";
+import * as fs from "../../util/fs";
+import deployMods from "./modActivation";
+import type { IMod } from "./types/IMod";
+import BlacklistSet from "./util/BlacklistSet";
+
+afterEach(() => {
+  setCompatibilityGameProvider(undefined);
+  vi.unstubAllEnvs();
+});
+for (const method of ["hardlink", "symlink"] as const) {
+  test.runIf(process.platform === "linux")(
+    `case-mismatched staging can deploy using ${method}`,
+    async ({ makeDeployment }) => {
+      const h = makeDeployment({ files: { "Engine.ini": "config" }, method, modName: "ConfigMod" });
+      setCompatibilityGameProvider(() => ({ path: h.gameDir, executable: "Game.sh" }));
+      const logicalStaging = path.join(h.stagingDir, "..", "STAGING");
+      const logicalMod = path.join(logicalStaging, "configmod");
+      expect((await fs.statAsync(logicalMod)).isDirectory()).toBe(true);
+      const deployed = await deployMods(
+        h.api,
+        "skyrimse",
+        logicalStaging,
+        h.gameDir,
+        [{ id: "config", installationPath: "configmod", state: "installed" } as IMod],
+        h.method,
+        [],
+        h.normalize,
+        "",
+        new BlacklistSet([], { details: {} } as IGame, h.normalize),
+        () => "",
+      );
+      expect(deployed).toHaveLength(1);
+      expect(nodeFs.readFileSync(h.inGame("Engine.ini"), "utf8")).toBe("config");
+      expect(
+        await h.method.externalChanges("skyrimse", logicalStaging, h.gameDir, deployed),
+      ).toEqual([]);
+    },
+  );
+}
+
+for (const method of ["hardlink", "symlink"] as const) {
+  test.runIf(process.platform === "linux")(
+    `case-mismatched staging can deactivate using ${method}`,
+    async ({ makeDeployment }) => {
+      const h = makeDeployment({ files: { "Engine.ini": "config" }, method, modName: "ConfigMod" });
+      setCompatibilityGameProvider(() => ({ path: h.gameDir, executable: "Game.sh" }));
+      const lastDeployment = await h.deploy();
+      expect(lastDeployment).toHaveLength(1);
+      const logicalStaging = path.join(h.stagingDir, "..", "STAGING");
+      const logicalMod = path.join(logicalStaging, "ConfigMod");
+      expect((await fs.statAsync(logicalMod)).isDirectory()).toBe(true);
+      await h.method.prepare(h.gameDir, false, lastDeployment, h.normalize);
+      try {
+        await h.method.deactivate(logicalMod, "", "ConfigMod");
+        const deployed = await h.method.finalize("skyrimse", h.gameDir, logicalStaging);
+        expect(deployed).toHaveLength(0);
+        expect(nodeFs.existsSync(h.inGame("Engine.ini"))).toBe(false);
+      } catch (err) {
+        await h.method.cancel?.("skyrimse", h.gameDir, logicalStaging);
+        throw err;
+      }
+    },
+  );
+
+  test.runIf(process.platform === "linux")(
+    `case-mismatched staging preserves existing deployment using ${method}`,
+    async ({ makeDeployment }) => {
+      const h = makeDeployment({ files: { "Engine.ini": "config" }, method, modName: "ConfigMod" });
+      setCompatibilityGameProvider(() => ({ path: h.gameDir, executable: "Game.sh" }));
+      const lastDeployment = await h.deploy();
+      expect(lastDeployment).toHaveLength(1);
+      const logicalStaging = path.join(h.stagingDir, "..", "STAGING");
+      const logicalMod = path.join(logicalStaging, "ConfigMod");
+      expect((await fs.statAsync(logicalMod)).isDirectory()).toBe(true);
+      const deployed = await deployMods(
+        h.api,
+        "skyrimse",
+        logicalStaging,
+        h.gameDir,
+        [{ id: "config", installationPath: "ConfigMod", state: "installed" } as IMod],
+        h.method,
+        lastDeployment,
+        h.normalize,
+        "",
+        new BlacklistSet([], { details: {} } as IGame, h.normalize),
+        () => "",
+      );
+      expect(nodeFs.existsSync(h.inGame("Engine.ini"))).toBe(true);
+      expect(deployed).toHaveLength(1);
+      expect(nodeFs.readFileSync(h.inGame("Engine.ini"), "utf8")).toBe("config");
+    },
+  );
+}
+
+for (const operation of ["activate", "deactivate"] as const) {
+  test.runIf(process.platform === "linux")(
+    `rejects ${operation} when the selected prefix is missing instead of treating it as an empty mod`,
+    async ({ makeDeployment }) => {
+      const h = makeDeployment({ files: { "Engine.ini": "config" } });
+      const root = path.dirname(h.stagingDir);
+      const local = path.join(root, "Local");
+      const mod = path.join(local, "ConfigMod");
+      nodeFs.mkdirSync(mod, { recursive: true });
+      nodeFs.writeFileSync(path.join(mod, "Engine.ini"), "host configuration");
+      vi.stubEnv("VORTEX_LINUX_LOCAL_APPDATA", local);
+      setCompatibilityGameProvider(() => ({
+        environment: { WINEPREFIX: path.join(root, "missing-prefix") },
+      }));
+      // Resolution failures must be promise rejections, including for deactivate.
+      const result =
+        operation === "activate"
+          ? h.method.activate(
+              mod,
+              "ConfigMod",
+              "",
+              new BlacklistSet([], { details: {} } as IGame, h.normalize),
+            )
+          : h.method.deactivate(mod, "", "ConfigMod");
+      await expect(result).rejects.toMatchObject({ code: "ENOENT" });
+      expect(nodeFs.readFileSync(path.join(mod, "Engine.ini"), "utf8")).toBe("host configuration");
+    },
+  );
+}
