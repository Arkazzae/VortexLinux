new file mode 100644
--- /dev/null
+++ b/src/renderer/src/extensions/mod_management/util/validateDeploymentTargets.ts
@@ -0,0 +1,64 @@
+import type { IExtensionApi } from "../../../types/IExtensionContext";
+import type { IGame } from "../../../types/IGame";
+import { ProcessCanceled } from "../../../util/CustomErrors";
+import { getModType } from "../../gamemode_management/util/modTypeExtensions";
+import type { IProfile } from "../../profile_management/types/IProfile";
+import type { IMod } from "../types/IMod";
+
+/** Validate only mods being deployed; supported types returning undefined intentionally do not deploy. */
+export function validateDeploymentTargets(
+  api: IExtensionApi,
+  game: IGame,
+  mods: IMod[],
+  modPaths: { [typeId: string]: string },
+): void {
+  const missing = new Map<string, string[]>();
+  for (const mod of mods) {
+    if (mod.state !== "installed") {
+      continue;
+    }
+    const typeId = mod.type || "";
+    if (Object.prototype.hasOwnProperty.call(modPaths, typeId) && modPaths[typeId]) {
+      continue;
+    }
+    const type = getModType(typeId);
+    if (type?.isSupported(game.id) && type.getPath(game) === undefined) {
+      // Collections and externally managed installers (for example UMM).
+      continue;
+    }
+    const names = missing.get(typeId) ?? [];
+    names.push(mod.attributes?.customFileName || mod.attributes?.name || mod.id);
+    missing.set(typeId, names);
+  }
+  if (missing.size > 0) {
+    throw new ProcessCanceled(
+      api.translate(
+        "Deployment cannot continue because these mods have no supported target folder: {{mods}}. " +
+          "Check the game extension and its configuration, or disable these mods before deploying again.",
+        {
+          replace: {
+            mods: Array.from(
+              missing,
+              ([typeId, names]) => `${names.join(", ")} (${typeId || api.translate("Default")})`,
+            ).join("; "),
+          },
+        },
+      ),
+    );
+  }
+}
+
+export function validateProfileDeploymentTargets(
+  api: IExtensionApi,
+  game: IGame,
+  profile: IProfile,
+  mods: Record<string, IMod>,
+  modPaths: { [typeId: string]: string },
+): void {
+  validateDeploymentTargets(
+    api,
+    game,
+    Object.values(mods).filter((mod) => profile.modState?.[mod.id]?.enabled),
+    modPaths,
+  );
+}
