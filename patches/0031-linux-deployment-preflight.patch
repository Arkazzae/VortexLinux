+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { IExtensionApi } from "../../../types/IExtensionContext";
+import type { IGame } from "../../../types/IGame";
+import { ProcessCanceled } from "../../../util/CustomErrors";
+import { getModType } from "../../gamemode_management/util/modTypeExtensions";
+import type { IProfile } from "../../profile_management/types/IProfile";
+import type { IMod } from "../types/IMod";
+import {
+  validateDeploymentTargets,
+  validateProfileDeploymentTargets,
+} from "./validateDeploymentTargets";
+
+vi.mock("../../gamemode_management/util/modTypeExtensions", () => ({ getModType: vi.fn() }));
+
+const game = { id: "starwarsgalacticracer" } as IGame;
+const api = {
+  translate: (message: string, options?: { replace: { mods: string } }) =>
+    message.replace("{{mods}}", options?.replace.mods ?? ""),
+} as IExtensionApi;
+const config: IMod = {
+  id: "performance-tweaks",
+  type: "starwarsgalacticracer-config",
+  state: "installed",
+  installationPath: "performance-tweaks",
+  attributes: { name: "Performance Tweaks" },
+};
+
+afterEach(() => vi.resetAllMocks());
+
+function registerType(supported: boolean, target: string | undefined) {
+  vi.mocked(getModType).mockReturnValue({
+    typeId: config.type,
+    options: { deploymentEssential: false },
+    isSupported: () => supported,
+    getPath: () => target,
+  } as unknown as ReturnType<typeof getModType>);
+}
+
+describe("deployment destination preflight", () => {
+  it("stops an installed config mod whose extension no longer supports its type", () => {
+    registerType(false, "/prefix/config");
+    expect(() => validateDeploymentTargets(api, game, [config], { "": "/game" })).toThrow(
+      /Performance Tweaks.*starwarsgalacticracer-config/,
+    );
+  });
+
+  it("stops mods whose type registration disappeared", () => {
+    expect(() => validateDeploymentTargets(api, game, [config], { "": "/game" })).toThrow(
+      ProcessCanceled,
+    );
+  });
+
+  it("stops an explicitly empty target even when deployment is not essential", () => {
+    registerType(true, "");
+    expect(() => validateDeploymentTargets(api, game, [config], { [config.type]: "" })).toThrow(
+      ProcessCanceled,
+    );
+  });
+
+  it("allows a resolved target, including the default type", () => {
+    expect(() =>
+      validateDeploymentTargets(api, game, [config, { ...config, id: "default", type: "" }], {
+        [config.type]: "/prefix/config",
+        "": "/game",
+      }),
+    ).not.toThrow();
+  });
+
+  it.each(["collection", "umm"])("allows the intentionally non-deploying %s type", (type) => {
+    registerType(true, undefined);
+    expect(() =>
+      validateDeploymentTargets(api, game, [{ ...config, type }], { "": "/game" }),
+    ).not.toThrow();
+  });
+
+  it("does not mistake an unsupported type returning undefined for a non-deploying type", () => {
+    registerType(false, undefined);
+    expect(() => validateDeploymentTargets(api, game, [config], { "": "/game" })).toThrow(
+      ProcessCanceled,
+    );
+  });
+
+  it("ignores mods not installed yet", () => {
+    expect(() =>
+      validateDeploymentTargets(api, game, [{ ...config, state: "installing" }], {}),
+    ).not.toThrow();
+  });
+
+  it("checks only mods enabled in the requested profile", () => {
+    const profile = { gameId: game.id, modState: { [config.id]: { enabled: false } } } as IProfile;
+    expect(() =>
+      validateProfileDeploymentTargets(api, game, profile, { [config.id]: config }, {}),
+    ).not.toThrow();
+    profile.modState[config.id].enabled = true;
+    expect(() =>
+      validateProfileDeploymentTargets(api, game, profile, { [config.id]: config }, {}),
+    ).toThrow(ProcessCanceled);
+  });
+});
