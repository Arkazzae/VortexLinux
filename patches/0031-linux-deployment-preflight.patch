--- /dev/null
+++ b/src/renderer/src/extensions/mod_management/index.deploymentTargets.test.ts
@@ -0,0 +1,276 @@
+import Bluebird from "bluebird";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import type { IExtensionApi } from "../../types/IExtensionContext";
+import type { IGame } from "../../types/IGame";
+import type { IState } from "../../types/IState";
+import { getGame } from "../gamemode_management/util/getGame";
+import { getModType } from "../gamemode_management/util/modTypeExtensions";
+import { setDeploymentNecessary } from "./actions/deployment";
+import { genUpdateModDeployment, onDeploySingleMod } from "./index";
+import type InstallManager from "./InstallManager";
+import type { IDeploymentMethod } from "./types/IDeploymentMethod";
+import { loadActivation, withActivationLock } from "./util/activationStore";
+import { getCurrentActivator } from "./util/deploymentMethods";
+import { dealWithExternalChanges } from "./util/externalChanges";
+
+vi.mock("../gamemode_management/util/getGame", () => ({ getGame: vi.fn() }));
+vi.mock("../gamemode_management/util/modTypeExtensions", () => ({ getModType: vi.fn() }));
+vi.mock("./util/deploymentMethods", () => ({ getCurrentActivator: vi.fn() }));
+vi.mock("./util/activationStore", () => ({
+  withActivationLock: vi.fn((callback: () => Promise<void>) => callback()),
+  loadActivation: vi.fn(async () => []),
+}));
+vi.mock("./util/externalChanges", () => ({ dealWithExternalChanges: vi.fn() }));
+vi.mock("../../util/errorHandling", async (importOriginal) => ({
+  ...(await importOriginal<object>()),
+  withTrackedActivity: (_scope, _name, _attributes, callback) => callback(),
+}));
+
+const gameId = "starwarsgalacticracer";
+const configType = `${gameId}-config`;
+let state: IState;
+let api: IExtensionApi;
+let manager: InstallManager;
+let activator: IDeploymentMethod;
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.mocked(withActivationLock).mockImplementation((callback) => Bluebird.resolve(callback()));
+  state = {
+    settings: {
+      gameMode: { discovered: { [gameId]: { path: "/game" } } },
+      mods: { installPath: { [gameId]: "/staging" } },
+      window: { useModernLayout: false },
+    },
+    persistent: {
+      profiles: { profile: { id: "profile", gameId, modState: { config: { enabled: true } } } },
+      mods: {
+        [gameId]: {
+          config: {
+            id: "config",
+            type: configType,
+            state: "installed",
+            installationPath: "config",
+          },
+        },
+      },
+    },
+    session: { base: { toolsRunning: {} } },
+  } as unknown as IState;
+  api = {
+    getState: () => state,
+    store: { getState: () => state, dispatch: vi.fn() },
+    translate: (message: string, options?: { replace: { mods: string } }) =>
+      message.replace("{{mods}}", options?.replace.mods ?? ""),
+    sendNotification: vi.fn(() => "notification"),
+    dismissNotification: vi.fn(),
+    emitAndAwait: vi.fn(async () => undefined),
+    showErrorNotification: vi.fn(),
+  } as unknown as IExtensionApi;
+  manager = {
+    getActiveInstallationCount: () => 0,
+    waitForIdle: vi.fn(async () => undefined),
+    consumeRecentChanges: vi.fn(() => new Set()),
+  } as unknown as InstallManager;
+  activator = { name: "Hardlink Deployment", prepare: vi.fn() } as unknown as IDeploymentMethod;
+  vi.mocked(getCurrentActivator).mockReturnValue(activator);
+  vi.mocked(getGame).mockReturnValue({
+    id: gameId,
+    getModPaths: () => ({ "": "/game" }),
+  } as unknown as IGame);
+  vi.mocked(getModType).mockReturnValue({
+    typeId: configType,
+    options: {},
+    isSupported: () => false,
+    getPath: () => "/prefix/config",
+  } as unknown as ReturnType<typeof getModType>);
+});
+
+describe("deployment entrypoint destination guards", () => {
+  it("aborts full deployment before consuming pending changes, loading manifests or invoking extension events", async () => {
+    await genUpdateModDeployment(manager)(api, true, "profile");
+    expect(manager.consumeRecentChanges).not.toHaveBeenCalled();
+    expect(loadActivation).not.toHaveBeenCalled();
+    expect(api.emitAndAwait).not.toHaveBeenCalled();
+    expect(dealWithExternalChanges).not.toHaveBeenCalled();
+    expect(api.sendNotification).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: "Deployment interrupted",
+        message: expect.stringContaining(configType),
+      }),
+    );
+    expect(api.showErrorNotification).not.toHaveBeenCalled();
+  });
+
+  it("refreshes mods installed while deployment was waiting before validating", async () => {
+    state.persistent.mods[gameId].config.state = "installing";
+    vi.spyOn(manager, "getActiveInstallationCount").mockReturnValue(1);
+    vi.mocked(manager.waitForIdle).mockImplementation(async () => {
+      state = {
+        ...state,
+        persistent: {
+          ...state.persistent,
+          mods: {
+            [gameId]: {
+              config: {
+                ...state.persistent.mods[gameId].config,
+                state: "installed",
+              },
+            },
+          },
+        },
+      };
+    });
+    await genUpdateModDeployment(manager)(api, true, "profile");
+    expect(manager.waitForIdle).toHaveBeenCalledOnce();
+    expect(loadActivation).not.toHaveBeenCalled();
+    expect(api.sendNotification).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: "Deployment interrupted",
+        message: expect.stringContaining(configType),
+      }),
+    );
+  });
+
+  it("rechecks a mod enabled by a will-deploy handler before external changes", async () => {
+    state.persistent.profiles.profile.modState.config.enabled = false;
+    vi.mocked(api.emitAndAwait).mockImplementation(async () => {
+      state.persistent.profiles.profile.modState.config.enabled = true;
+      return [];
+    });
+    await genUpdateModDeployment(manager)(api, true, "profile");
+    expect(loadActivation).toHaveBeenCalledOnce();
+    expect(api.emitAndAwait).toHaveBeenCalledOnce();
+    expect(dealWithExternalChanges).not.toHaveBeenCalled();
+    expect(api.sendNotification).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: "Deployment interrupted",
+        message: expect.stringContaining(configType),
+      }),
+    );
+  });
+
+  it("rechecks support removed by a will-deploy handler against fresh targets", async () => {
+    let supported = true;
+    vi.mocked(getGame).mockReturnValue({
+      id: gameId,
+      getModPaths: () =>
+        supported ? { "": "/game", [configType]: "/prefix/config" } : { "": "/game" },
+    } as unknown as IGame);
+    vi.mocked(getModType).mockReturnValue({
+      typeId: configType,
+      options: {},
+      isSupported: () => supported,
+      getPath: () => "/prefix/config",
+    } as unknown as ReturnType<typeof getModType>);
+    vi.mocked(api.emitAndAwait).mockImplementation(async () => {
+      supported = false;
+      return [];
+    });
+    await genUpdateModDeployment(manager)(api, true, "profile");
+    expect(loadActivation).toHaveBeenCalledTimes(2);
+    expect(manager.consumeRecentChanges).not.toHaveBeenCalled();
+    expect(dealWithExternalChanges).not.toHaveBeenCalled();
+    expect(api.sendNotification).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: "Deployment interrupted",
+        message: expect.stringContaining(configType),
+      }),
+    );
+  });
+
+  it("does not apply an old manifest when a will-deploy handler changes the target", async () => {
+    let target = "/prefix/config";
+    vi.mocked(getGame).mockReturnValue({
+      id: gameId,
+      getModPaths: () => ({ "": "/game", [configType]: target }),
+    } as unknown as IGame);
+    vi.mocked(api.emitAndAwait).mockImplementation(async () => {
+      target = "/other-prefix/config";
+      return [];
+    });
+    await genUpdateModDeployment(manager)(api, true, "profile");
+    expect(loadActivation).toHaveBeenCalledTimes(2);
+    expect(manager.consumeRecentChanges).not.toHaveBeenCalled();
+    expect(dealWithExternalChanges).not.toHaveBeenCalled();
+    expect(api.sendNotification).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: "Deployment interrupted",
+        message: expect.stringContaining("Please deploy again"),
+      }),
+    );
+  });
+
+  it.each([true, false])(
+    "reports the missing target for single-mod enable=%s without preparing deployment",
+    async (enable) => {
+      await onDeploySingleMod(api)(gameId, "config", enable);
+      expect(loadActivation).not.toHaveBeenCalled();
+      expect(activator.prepare).not.toHaveBeenCalled();
+      expect(api.sendNotification).toHaveBeenCalledWith(
+        expect.objectContaining({
+          title: "Deployment interrupted",
+          message: expect.stringContaining(configType),
+        }),
+      );
+      expect(api.store.dispatch).toHaveBeenCalledWith(setDeploymentNecessary(gameId, true));
+    },
+  );
+
+  it.each([undefined, "/other-prefix/config"])(
+    "rechecks a queued single-mod request when its target becomes %s",
+    async (newTarget) => {
+      let target: string | undefined = "/prefix/config";
+      vi.mocked(getGame).mockReturnValue({
+        id: gameId,
+        getModPaths: () =>
+          target === undefined ? { "": "/game" } : { "": "/game", [configType]: target },
+      } as unknown as IGame);
+      vi.mocked(getModType).mockReturnValue({
+        typeId: configType,
+        options: {},
+        isSupported: () => target !== undefined,
+        getPath: () => target,
+      } as unknown as ReturnType<typeof getModType>);
+      let unlock: () => void;
+      const locked = new Promise<void>((resolve) => {
+        unlock = resolve;
+      });
+      vi.mocked(withActivationLock).mockImplementationOnce((callback) =>
+        Bluebird.resolve(locked).then(callback),
+      );
+      const pending = onDeploySingleMod(api)(gameId, "config", true);
+      expect(withActivationLock).toHaveBeenCalledOnce();
+      expect(loadActivation).not.toHaveBeenCalled();
+      target = newTarget;
+      unlock();
+      await pending;
+      expect(loadActivation).not.toHaveBeenCalled();
+      expect(activator.prepare).not.toHaveBeenCalled();
+      expect(api.sendNotification).toHaveBeenCalledWith(
+        expect.objectContaining({
+          title: "Deployment interrupted",
+          message: expect.stringContaining(
+            newTarget === undefined ? configType : "Please deploy again",
+          ),
+        }),
+      );
+      expect(api.store.dispatch).toHaveBeenCalledWith(setDeploymentNecessary(gameId, true));
+    },
+  );
+
+  it("allows a single-mod request for an intentionally non-deploying collection", async () => {
+    state.persistent.mods[gameId].config.type = "collection";
+    vi.mocked(getModType).mockReturnValue({
+      typeId: "collection",
+      options: {},
+      isSupported: () => true,
+      getPath: () => undefined,
+    } as unknown as ReturnType<typeof getModType>);
+    await onDeploySingleMod(api)(gameId, "config", true);
+    expect(loadActivation).not.toHaveBeenCalled();
+    expect(activator.prepare).not.toHaveBeenCalled();
+    expect(api.sendNotification).not.toHaveBeenCalled();
+  });
+});
