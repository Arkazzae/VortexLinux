+import * as path from "node:path";
+
+import { describe, expect, it, vi } from "vitest";
+
+import { installReplacer } from "./installers";
+
+// util pulls in the Vortex API, which only exists inside Vortex
+vi.mock("./util", () => ({ logDebug: () => undefined }));
+
+const join = (...segments: string[]) => segments.join(path.sep);
+
+describe("installReplacer", () => {
+  it("strips a wrapper folder above Generated whatever the case of its name", async () => {
+    // Upscaled Tattoos and Makeup (Nexus 1703) ships its textures this way
+    const tattoo = join("UpscaledTattoos_Makeup", "Generated", "Public", "Shared", "Tattoo.DDS");
+    const makeup = join("UpscaledTattoos_Makeup", "Generated", "Public", "Shared", "Makeup.dds");
+    // archives list every folder level as its own entry
+    const files = [
+      join("UpscaledTattoos_Makeup") + path.sep,
+      join("UpscaledTattoos_Makeup", "Generated") + path.sep,
+      join("UpscaledTattoos_Makeup", "Generated", "Public") + path.sep,
+      join("UpscaledTattoos_Makeup", "Generated", "Public", "Shared") + path.sep,
+      tattoo,
+      makeup,
+    ];
+
+    const result = await installReplacer(files);
+
+    expect(result.instructions).toEqual([
+      {
+        type: "copy",
+        source: tattoo,
+        destination: join("Generated", "Public", "Shared", "Tattoo.DDS"),
+      },
+      {
+        type: "copy",
+        source: makeup,
+        destination: join("Generated", "Public", "Shared", "Makeup.dds"),
+      },
+    ]);
+  });
+
+  it("strips the folders above a Data folder whatever their case", async () => {
+    const file = join("SomeMod", "Data", "English.loca");
+
+    const result = await installReplacer([file]);
+
+    expect(result.instructions).toEqual([
+      { type: "copy", source: file, destination: "English.loca" },
+    ]);
+  });
+
+  it("keeps the layout of an archive that already starts at Generated", async () => {
+    const file = join("Generated", "Public", "Shared", "Tattoo.DDS");
+    const files = [
+      join("Generated") + path.sep,
+      join("Generated", "Public") + path.sep,
+      join("Generated", "Public", "Shared") + path.sep,
+      file,
+    ];
+
+    const result = await installReplacer(files);
+
+    expect(result.instructions).toEqual([{ type: "copy", source: file, destination: file }]);
+  });
+});
